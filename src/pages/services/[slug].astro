---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Check from '@lucide/astro/icons/check';
import { allServices, serviceCategories, type Service } from '../../data/services';

export const getStaticPaths = (() =>
	allServices.map((service) => ({
		params: { slug: service.slug },
		props: { service },
	}))) satisfies GetStaticPaths;

interface Props {
	service: Service;
}

const { service } = Astro.props;

const category = serviceCategories.find((cat) => cat.services.some((s) => s.slug === service.slug));
const otherServices = allServices.filter((s) => s.slug !== service.slug);
---

<BaseLayout title={service.title} description={service.summary}>
	<section class="bg-brand-bg py-20 sm:py-28">
		<div class="mx-auto max-w-7xl px-6 lg:px-8">
			<a href="/services" class="text-sm font-medium text-brand-muted transition-colors hover:text-brand-foreground">
				← All services
			</a>

			<div class="mt-8 max-w-3xl">
				<div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-accent/10 text-brand-accent">
					<service.icon class="h-7 w-7" aria-hidden="true" stroke-width={1.75} />
				</div>

				{category && (
					<p class="mt-6 text-sm font-semibold uppercase tracking-[0.2em] text-brand-accent">{category.label}</p>
				)}

				<h1 class="mt-3 text-4xl font-semibold tracking-tight text-brand-foreground sm:text-5xl">
					{service.title}
				</h1>

				<p class="mt-5 text-lg leading-relaxed text-brand-muted">
					{service.summary}
				</p>

				<div class="mt-8 flex flex-wrap gap-3">
					<a
						href="/contact"
						class="inline-flex items-center gap-1.5 rounded-full bg-brand-accent px-6 py-3 text-sm font-semibold text-brand-accent-foreground transition-opacity hover:opacity-90"
					>
						Request a quote
						<span aria-hidden="true">↗</span>
					</a>
					<a
						href="/portfolio"
						class="inline-flex items-center gap-1.5 rounded-full border border-brand-border px-6 py-3 text-sm font-semibold text-brand-foreground transition-colors hover:bg-brand-surface"
					>
						See our work
					</a>
				</div>
			</div>

			<div class="mt-16 border-t border-brand-border/70 pt-12">
				<h2 class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-muted">What's included</h2>
				<ul class="mt-6 grid gap-4 sm:grid-cols-2">
					{service.points.map((point) => (
						<li class="flex items-start gap-3 rounded-xl border border-brand-border/70 p-4">
							<Check class="mt-0.5 h-5 w-5 shrink-0 text-brand-accent" aria-hidden="true" stroke-width={2} />
							<span class="text-sm leading-relaxed text-brand-foreground">{point}</span>
						</li>
					))}
				</ul>
			</div>
		</div>
	</section>

	<section class="bg-brand-surface py-16 sm:py-20">
		<div class="mx-auto max-w-7xl px-6 lg:px-8">
			<h2 class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-muted">Other services</h2>
			<div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{otherServices.map((other) => (
					<a
						href={`/services/${other.slug}`}
						class="group flex flex-col gap-3 rounded-2xl border border-brand-border/70 bg-brand-bg p-6 transition-colors hover:border-brand-foreground"
					>
						<other.icon class="h-5 w-5 text-brand-accent" aria-hidden="true" stroke-width={1.75} />
						<span class="text-base font-semibold text-brand-foreground">{other.title}</span>
						<span class="text-sm leading-relaxed text-brand-muted">{other.blurb}</span>
						<span class="mt-auto inline-flex items-center gap-1 text-sm font-medium text-brand-foreground opacity-0 transition-opacity group-hover:opacity-100">
							Learn more <span aria-hidden="true">→</span>
						</span>
					</a>
				))}
			</div>
		</div>
	</section>
</BaseLayout>
