<script>
const SCENE_DURATION = 4800;
document.querySelectorAll<HTMLElement>('[data-reel]').forEach((root) => {
  if (root.dataset.init === 'true') return;
  root.dataset.init = 'true';

  const scenes = Array.from(root.querySelectorAll<HTMLElement>('[data-scene]'));
  const codeNode = root.querySelector<HTMLElement>('[data-live-code]');
  const codeViewport = root.querySelector<HTMLElement>('.editor-code');
  const preview = root.querySelector<HTMLElement>('.scene-dev .preview-body');
  const chart = root.querySelector<SVGPathElement>('.scene-growth .growth-line');
  const chartArea = root.querySelector<SVGPathElement>('.scene-growth .growth-area');
  const chartDot = root.querySelector<SVGCircleElement>('.scene-growth .chart-wrap svg circle');
  const metrics = Array.from(root.querySelectorAll<HTMLElement>('[data-count-to]'));
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // A deliberately compact Astro example: each line fits the editor's visible area.
  // This is a visual code demo, not code executed by the page.
  const scriptLines = [
    '---',
    "import Layout from '../layouts/Base.astro';",
    "import Hero from '../ui/Hero.astro';",
    '',
    '<Layout',
    '  title="Attribute"',
    '>',
    '  <Hero',
    '    title="Build beyond."',
    '    subtitle="Designed to perform."',
    '    ctaHref="/work"',
    '  />',
    '</Layout>',
    '',
    '// Ready to launch ✓'
  ];
  const source = scriptLines.join('\n');
  // Weighted character timeline: more aggressive pacing so multiple lines appear early.
  const charWeights = Array.from(source, (ch) =>
    ch === '\n' ? 3.2 : ch === '>' || ch === ';' || ch === '/' ? 1.8 : ch === ' ' ? .38 : .82
  );
  const totalWeight = charWeights.reduce((sum, w) => sum + w, 0);
  const cumulativeWeights:number[] = [];
  let runningWeight = 0;
  charWeights.forEach((w) => { runningWeight += w; cumulativeWeights.push(runningWeight); });
  const lineLen=chart?.getTotalLength()||1600;
  if(chart){chart.style.strokeDasharray=String(lineLen);chart.style.strokeDashoffset=String(lineLen)}

  let index=0, elapsed=0, last=0, frame=0, previousCount=-1;
  const clamp=(x:number)=>Math.min(1,Math.max(0,x));
  function renderCode(t:number){
    if(!codeNode)return;
    // Start quickly and finish comfortably within the frame so several lines are visible.
    const p=clamp((t-70)/3200);
    const eased=1-Math.pow(1-p,1.15);
    const targetWeight=eased*totalWeight;
    let low=0, high=cumulativeWeights.length;
    while(low<high){
      const mid=(low+high)>>>1;
      if(cumulativeWeights[mid]<=targetWeight)low=mid+1;
      else high=mid;
    }
    const count=low;
    if(count===previousCount)return;
    previousCount=count;
    // Use actual newline text nodes, not dynamically inserted spans.
    // Astro's scoped CSS doesn't style client-created spans, which previously
    // caused all typed lines to render inline as one continuous line.
    const visible=source.slice(0,count);
    codeNode.style.whiteSpace='pre';
    codeNode.style.display='block';
    codeNode.style.fontFamily='ui-monospace, SFMono-Regular, Menlo, Consolas, monospace';
    codeNode.style.lineHeight='1.65';
    codeNode.style.color='#d9e4f5';
    const caret=document.createElement('span');
    caret.setAttribute('aria-hidden','true');
    caret.style.cssText='display:inline-block;vertical-align:-0.18em;width:2px;height:1.05em;background:#b6e7ff;box-shadow:0 0 7px #a3dcff88;animation:v11-blink .65s step-end infinite;margin-left:1px';
    codeNode.replaceChildren(document.createTextNode(visible),caret);
    if(codeViewport){
      const maxScroll=Math.max(0, codeViewport.scrollHeight-codeViewport.clientHeight);
      codeViewport.scrollTop=maxScroll;
    }
    if(preview)preview.classList.toggle('compiled',p>.48);
  }
  function renderChart(t:number){
    if(!chart)return;
    const p=clamp((t-450)/3350);
    const eased=1-Math.pow(1-p,2);
    chart.style.strokeDashoffset=String(lineLen*(1-eased));
    if(chartArea)chartArea.style.opacity=String(.18+.82*eased);
    if(chartDot)chartDot.classList.toggle('drawn',p>.98);
  }
  function renderMetrics(t:number){
    const p=clamp((t-250)/2500);
    const eased=1-Math.pow(1-p,3);
    metrics.forEach(el=>{
      const v=Number(el.dataset.countTo)*eased;
      el.textContent=el.dataset.countFormat==='compact'?(v/1000).toFixed(1)+'k':el.dataset.countFormat==='percent'?v.toFixed(1)+'%':Math.round(v).toLocaleString('en-CA');
    });
  }
  function show(i:number){
    index=i; previousCount=-1;
    scenes.forEach((scene,n)=>{
      scene.classList.toggle('active',n===i);
      scene.setAttribute('aria-hidden',String(n!==i));
    });
    if(i===1){if(codeViewport)codeViewport.scrollTop=0;renderCode(0)}
    if(i===3){if(chart)chart.style.strokeDashoffset=String(lineLen);if(chartDot)chartDot.classList.remove('drawn');renderMetrics(0)}
  }
  function tick(now:number){
    if(!last)last=now;
    const dt=Math.min(80,now-last);last=now;
    if(!document.hidden&&!reduceMotion){
      elapsed+=dt;
      if(elapsed>=SCENE_DURATION){elapsed%=SCENE_DURATION;show((index+1)%scenes.length)}
      if(index===1)renderCode(elapsed);
      if(index===3){renderMetrics(elapsed);renderChart(elapsed)}
    }
    frame=requestAnimationFrame(tick);
  }
  // Do not freeze on hover: many visitors leave the pointer over the hero,
  // and that otherwise makes the code typing look broken.
  show(0);
  if(reduceMotion){
    // Static accessible frame instead of looping animations.
    renderCode(SCENE_DURATION);
    if(chart){chart.style.strokeDashoffset='0'}
  }
  frame=requestAnimationFrame(tick);
  document.addEventListener('astro:before-swap',()=>cancelAnimationFrame(frame),{once:true});
});
</script>
