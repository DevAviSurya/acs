---
interface Props { showIntro?: boolean }
const { showIntro = true } = Astro.props;
---
<section class="attribute-hero" aria-label="Attribute Corporate Solutions creative process">
  {showIntro && <div class="hero-copy"><h1>From first sketch.<br/><span>To lasting impact.</span></h1><p>We design, build and elevate brands—across digital experiences, intelligent workflows and the real world.</p><div class="hero-actions"><a class="primary" href="/contact">Start a project <span>↗</span></a><a class="secondary" href="/services">Explore our services <span>→</span></a></div></div>}
  <div class="reel" data-reel>
    <div class="stage">
      <article class="scene scene-design active" data-scene="0" aria-label="Architectural web design"><h2 class="frame-heading">Precision before pixels</h2>
        
        <div class="architectural">
          <div class="architectural-measure top-measure">← &nbsp; 12-COLUMN RESPONSIVE GRID &nbsp; →</div>
          <div class="architectural-measure left-measure">8PX SPACING SYSTEM</div>
          <div class="blueprint-grid"><div class="grid-registration reg-a">+</div><div class="grid-registration reg-b">+</div><div class="grid-registration reg-c">+</div><div class="grid-registration reg-d">+</div><div class="grid-index">GRID / 12 COLUMNS / 8PX</div></div>
          <div class="blueprint-guides"><i></i><i></i><i></i><i></i><span class="guide-corner corner-tl">+</span><span class="guide-corner corner-br">+</span></div>
          <div class="blueprint-shadow"></div>
          <div class="browser-shell blueprint-shell">
            <div class="browser-bar"><div class="traffic"><i></i><i></i><i></i></div><span>attribute.studio — 12-COL GRID</span><span class="browser-symbol">↗</span></div>
            <div class="blueprint-overlay" aria-hidden="true"></div>
            <div class="premium-site-nav"><strong>ATTRIBUTE<span>®</span></strong><div><span>Work</span><span>Services</span><span>Studio</span><b>Get Started ↗</b></div></div>
            <div class="premium-site-hero"><div class="premium-site-copy"><span class="premium-overline">CREATIVE TECHNOLOGY STUDIO</span><h3>Digital craft,<br/><em>built to endure.</em></h3><p>Bespoke web experiences, intelligent systems<br/>and brand experiences.</p><b class="premium-cta">Start a Project ↗</b></div><div class="premium-site-art"><div class="art-inner"><span class="art-circle">A</span><small>DESIGN × ENGINEERING</small></div></div></div>
            <div class="premium-site-cards"><div><small>01 / EXPERIENCE</small><strong>UI / UX Systems</strong><span>Precision-led design</span></div><div><small>02 / ENGINEERING</small><strong>Modern Stack</strong><span>Built for performance</span></div><div><small>03 / IDENTITY</small><strong>Brand & Print</strong><span>Every touchpoint</span></div></div>
          </div>
          <div class="blueprint-annotation annotation-one">FIG 01 / STRUCTURE</div><div class="blueprint-annotation annotation-two">DESIGN → DEVELOPMENT</div>
        </div>
        
      </article>
      <article class="scene scene-dev" data-scene="1" aria-label="Development and live preview"><h2 class="frame-heading">Engineered to perform</h2>
        <div class="dev-composition"><div class="editor-window"><div class="editor-top"><div class="traffic"><i></i><i></i><i></i></div><span>Hero.astro</span><span>⌘ K</span></div><div class="editor-body"><div class="editor-rail">01<br/>02<br/>03<br/>04<br/>05<br/>06<br/>07<br/>08<br/>09<br/>10<br/>11<br/>12</div><div class="editor-code"><pre class="live-code" data-live-code aria-label="Code being typed live"></pre></div></div><div class="editor-bottom">● &nbsp; main &nbsp;&nbsp; ✓ 0 errors <span>ASTRO · TYPESCRIPT</span></div></div><div class="preview-window"><div class="preview-top"><span>● &nbsp; Live preview</span><span>↗</span></div><div class="preview-body"><div class="preview-nav">A<span>STUDIO</span><small>WORK &nbsp; ABOUT</small></div><div class="preview-overline">INDEPENDENT DIGITAL STUDIO</div><div class="preview-title">Build<br/>beyond<span>.</span></div><div class="preview-sub">Considered design.<br/>Powerful technology.</div><div class="preview-pill">Discover more &nbsp; ↗</div><div class="preview-graphic"></div></div></div></div>
      </article>
      <article class="scene scene-ai" data-scene="2" aria-label="Intelligent automation workflows"><h2 class="frame-heading">Smart By design</h2><div class="ai-composition"><div class="ai-plate ai-plate-back" aria-hidden="true"><span></span><span></span><span></span></div><div class="ai-plate ai-plate-front" aria-hidden="true"><span></span><span></span><span></span></div><div class="ai-caption">AUTOMATION ENGINE <span class="live-dot"></span> SYSTEM ONLINE</div><svg class="ai-orbits" viewBox="0 0 900 420" aria-hidden="true"><g class="orbit-ring ring-outer"><circle cx="450" cy="210" r="142"/><path d="M450 68 A142 142 0 0 1 592 210" class="orbit-emphasis"/><circle cx="450" cy="68" r="5" class="orbit-bead"/></g><g class="orbit-ring ring-middle"><circle cx="450" cy="210" r="106"/><path d="M344 210 A106 106 0 0 1 450 104" class="orbit-emphasis"/><circle cx="344" cy="210" r="4" class="orbit-bead"/></g><g class="orbit-ring ring-inner"><circle cx="450" cy="210" r="73"/><path d="M450 137 A73 73 0 0 1 523 210" class="orbit-emphasis"/></g></svg><svg class="workflow-svg" viewBox="0 0 900 420" role="img" aria-label="Connected workflow showing data moving through intelligent automation"><defs><linearGradient id="linkfade"><stop stop-color="#d0d0d0"/><stop offset=".5" stop-color="#555"/><stop offset="1" stop-color="#d0d0d0"/></linearGradient></defs><g class="ai-ticks" opacity=".75"><rect x="74" y="240" width="34" height="3" rx="1.5" fill="#e5e7eb"/><rect x="112" y="240" width="22" height="3" rx="1.5" fill="#cbd5e1"/><rect x="140" y="240" width="40" height="3" rx="1.5" fill="#e5e7eb"/><rect x="698" y="240" width="27" height="3" rx="1.5" fill="#b6ddcc"/><rect x="729" y="240" width="38" height="3" rx="1.5" fill="#dcece4"/><rect x="772" y="240" width="21" height="3" rx="1.5" fill="#a5d9c4"/></g><path d="M220 210 H340 M560 210 H680 M450 115 V155 M450 265 V305" fill="none" stroke="url(#linkfade)" stroke-width="2" stroke-dasharray="7 8"/><circle class="pulse pulse1" r="5" fill="#171717"><animateMotion dur="2s" repeatCount="indefinite" path="M220 210 H340"/></circle><circle class="pulse pulse2" r="5" fill="#171717"><animateMotion dur="2.5s" repeatCount="indefinite" path="M560 210 H680"/></circle><rect x="55" y="162" width="165" height="96" rx="14" fill="white" stroke="#ddd"/><text x="78" y="197" fill="#888" font-size="12" font-family="sans-serif">01 / INPUT</text><text x="78" y="227" fill="#171717" font-size="19" font-weight="650" font-family="sans-serif">Customer data</text><rect x="340" y="155" width="220" height="110" rx="18" fill="#191919"/><text x="450" y="198" text-anchor="middle" fill="#aaa" font-size="12" font-family="sans-serif">ATTRIBUTE / AI</text><text x="450" y="229" text-anchor="middle" fill="white" font-size="24" font-weight="650" font-family="sans-serif">Intelligence</text><rect x="680" y="162" width="165" height="96" rx="14" fill="white" stroke="#ddd"/><text x="702" y="197" fill="#888" font-size="12" font-family="sans-serif">03 / OUTPUT</text><text x="702" y="227" fill="#171717" font-size="19" font-weight="650" font-family="sans-serif">Action taken</text><rect x="360" y="35" width="180" height="80" rx="13" fill="white" stroke="#ddd"/><text x="384" y="66" fill="#888" font-size="12" font-family="sans-serif">KNOWLEDGE</text><text x="384" y="91" fill="#171717" font-size="17" font-weight="650" font-family="sans-serif">Context engine</text><rect x="360" y="305" width="180" height="80" rx="13" fill="white" stroke="#ddd"/><text x="384" y="336" fill="#888" font-size="12" font-family="sans-serif">OPERATIONS</text><text x="384" y="361" fill="#171717" font-size="17" font-weight="650" font-family="sans-serif">Workflow sync</text></svg><div class="ai-bottom">INPUT <span>→</span> UNDERSTAND <span>→</span> AUTOMATE <span>→</span> IMPROVE</div></div></article>
      <article class="scene scene-growth" data-scene="3" aria-label="Digital growth analytics"><h2 class="frame-heading">Progress you can see</h2><div class="growth-dashboard"><div class="growth-head"><div><span class="dashboard-kicker">PERFORMANCE OVERVIEW <span class="demo-data">/ DEMO DATA</span></span></div><span class="dashboard-period">LAST 90 DAYS &nbsp;⌄</span></div><div class="metric-row"><div><small>REACH</small><strong data-count-to="128400" data-count-format="compact">0</strong><span>↗ 18.6%</span></div><div><small>ENGAGEMENT</small><strong data-count-to="64.8" data-count-format="percent">0%</strong><span>↗ 12.4%</span></div><div><small>CONVERSIONS</small><strong data-count-to="3842" data-count-format="integer">0</strong><span>↗ 24.1%</span></div></div><div class="chart-wrap"><div class="chart-header"><span>Audience growth</span><span>● &nbsp; Organic traffic</span></div><svg viewBox="0 0 1000 270" preserveAspectRatio="none" aria-label="Illustrative rising audience growth line chart"><defs><linearGradient id="attribute-growth-fill" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#3b82f6" stop-opacity=".19"/><stop offset="1" stop-color="#3b82f6" stop-opacity="0"/></linearGradient></defs><path d="M0 40H1000 M0 105H1000 M0 170H1000 M0 235H1000" stroke="#ececec" stroke-width="1"/><path class="growth-area" d="M0 240 C70 220 105 225 155 204 S245 225 310 180 S395 196 450 147 S555 170 610 105 S705 130 770 70 S885 93 1000 18 L1000 270 L0 270 Z" fill="url(#attribute-growth-fill)"/><path d="M0 240 C70 220 105 225 155 204 S245 225 310 180 S395 196 450 147 S555 170 610 105 S705 130 770 70 S885 93 1000 18" fill="none" stroke="#2563eb" stroke-width="4" stroke-linecap="round" class="growth-line"/><circle cx="1000" cy="18" r="7" fill="#2563eb"/></svg></div><div class="social-presence" aria-label="Social media channels"><span class="social-caption">SOCIAL REACH</span><div class="social-icons"><span class="social-icon facebook" title="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="white" d="M14.3 21v-8h2.7l.4-3.1h-3.1v-2c0-.9.3-1.5 1.6-1.5h1.7V3.6c-.3 0-1.3-.1-2.5-.1-2.6 0-4.4 1.6-4.4 4.6v1.8H8V13h2.7v8z"/></svg></span><span class="social-icon instagram" title="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="5" fill="none" stroke="white" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="white" stroke-width="2"/><circle cx="17.2" cy="6.9" r="1.2" fill="white"/></svg></span><span class="social-icon linkedin" title="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="white" d="M5 9h3v10H5zM6.5 4.8a1.7 1.7 0 1 0 0 3.4 1.7 1.7 0 0 0 0-3.4M10 9h2.9v1.4c.5-.9 1.4-1.7 3.2-1.7 3.4 0 3.9 2.2 3.9 5.1V19h-3v-4.7c0-1.4 0-3-1.9-3s-2.2 1.5-2.2 2.9V19H10z"/></svg></span><span class="social-icon google" title="Google"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M21 12.2c0-.7-.1-1.3-.2-1.9H12v3.6h5c-.2 1.2-.9 2.2-1.9 2.8l3 2.3c1.8-1.6 2.9-4 2.9-6.8"/><path fill="#34A853" d="M12 21c2.6 0 4.8-.9 6.4-2.4l-3-2.3c-.8.6-1.9.9-3.4.9-2.6 0-4.8-1.8-5.6-4.1l-3.1 2.4C4.9 18.8 8.2 21 12 21"/><path fill="#FBBC05" d="M6.4 13.1a5.6 5.6 0 0 1 0-3.2L3.3 7.5a9 9 0 0 0 0 8z"/><path fill="#EA4335" d="M12 6.8c1.4 0 2.7.5 3.7 1.5l2.8-2.8A9 9 0 0 0 3.3 7.5l3.1 2.4C7.2 7.6 9.4 6.8 12 6.8"/></svg></span></div></div><div class="chart-axis"><span>JUL</span><span>AUG</span><span>SEP</span><span>OCT</span><span>NOV</span></div></div></article>
      <article class="scene scene-brand" data-scene="4" aria-label="Physical brand experience"><h2 class="frame-heading">Build to be remembered</h2><div class="brand-composition"><div class="brand-backword">MADE<br/>TANGIBLE.</div><div class="merch-display"><div class="merch-shirt"><svg viewBox="-22 0 344 330" aria-label="Premium black cotton branded t-shirt" role="img"><defs>
<linearGradient id="cottonBody" x1="0" y1="0" x2="1" y2=".12"><stop stop-color="#08090a"/><stop offset=".19" stop-color="#35373a"/><stop offset=".44" stop-color="#151618"/><stop offset=".73" stop-color="#292a2d"/><stop offset="1" stop-color="#090a0c"/></linearGradient>
<linearGradient id="cottonSleeve" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#45474b"/><stop offset=".4" stop-color="#191a1d"/><stop offset="1" stop-color="#070809"/></linearGradient>
<linearGradient id="crease" x1="0" y1="0" x2="1" y2="0"><stop stop-color="#fff" stop-opacity="0"/><stop offset=".5" stop-color="#fff" stop-opacity=".11"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></linearGradient>
<filter id="fabricNoise"><feTurbulence type="fractalNoise" baseFrequency=".55" numOctaves="3" seed="7" stitchTiles="stitch" result="n"/><feColorMatrix in="n" type="saturate" values="0" result="g"/><feComponentTransfer in="g"><feFuncA type="linear" slope=".065"/></feComponentTransfer></filter>
</defs>
<path d="M90 29 L116 13 Q150 32 184 13 L210 29 L281 78 L245 133 L214 112 L219 312 Q150 321 81 312 L86 112 L55 133 L19 78 Z" fill="url(#cottonBody)" stroke="#0b0b0d" stroke-width="2"/>
<path d="M90 29 L53 49 L19 78 L55 133 L86 112 L101 47 Z M210 29 L247 49 L281 78 L245 133 L214 112 L199 47 Z" fill="url(#cottonSleeve)" opacity=".92"/>
<path d="M116 13 Q150 48 184 13" fill="none" stroke="#070708" stroke-width="15" stroke-linecap="round"/><path d="M116 14 Q150 42 184 14" fill="none" stroke="#55575a" stroke-width="2" opacity=".75"/>®´`
<path d="M91 30 Q111 44 114 71 M209 30 Q189 44 186 71 M86 112 Q80 195 81 311 M214 112 Q220 204 219 311 M22 81 Q42 97 54 131 M278 81 Q258 97 246 131" fill="none" stroke="#9b9da0" stroke-opacity=".24" stroke-width="1.6"/>
<path d="M111 66 Q104 141 116 269 M181 64 Q199 167 181 283 M140 92 Q124 188 134 304 M161 106 Q169 191 161 300" fill="none" stroke="url(#crease)" stroke-width="15" opacity=".9"/>
<path d="M83 307 Q150 317 217 307" fill="none" stroke="#54565a" stroke-width="2" opacity=".6"/>
<path d="M91 29 L116 13 Q150 32 184 13 L210 29 L281 78 L245 133 L214 112 L219 312 Q150 321 81 312 L86 112 L55 133 L19 78 Z" fill="#fff" filter="url(#fabricNoise)" opacity=".5"/>
<rect x="142" y="37" width="16" height="8" rx="1" fill="#101113" stroke="#555" stroke-width=".7"/>
<g text-anchor="middle" fill="#e3e3e3" font-family="Arial,sans-serif"><text x="150" y="175" font-size="67" font-weight="750" letter-spacing="-5" opacity=".84">A</text></g>
</svg></div><div class="merch-bottle"><div class="bottle-cap"></div><div class="bottle-body"><span>ATTRIBUTE</span><small>EST. 2026</small></div></div><div class="merch-mug"><div class="steam steam-one"></div><div class="steam steam-two"></div><div class="steam steam-three"></div><div class="coffee-surface"></div><div class="mug-handle"></div><div class="mug-body"><span>A<span class="mug-dot">.</span></span></div></div><div class="merch-card"><div class="card-logo">ATTRIBUTE<span>.</span></div><div class="card-rule"></div><small>BRAND CARD</small></div></div></div></article>
    </div>
  </div>
</section>
<style>
.attribute-hero{--ink:#171717;--muted:#777;background:#fafaf9;color:var(--ink);font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;padding:clamp(28px,5vw,72px) 20px 45px;overflow:hidden}.hero-copy{text-align:center;max-width:920px;margin:0 auto}.eyebrow{font-size:11px;letter-spacing:.2em;font-weight:650;color:#777;display:flex;align-items:center;justify-content:center;gap:10px}.eyebrow-dot{width:6px;height:6px;border-radius:50%;background:#111}.hero-copy h1{font-size:clamp(42px,6.5vw,90px);line-height:1.02;letter-spacing:-.075em;margin:24px 0 20px;font-weight:680}.hero-copy h1 span{color:#8b8b8b}.hero-copy p{max-width:610px;margin:auto;color:#666;font-size:clamp(15px,1.6vw,19px);line-height:1.6}.hero-actions{display:flex;justify-content:center;align-items:center;gap:24px;margin-top:29px}.hero-actions a{text-decoration:none;font-size:13px;font-weight:650}.hero-actions .primary{background:#171717;color:white;border-radius:50px;padding:15px 23px}.hero-actions .primary span{margin-left:15px}.hero-actions .secondary{color:#171717}.hero-actions .secondary span{margin-left:8px}.reel{width:min(1120px,100%);margin:auto;background:#f6f6f4;border:1px solid #e5e5e3;border-radius:18px;overflow:hidden;box-shadow:0 24px 75px rgba(0,0,0,.045);position:relative}.reel-head{height:56px;display:flex;align-items:center;justify-content:space-between;padding:0 32px;border-bottom:1px solid #e9e9e6}.reel-brand{font-size:13px;font-weight:800;letter-spacing:.07em}.brand-period{color:#999}.reel-counter{font:500 11px ui-monospace,monospace;color:#888}.stage{height:clamp(360px,52vw,590px);position:relative;overflow:hidden;isolation:isolate}.scene{position:absolute;inset:0;opacity:0;visibility:hidden;transform:scale(.965) translateY(12px);transition:opacity .8s cubic-bezier(.22,1,.36,1),transform 1.25s cubic-bezier(.22,1,.36,1),visibility 0s linear .8s;pointer-events:none;overflow:hidden}.scene.active{opacity:1;visibility:visible;transform:scale(1) translateY(0);transition:op