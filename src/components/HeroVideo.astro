---
export interface Props {
  headline?: string;
  subheadline?: string;
  ctaText?: string;
  ctaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
  mp4Src?: string;
  webmSrc?: string;
  posterSrc?: string;
  services?: string[];
}

const {
  headline = "Digital Craft. Scalable Growth. Tangible Merch.",
  subheadline = "End-to-end web design, development, AI integration, SEO & digital marketing, and custom branded merchandise.",
  ctaText = "Start a Project",
  ctaHref = "#contact",
  secondaryCtaText = "Explore Work",
  secondaryCtaHref = "#work",
  mp4Src = "/videos/hero-showreel-light.mp4",
  webmSrc = "/videos/hero-showreel-light.webm",
  posterSrc,
  services = [
    "Web Design",
    "Development",
    "AI Integration",
    "SEO & Marketing",
    "Branded Merch",
  ],
} = Astro.props;
---

<section
  class="w-full bg-neutral-50 px-6 pt-20 pb-20 text-neutral-950 sm:pt-24 lg:px-10"
  aria-label="Hero showcase"
>
  <div class="mx-auto max-w-6xl">
    <!-- Top Copy Block (100% Unobstructed & Instant Readability) -->
    <div class="mx-auto max-w-3xl text-center">
      <!-- <ul class="mb-6 flex flex-wrap items-center justify-center gap-2">
        {
          services.map((service) => (
            <li class="rounded-full border border-neutral-200 bg-white px-3.5 py-1 text-xs font-medium text-neutral-700 shadow-xs sm:text-sm">
              {service}
            </li>
          ))
        }
      </ul> -->

      <h1 class="text-4xl font-bold tracking-tight text-balance text-neutral-950 sm:text-5xl md:text-6xl">
        {headline}
      </h1>

      <p class="mx-auto mt-5 max-w-2xl text-base text-neutral-600 sm:text-lg md:text-xl">
        {subheadline}
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3.5">
        <a
          href={ctaHref}
          class="inline-flex items-center justify-center rounded-lg bg-neutral-950 px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-neutral-800 sm:text-base"
        >
          {ctaText}
        </a>

        {
          secondaryCtaText && (
            <a
              href={secondaryCtaHref}
              class="inline-flex items-center justify-center rounded-lg border border-neutral-300 bg-white px-6 py-3.5 text-sm font-semibold text-neutral-900 transition hover:bg-neutral-100 sm:text-base"
            >
              {secondaryCtaText}
            </a>
          )
        }
      </div>
    </div>

    <!-- Crystal-Clear 16:9 Showreel Frame (Zero Overlay, Zero Mobile Cropping) -->
    <div class="relative mx-auto mt-12 aspect-video w-full overflow-hidden rounded-2xl border border-neutral-200/90 bg-neutral-100 shadow-[0_24px_70px_-15px_rgba(0,0,0,0.12)] sm:mt-14">
      <video
        id="hero-showcase-video"
        class="h-full w-full object-cover"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={posterSrc}
      >
        {webmSrc && <source src={webmSrc} type="video/webm" />}
        {mp4Src && <source src={mp4Src} type="video/mp4" />}
      </video>

      <!-- <button
        id="hero-video-toggle"
        type="button"
        aria-label="Pause showcase video"
        class="absolute right-4 bottom-4 rounded-full border border-neutral-300/80 bg-white/85 px-3 py-1.5 text-xs font-medium text-neutral-800 shadow-xs backdrop-blur-md transition hover:bg-white"
      >
        Pause
      </button> -->
    </div>
  </div>
</section>

<script>
  function initShowcaseVideo(): void {
    const video = document.getElementById("hero-showcase-video") as HTMLVideoElement | null;
    const btn = document.getElementById("hero-video-toggle") as HTMLButtonElement | null;
    if (!video || !btn) return;

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const syncLabel = (paused: boolean) => {
      btn.textContent = paused ? "Play" : "Pause";
      btn.setAttribute("aria-label", paused ? "Play showcase video" : "Pause showcase video");
    };

    if (prefersReducedMotion) {
      video.pause();
      syncLabel(true);
    }

    btn.addEventListener("click", () => {
      if (video.paused) {
        video.play().catch(() => {});
        syncLabel(false);
      } else {
        video.pause();
        syncLabel(true);
      }
    });
  }

  initShowcaseVideo();
  document.addEventListener("astro:after-swap", initShowcaseVideo);
</script>