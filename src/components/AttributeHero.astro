rap{position:absolute;inset:12% 11%;display:flex;align-items:center;justify-content:center;gap:3%}.search-card{width:53%;height:75%;background:white;border:1px solid #e1e1e1;border-radius:16px;box-shadow:0 22px 60px #00000012;padding:7%;animation:nodeFloat 5s infinite}.search-logo{font-size:clamp(21px,3vw,40px);font-weight:600;letter-spacing:-.08em}.search-logo span{color:#888}.search-input{border:1px solid #ddd;border-radius:30px;padding:12px 18px;margin:20px 0;font-size:clamp(9px,1.1vw,14px);color:#555;display:flex;justify-content:space-between}.search-result{border-top:1px solid #eee;padding-top:18px}.search-result small{display:block;color:#777}.search-result b{display:block;color:#333;font-size:clamp(11px,1.6vw,20px);margin:8px 0}.search-result p{color:#777;font-size:clamp(9px,1vw,13px);line-height:1.6}.metrics-card{width:34%;background:#17181b;color:white;border-radius:16px;padding:30px;box-shadow:0 24px 55px #0002;transform:translateY(-10%)}.metrics-card small{font-size:9px;letter-spacing:.12em;color:#aaa}.metrics-card strong{display:block;font-size:clamp(35px,5vw,72px);margin:20px 0 0;letter-spacing:-.08em}.metrics-card strong span{font-size:.5em}.metrics-card p{font-size:11px;color:#aaa}.bars{display:flex;gap:7px;height:100px;align-items:end;margin-top:25px}.bars i{flex:1;background:#aaa;border-radius:3px 3px 0 0;height:30%;animation:bars 2.5s ease-in-out infinite alternate}.bars i:nth-child(2){height:43%;animation-delay:.2s}.bars i:nth-child(3){height:38%;animation-delay:.4s}.bars i:nth-child(4){height:57%;animation-delay:.6s}.bars i:nth-child(5){height:62%;animation-delay:.8s}.bars i:nth-child(6){height:77%;animation-delay:1s}.bars i:nth-child(7){height:68%;animation-delay:1.2s}.bars i:nth-child(8){height:96%;animation-delay:1.4s}@keyframes bars{to{height:70%}}.social-card{position:absolute;right:5%;bottom:8%;display:flex;gap:10px}.social-card span{background:white;border:1px solid #ddd;border-radius:12px;padding:10px 15px;font-weight:700}.merch-wrap{posi