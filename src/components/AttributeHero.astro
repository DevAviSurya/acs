.attribute-hero{--ink:#111113;--muted:#77777c;--bg:#fff;--line:#e7e7e7;color:var(--ink);background:var(--bg);padding:clamp(48px,7vw,112px) max(24px,calc((100vw - 1440px)/2)) 70px;font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.hero-copy{text-align:center;max-width:990px;margin:0 auto 66px}.eyebrow{font-size:11px;letter-spacing:.26em;font-weight:700;color:#777;display:flex;justify-content:center;align-items:center;gap:12px;margin:0 0 30px}.eyebrow-dot{height:7px;width:7px;background:#111;border-radius:50%}.hero-copy h1{font-size:clamp(48px,6.7vw,104px);line-height:1.03;letter-spacing:-.075em;font-weight:650;margin:0}.hero-copy h1 span{color:#858589}.intro{max-width:640px;margin:26px auto 30px;font-size:clamp(15px,1.5vw,19px);line-height:1.65;color:#666}.hero-actions{display:flex;justify-content:center;gap:12px;flex-wrap:wrap}.hero-actions a{text-decoration:none;padding:15px 23px;border-radius:999px;font-size:14px;font-weight:600;transition:transform .2s}.hero-actions a:hover{transform:translateY(-2px)}.primary{background:#151515;color:white}.secondary{border:1px solid #d7d7d7;color:#222}.hero-actions span{margin-left:16px}.showreel{max-width:1440px;margin:auto;background:#f7f7f6;border:1px solid #ececeb;border-radius:20px;overflow:hidden;position:relative;isolation:isolate}.reel-head{display:flex;justify-content:space-between;padding:26px 32px 0;font-size:10px;letter-spacing:.19em;font-weight:700;color:#858585}.scene-stage{height:clamp(330px,46vw,610px);position:relative;overflow:hidden}.scene{position:absolute;inset:0;opacity:0;transform:translateX(7%) scale(.97);pointer-events:none;transition:opacity .75s cubic-bezier(.2,.8,.2,1),transform .9s cubic-bezier(.2,.8,.2,1)}.scene.active{opacity:1;transform:translateX(0) scale(1);pointer-events:auto}.reel-bottom{display:flex;justify-content:space-between;align-items:end;padding:0 32px 28px;gap:16px}.scene-kicker{font-size:10px;letter-spacing:.19em;font-weight:700;color:#777}.scene-caption h2{fon