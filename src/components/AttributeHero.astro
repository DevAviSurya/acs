/* Scene 01 — architectural row-based wireframe; all other scenes/timings retained */
.architecture-board{padding:0 5% 3%;overflow:hidden;background:#fdfdfd!important;border:1px solid #a7a7a7!important;box-shadow:0 20px 50px #00000012!important;animation:wireFloat 5s ease-in-out infinite}
.arch-header{height:13%;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #bcbcbc;font:600 clamp(6px,.75vw,10px)/1.2 ui-monospace,monospace;letter-spacing:.12em;color:#555}
.arch-ruler{display:flex;justify-content:space-between;margin:2.5% 0 2%;font:500 clamp(6px,.65vw,9px) ui-monospace,monospace;color:#8a8a8a}
.arch-grid{height:69%;display:flex;flex-direction:column;gap:5%;background:repeating-linear-gradient(to right,transparent 0,transparent calc(8.333% - 1px),#e6e6e6 calc(8.333% - 1px),#e6e6e6 8.333%);border-left:1px solid #d8d8d8;border-right:1px solid #d8d8d8}
.arch-row{display:flex;gap:3%;border:1px dashed #a0a0a0;padding:2%;position:relative;animation:archRowIn .85s cubic-bezier(.2,.8,.2,1) both}
.arch-nav{height:15%;align-items:center;animation-delay:.12s}.arch-nav i{display:block;height:30%;width:9%;border:1px solid #b0b0b0}.arch-nav .arch-logo{width:26%;height:55%;background:repeating-linear-gradient(90deg,#bbb 0 2px,transparent 2px 6px)}.arch-nav .arch-nav-cta{margin-left:auto;width:16%;height:62%;border-radius:15px;background:#e9e9e9}
.arch-hero-row{height:52%;animation-delay:.3s}.arch-hero-copy{width:52%;display:flex;flex-direction:column;justify-content:center;gap:8%}.arch-hero-copy i{height:12%;border:1px solid #aaa;background:#f0f0f0}.arch-hero-copy i:first-child{width:42%;height:9%}.arch-hero-copy i:nth-child(2){width:94%;height:20%}.arch-hero-copy i:nth-child(3){width:72%;height:20%}.arch-hero-copy i:nth-child(4){width:50%;height:11%}.arch-hero-image{width:45%;border:1px dashed #8d8d8d;display:grid;place-items:center;color:#aaa}.arch-hero-image svg{width:90%;height:85%}
.arch-cards-row{height:23%;animation-delay:.5s}.arch-cards-row i{flex:1;border:1px dashed #a0a0a0;background:repeating-linear-gradient(0deg,transparent 0 12px,#ededed 12px 13px)}
.arch-footer-row{height:10%;animation-delay:.65s;align-items:center}.arch-footer-row i{height:40%;width:27%;background:#e6e6e6}.arch-footer-row i:last-child{width:15%;margin-left:auto}
.arch-annotations{display:flex;justify-content:space-between;margin-top:2%;font:500 clamp(6px,.65vw,9px) ui-monospace,monospace;color:#777;letter-spacing:.07em}
.arch-crosshair{position:absolute;font:20px ui-monospace,monospace;color:#888}.arch-crosshair-a{left:1%;top:11%}.arch-crosshair-b{right:1%;bottom:5%}
@keyframes archRowIn{from{opacity:0;transform:translateY(24px) scaleY(.9)}to{opacity:1;transform:translateY(0) scaleY(1)}}
.scene:not(.active) .arch-row{animation-play-state:paused}
@media(max-width:700px){.architecture-board{padding:0 4% 3%}.arch-grid{height:68%}.arch-header{font-size:6px}.arch-annotations{font-size:6px}}
@media(prefers-reduced-motion:reduce){.arch-row{animation:none!important}}

/* V3: unmistakable architectural blueprint FIRST, finished website SECOND. */
.scene[data-scene="0"] .design-stack{width:min(90%,1040px);height:87%;transform:translate(-50%,-50%);perspective:none}
.scene[data-scene="0"] .architecture-board{left:5%;top:3%;width:90%;height:93%;transform:none;animation:none;border:2px solid #555!important;border-radius:3px;background:#fff!important;box-shadow:0 12px 28px #00000012!important;z-index:2}
.scene[data-scene="0"] .arch-header{height:12%;font-size:clamp(9px,1.1vw,15px);border-bottom:2px solid #555;color:#222}
.scene[data-scene="0"] .arch-ruler{font-size:clamp(8px,.9vw,12px);color:#444}
.scene[data-scene="0"] .arch-grid{height:70%;border:1px solid #aaa;background:repeating-linear-gradient(to right,transparent 0,transparent calc(8.333% - 1px),#c7c7c7 calc(8.333% - 1px),#c7c7c7 8.333%),repeating-linear-gradient(to bottom,transparent 0,transparent 24px,#ededed 25px)}
.scene[data-scene="0"] .arch-row{border:2px dashed #666}
.scene[data-scene="0"] .arch-annotations{font-size:clamp(8px,.85vw,12px);color:#333}
.scene[data-scene="0"] .design-finished{left:10%;top:8%;width:80%;height:84%;z-index:3;animation:none;opacity:0;transform:translateY(80px) scale(.9);pointer-events:none}
.scene[data-scene="0"].active .architecture-board{animation:blueprintExit 4.5s ease-in-out both}
.scene[data-scene="0"].active .design-finished{animation:websiteReveal 4.5s cubic-bezier(.2,.8,.2,1) both}
.scene[data-scene="0"].active .arch-row{animation:archRowIn .6s cubic-bezier(.2,.8,.2,1) both}
.scene[data-scene="0"].active .arch-nav{animation-delay:.15s}.scene[data-scene="0"].active .arch-hero-row{animation-delay:.45s}.scene[data-scene="0"].active .arch-cards-row{animation-delay:.8s}.scene[data-scene="0"].active .arch-footer-row{animation-delay:1.1s}
@keyframes blueprintExit{0%,54%{opacity:1;transform:translateY(0) scale(1)}75%,100%{opacity:.14;transform:translate(-45px,-35px) scale(.94)}}
@keyframes websiteReveal{0%,51%{opacity:0;transform:translateY(80px) scale(.9)}72%,100%{opacity:1;transform:translateY(0) scale(1)}}
@media(max-width:700px){.scene[data-scene="0"] .design-stack{width:100%;height:82%}.scene[data-scene="0"] .arch-header{font-size:7px}.scene[data-scene="0"] .arch-annotations{font-size:7px}}
@media(prefers-reduced-motion:reduce){.scene[data-scene="0"].active .architecture-board{animation:none;opacity:1}.scene[data-scene="0"].active .design-finished{animation:none;opacity:0}}
</style>
<script>
  const sceneData = [
    ['01 / DESIGN', 'From an idea to an experience.', 'Design systems, wireframes, interfaces'],
    ['02 / DEVELOPMENT', 'Beautifully built. Built to perform.', 'Modern web experiences, engineered with care'],
    ['03 / INTELLIGENCE', 'Smarter workflows. Less busywork.', 'Thoughtful AI integrations and automation'],
    ['04 / GROWTH', 'Get discovered. Keep growing.', 'Search visibility, analytics and campaigns'],
    ['05 / BRAND', 'Digital thinking. Tangible impact.', 'Identity, packaging and branded merchandise']
  ];
  document.querySelectorAll('[data-showreel]').forEach((root) => {
    if (root.dataset.initialized) return;
    root.dataset.initialized = 'true';
    const scenes = [...root.querySelectorAll('[data-scene]')];
    const count = root.querySelector('[data-count]');
    const kicker = root.querySelector('[data-kicker]');
    const title = root.querySelector('[data-title]');
    const subtitle = root.querySelector('[data-subtitle]');
    const bar = root.querySelector('[data-progress]');
    const toggle = root.querySelector('[data-toggle]');
    const code = root.querySelector('[data-code]');
    const snippet = `---\nimport Layout from '../layouts/Layout.astro';\n---\n<Layout title="Attribute">\n  <main class="experience">\n    <h1>Make it matter.</h1>\n    <p>Ideas into impact.</p>\n    <a href="/work">Explore work</a>\n  </main>\n</Layout>`;
    let index = 0, elapsed = 0, last = 0, paused = false, typing = 0;
    const duration = 4500;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) paused = true;
    function show(next) {
      index = (next + scenes.length) % scenes.length;
      elapsed = 0;
      scenes.forEach((scene, i) => scene.classList.toggle('active', i === index));
      count.textContent = `${String(index + 1).padStart(2, '0')} — 05`;
      [kicker.textContent, title.textContent, subtitle.textContent] = sceneData[index];
      if (index === 1) typing = 0;
      bar.style.width = '0%';
    }
    function tick(now) {
      const delta = last ? Math.min(80, now - last) : 0;
      last = now;
      if (!paused && !document.hidden) {
        elapsed += delta;
        if (index === 1 && code) {
          typing = Math.min(snippet.length, typing + delta / 25);
          code.textContent = snippet.slice(0, Math.floor(typing)) + (Math.floor(now / 400) % 2 ? '▍' : '');
        }
        if (elapsed >= duration) show(index + 1);
        else bar.style.width = `${elapsed / duration * 100}%`;
      }
      requestAnimationFrame(tick);
    }
    function setPaused(value) {
      paused = value;
      toggle.textContent = paused ? '▶' : 'Ⅱ';
      toggle.setAttribute('aria-label', paused ? 'Play animation' : 'Pause animation');
    }
    root.querySelector('[data-prev]').addEventListener('click', () => show(index - 1));
    root.querySelector('[data-next]').addEventListener('click', () => show(index + 1));
    toggle.addEventListener('click', () => setPaused(!paused));
    show(0); setPaused(paused); requestAnimationFrame(tick);
    const observer = new IntersectionObserver(entries => {
      if (!entries[0].isIntersecting) last = 0;
    }, {threshold: .1});
    observer.observe(root);
  });
</script>
