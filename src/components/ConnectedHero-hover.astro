---
interface Props {
  className?: string;
  startProjectHref?: string;
  workHref?: string;
  signalTravelMsPerUnit?: number;
}

const {
  className = '', startProjectHref = '#contact', workHref = '#work', signalTravelMsPerUnit = 850,
} = Astro.props;
---

<section class="attribute-hero-intro">
  <!-- <p class="attribute-hero-eyebrow">Digital · AI · Brand · Growth</p> -->
  <h1 class="attribute-hero-heading">
    Built in code.
    <span>Made for the real world.</span>
  </h1>
  <!-- <p class="attribute-hero-description">
    From exceptional digital experiences to intelligent automation and memorable brand identities.
    We bring every detail together.
  </p> -->
  <!-- <div class="attribute-hero-actions">
    <a class="attribute-hero-action attribute-hero-action-primary" href={startProjectHref}>
      Start a project <span aria-hidden="true">↗</span>
    </a>
    <a class="attribute-hero-action" href={workHref}>
      Explore our work <span aria-hidden="true">↗</span>
    </a>
  </div> -->
</section>

<attribute-hero-hover class:list={['attribute-hero', className]} data-signal-travel-ms-per-unit={signalTravelMsPerUnit}>
  <canvas role="img" aria-label="A three-dimensional circuit-board A stands on a wavy grid. A moving signal starts at the live code editor and travels through an AI chip, app interfaces, social media, and ends at the brand identity board.">
    Attribute
  </canvas>
  <canvas class="attribute-signal" aria-hidden="true"></canvas>
</attribute-hero-hover>

<style>
  .attribute-hero-intro {
    box-sizing: border-box;
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding: clamp(1.5rem, 5vw, 4.5rem) 1.25rem 0;
    color: #151515;
    font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    text-align: center;
  }

  .attribute-hero-eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.62rem;
    margin: 0 0 clamp(1.25rem, 3.3vw, 3rem);
    color: #696969;
    font-size: clamp(0.62rem, 1vw, 0.8rem);
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .attribute-hero-eyebrow::before {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: #151515;
    content: '';
    flex: none;
  }

  .attribute-hero-heading {
    margin: 0;
    margin-bottom: -80px;
    font-size: clamp(2.45rem, 8.15vw, 7.1rem);
    font-weight: 750;
    line-height: 1.04;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", "Noto Sans", Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
    letter-spacing: -0.075em;
  }

  .attribute-hero-heading span {
    display: block;
    margin-top: 0.08em;
    color: #808084;
    text-wrap: balance;
  }

  .attribute-hero-description {
    max-width: 37rem;
    margin: clamp(1.3rem, 2.8vw, 2.7rem) auto 0;
    color: #606060;
    font-size: clamp(0.95rem, 1.6vw, 1.25rem);
    line-height: 1.65;
    text-wrap: balance;
  }

  .attribute-hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem;
    margin-top: clamp(1.35rem, 2.65vw, 2.5rem);
  }

  .attribute-hero-action {
    display: inline-flex;
    min-height: 2.85rem;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 0.35rem clamp(1rem, 2vw, 1.55rem);
    border: 1px solid #cfcfcf;
    border-radius: 999px;
    background: #fff;
    color: #151515;
    font-size: 0.92rem;
    font-weight: 650;
    text-decoration: none;
  }

  .attribute-hero-action:hover {
    background: #f2f2f2;
  }

  .attribute-hero-action-primary {
    border-color: #151515;
    background: #151515;
    color: #fff;
  }

  .attribute-hero-action-primary:hover {
    border-color: #333;
    background: #333;
  }

  .attribute-hero-action:focus-visible {
    outline: 2px solid #151515;
    outline-offset: 4px;
  }

  .attribute-hero-action span {
    line-height: 1;
  }

  .attribute-hero {
    position: relative;
    display: block;
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    height: clamp(340px, 57vw, 700px);
    overflow: hidden;
    background: transparent;
  }

  @media (max-width: 759px) {
    .attribute-hero {
      height: clamp(340px, 70vw, 530px);
    }
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .attribute-signal {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
</style>

<script>
  type Point = [x: number, y: number, z: number];
  type LetterPoint = [x: number, y: number];
  const letterFootInner = 1.16;
  const letterFootOuter = 2.12;
  const letterWidthScale = 0.67;
  const letterDepthScale = 0.6 * 0.79;
  const letterFaceDepth = 0.35;
  const footCenter = (letterFootInner + letterFootOuter) / 2 * letterWidthScale;
  const footHalfWidth = (letterFootOuter - letterFootInner) / 2 * letterWidthScale;
  const footHalfDepth = letterFaceDepth * letterDepthScale;
  const letterOutline: LetterPoint[] = [
    [-letterFootOuter, 0.018], [-0.54, 4.28], [0.54, 4.28], [letterFootOuter, 0.018],
    [letterFootInner, 0.018], [0.83, 0.92], [-0.83, 0.92], [-letterFootInner, 0.018],
  ];
  const letterCounter: LetterPoint[] = [[-0.55, 1.65], [0, 3.19], [0.55, 1.65]];
  const circuitTraces: LetterPoint[][] = [
    [[-1.90, 0.32], [-1.35, 0.32], [-1.07, 0.61], [-1.07, 1.02]],
    [[-1.58, 0.68], [-1.27, 0.68], [-0.96, 0.98], [-0.96, 1.41], [-0.69, 1.41]],
    [[-1.26, 1.18], [-1.10, 1.18], [-1.10, 1.74], [-0.84, 2.00], [-0.84, 2.40]],
    [[-0.74, 2.08], [-0.74, 2.59], [-0.40, 2.91], [-0.40, 3.40]],
    [[-0.45, 3.12], [-0.65, 3.32], [-0.65, 3.68], [-0.44, 3.90], [0.05, 3.90]],
    [[-0.16, 3.61], [0.22, 3.61], [0.42, 3.40], [0.42, 2.95]],
    [[0.62, 2.96], [0.62, 2.46], [0.91, 2.16], [0.91, 1.78]],
    [[1.08, 1.78], [1.08, 1.21], [1.39, 0.89], [1.39, 0.51]],
    [[1.77, 0.37], [1.56, 0.37], [1.23, 0.68], [1.23, 1.02]],
    [[-0.52, 1.22], [0.20, 1.22], [0.35, 1.37], [0.73, 1.37]],
  ];
  const circuitPaths = circuitTraces.map((trace) => {
    const segments = trace.slice(1).map((end, index) => {
      const start = trace[index];
      return { start, end, length: Math.hypot(end[0] - start[0], end[1] - start[1]) };
    });
    return { segments, length: segments.reduce((total, segment) => total + segment.length, 0) };
  });
  const circuitPulseDelay = 90;
  const circuitPulseDuration = 890;
  const circuitPulseStagger = 330;
  const circuitPulseCycle = circuitPaths.length * circuitPulseStagger;
  const circuitPads: [x: number, y: number, w: number, h: number, bright: boolean][] = [];
  for (let row = 0; row < 23; row++) {
    for (let column = 0; column < 23; column++) {
      const pattern = (row * 73 + column * 43 + row * column * 17) % 37;
      if (pattern > 20) continue;
      const x = -1.99 + column * 0.18;
      const y = 0.16 + row * 0.179;
      circuitPads.push([x, y, pattern % 3 ? 0.056 + (pattern % 4) * 0.021 : 0.026,
        pattern % 3 ? 0.032 : 0.107, pattern < 8]);
    }
  }

  function drawCircuitPulses(ctx: CanvasRenderingContext2D, elapsed: number) {
    for (const [index, path] of circuitPaths.entries()) {
      const age = elapsed - circuitPulseDelay - index * circuitPulseStagger;
      if (age <= 0) continue;
      const progress = (age % circuitPulseCycle) / circuitPulseDuration;
      if (progress <= 0 || progress >= 1) continue;
      const strength = ease(clamp01(progress * 8)) * ease(clamp01((1 - progress) * 6));
      let distance = path.length * (index >= 5 && index <= 8 ? 1 - progress : progress);
      for (const { start, end, length } of path.segments) {
        if (distance > length) {
          distance -= length;
          continue;
        }
        const [x, y] = [
          start[0] + (end[0] - start[0]) * distance / length,
          start[1] + (end[1] - start[1]) * distance / length,
        ];
        const glow = ctx.createRadialGradient(x, y, 0, x, y, 0.072);
        glow.addColorStop(0, `rgba(255, 255, 255, ${0.88 * strength})`);
        glow.addColorStop(0.42, `rgba(255, 255, 255, ${0.32 * strength})`);
        glow.addColorStop(1, 'rgba(255, 255, 255, 0)');
        ctx.fillStyle = glow;
        ctx.fillRect(x - 0.072, y - 0.072, 0.144, 0.144);
        ctx.fillStyle = `rgba(255, 255, 255, ${strength})`;
        ctx.beginPath();
        ctx.arc(x, y, 0.020, 0, Math.PI * 2);
        ctx.fill();
        break;
      }
    }
  }

  function drawCircuitLetter(ctx: CanvasRenderingContext2D, project: (p: Point) => Point, scale: number) {
    const plane = (points: LetterPoint[], z: number, spread = 1) =>
      points.map(([x, y]) => project([x * spread, y * spread, z]));
    const append = (path: Path2D, points: Point[]) => {
      path.moveTo(points[0][0], points[0][1]);
      for (const [x, y] of points.slice(1)) path.lineTo(x, y);
      path.closePath();
    };
    const plate = (outline: Point[], counter: Point[]) => {
      const path = new Path2D();
      append(path, outline);
      append(path, counter);
      return path;
    };
    const back = plane(letterOutline, -letterFaceDepth);
    const rearOpening = plane(letterCounter, -letterFaceDepth);
    const front = plane(letterOutline, letterFaceDepth);
    const opening = plane(letterCounter, letterFaceDepth);
    const rearPlate = plate(back, rearOpening);
    const face = plate(front, opening);
    const solid = [rearPlate, face];

    ctx.lineJoin = 'miter';
    const rearRim = plate(plane(letterOutline, -0.46, 1.025), plane(letterCounter, -0.46, 1.025));
    ctx.fillStyle = 'rgba(200, 201, 204, .27)';
    ctx.fill(rearRim, 'evenodd');
    ctx.strokeStyle = '#c5c7cc';
    ctx.lineWidth = 1.15 * scale;
    ctx.stroke(rearRim);
    ctx.fillStyle = '#42454b';
    ctx.fill(rearPlate, 'evenodd');

    for (const [rear, forward] of [[back, front], [rearOpening, opening]]) {
      for (let i = 0; i < rear.length; i++) {
        const next = (i + 1) % rear.length;
        const wall = new Path2D();
        append(wall, [rear[i], rear[next], forward[next], forward[i]]);
        const gradient = ctx.createLinearGradient(rear[i][0], rear[i][1], forward[i][0], forward[i][1]);
        gradient.addColorStop(0, '#383b40');
        gradient.addColorStop(0.47, '#64676d');
        gradient.addColorStop(1, '#2d3035');
        ctx.fillStyle = gradient;
        ctx.fill(wall);
        ctx.strokeStyle = 'rgba(189, 191, 198, .34)';
        ctx.lineWidth = 0.7 * scale;
        ctx.stroke(wall);
        solid.push(wall);
      }
    }

    for (const [z, ink] of [[-0.20, '#c5c7cc'], [0.05, '#a2a5aa'], [0.24, '#d0d2d5']] as const) {
      ctx.strokeStyle = ink;
      ctx.lineWidth = 0.9 * scale;
      ctx.stroke(plate(plane(letterOutline, z), plane(letterCounter, z)));
    }

    const gradient = ctx.createLinearGradient(front[1][0], front[1][1], front[3][0], front[3][1]);
    gradient.addColorStop(0, '#f5f5f6');
    gradient.addColorStop(0.55, '#f0f0f2');
    gradient.addColorStop(1, '#dbdce0');
    ctx.fillStyle = gradient;
    ctx.fill(face, 'evenodd');

    ctx.save();
    ctx.clip(face, 'evenodd');
    const origin = project([0, 0, letterFaceDepth]);
    const right = project([1, 0, letterFaceDepth]);
    const up = project([0, 1, letterFaceDepth]);
    const faceTransform = [right[0] - origin[0], right[1] - origin[1],
      up[0] - origin[0], up[1] - origin[1], origin[0], origin[1]] as const;
    ctx.transform(...faceTransform);
    for (const [x, y, w, h, bright] of circuitPads) {
      ctx.fillStyle = bright ? 'rgba(98, 103, 111, .25)' : 'rgba(98, 103, 111, .13)';
      ctx.fillRect(x, y, w, h);
    }
    ctx.lineWidth = 0.016;
    ctx.lineJoin = 'round';
    ctx.strokeStyle = 'rgba(108, 112, 122, .34)';
    ctx.fillStyle = '#a4a7ae';
    for (const trace of circuitTraces) {
      ctx.beginPath();
      ctx.moveTo(...trace[0]);
      for (const point of trace.slice(1)) ctx.lineTo(...point);
      ctx.stroke();
      for (const point of [trace[0], trace[trace.length - 1]]) {
        ctx.beginPath();
        ctx.arc(...point, 0.031, 0, Math.PI * 2);
        ctx.fill();
      }
    }
    ctx.restore();

    ctx.strokeStyle = 'rgba(113, 115, 124, .42)';
    ctx.lineWidth = 2.55 * scale;
    ctx.stroke(face);
    ctx.strokeStyle = '#fff';
    ctx.lineWidth = 1.35 * scale;
    ctx.stroke(face);
    const bezel = plate(plane(letterOutline, 0.43, 1.032), plane(letterCounter, 0.43, 1.032));
    ctx.strokeStyle = 'rgba(128, 130, 141, .51)';
    ctx.lineWidth = 0.9 * scale;
    ctx.stroke(bezel);

    const silhouette = [...back, ...front];
    const x = silhouette.map(point => point[0]);
    const y = silhouette.map(point => point[1]);
    return { solid, face, faceTransform, bounds: { left: Math.min(...x), right: Math.max(...x),
      top: Math.min(...y), bottom: Math.max(...y) } };
  }

  const workspaces = [
    { x: 0.12, z: 3.52, scale: 0.86, kind: 'ai' },
    { x: -2.75, z: 1.83, scale: 1.03, kind: 'build' },
    { x: 3.48, z: 0.69, scale: 0.94, kind: 'agent' },
    { x: 0.85, z: -3.54, scale: 0.86, kind: 'brand' },
    { x: -4.20, z: -0.55, scale: 0.76, kind: 'social' },
  ] as const;
  type Workspace = (typeof workspaces)[number];
  type Project = (point: Point) => Point;

  type SheetBounds = [x: number, z: number, width: number, depth: number];
  const panelBounds: Record<Workspace['kind'], SheetBounds> = {
    agent: [-1.36, -0.88, 2.72, 1.71],
    ai: [-1.23, -0.69, 2.43, 1.38],
    build: [-1.16, -0.67, 2.27, 1.47],
    social: [-1.23, -0.69, 2.43, 1.38],
    brand: [-1.16, -0.70, 2.33, 1.42],
  };
  const appDetailBounds: SheetBounds = [-0.12, -0.34, 1.39, 1.29];
  const appBackBounds: SheetBounds = [-1.22, -0.95, 1.76, 1.21];
  const [ai, output, agent, brand, social] = workspaces;
  const hoverPanels = [agent, output, ai, social] as const;
  type HoverPanel = (typeof hoverPanels)[number]['kind'];

  function panelPort(workspace: Workspace, axis: 'x' | 'z', side: -1 | 1,
    [x, z, width, depth] = panelBounds[workspace.kind]): Point {
    const offset = 0.13 * side;
    return [
      workspace.x + (x + width * (axis === 'x' ? (side + 1) / 2 : 0.5)) * workspace.scale
        + (axis === 'x' ? offset : 0),
      0,
      workspace.z + (z + depth * (axis === 'z' ? (side + 1) / 2 : 0.5)) * workspace.scale
        + (axis === 'z' ? offset : 0),
    ];
  }

  const editorOut = panelPort(agent, 'x', -1);
  const aiIn = panelPort(ai, 'x', 1);
  const aiOut = panelPort(ai, 'x', -1);
  const appIn = panelPort(output, 'z', 1, appDetailBounds);
  const appOut = panelPort(output, 'x', -1);
  const socialIn = panelPort(social, 'z', 1);
  const socialOut = panelPort(social, 'x', 1);
  const brandIn = panelPort(brand, 'x', -1);
  const brandOut = panelPort(brand, 'x', 1);
  const elbowX = (editorOut[0] + aiIn[0]) / 2;

  const brandingExit: Point[] = [brandOut, [brandOut[0] + 0.55, 0, brandOut[2]]];
  const connectorRoutes: Point[][] = [
    [editorOut, [elbowX, 0, editorOut[2]], [elbowX, 0, aiIn[2]], aiIn],
    [aiOut, [appIn[0], 0, aiOut[2]], appIn],
    [appOut, [socialIn[0], 0, appOut[2]], socialIn],
    [socialOut, [-2.65, 0, socialOut[2]], [-2.65, 0, brandIn[2]], brandIn],
    brandingExit,
  ];
  const aiConnectorIndex = 0;
  const appConnectorIndex = 1;
  const socialConnectorIndex = 2;
  const rearConnectorIndex = 3;
  const signalLegs = connectorRoutes.flatMap((route, index) => {
    const length = (a: Point, b: Point) => Math.hypot(b[0] - a[0], b[2] - a[2]);
    const legs = route.slice(1).map((end, offset) => {
      const start = route[offset];
      return { start, end, length: length(start, end), visible: true,
        behindTruss: index === rearConnectorIndex,
        arrival: offset === route.length - 2 ? index : null };
    });
    const next = connectorRoutes[index + 1];
    if (next) {
      const start = route[route.length - 1];
      const end = next[0];
      legs.push({ start, end, length: length(start, end) * 0.18, visible: false, behindTruss: false, arrival: null });
    }
    return legs;
  });
  const signalLength = signalLegs.reduce((sum, leg) => sum + leg.length, 0);
  const connectorLead = 690;
  const signalExitDuration = 260;
  const signalRestartPause = 240;
  const typingDuration = 2050;
  const landingDuration = 720;
  const landingStagger = 110;
  const trussLandingDuration = 760;
  const trussBaseZ = -0.07;
  const impactDuration = 950;
  const groundSettleDuration = 540;
  const firstPanelStart = trussLandingDuration + groundSettleDuration + 55;
  const introDuration = firstPanelStart + 4 * landingStagger + landingDuration + 55;
  const landingOrder: Workspace['kind'][] = ['agent', 'ai', 'build', 'social', 'brand'];
  const clamp01 = (value: number) => Math.min(1, Math.max(0, value));
  const ease = (value: number) => value * value * (3 - 2 * value);
  const landingEase = (value: number) => value ** 3 * (value * (6 * value - 15) + 10);
  const groundCompression = (introElapsed: number) => {
    const sinceLanding = introElapsed - trussLandingDuration;
    const contact = ease(clamp01(sinceLanding / 150));
    const rebound = 1 - ease(clamp01((sinceLanding - 150) / (groundSettleDuration - 150)));
    return { contact, depth: contact * (0.16 + 0.10 * rebound) };
  };
  const appUpdateDuration = 1150;
  const colorPulse = (elapsed: number, duration: number) => ease(clamp01(elapsed / 320))
    * ease(clamp01((duration - elapsed) / 300));
  const hoverDurations: Record<HoverPanel, number> = {
    ai: 3508, build: appUpdateDuration, social: 1750, agent: typingDuration,
  };

  type BrandMark = 'instagram' | 'linkedin' | 'facebook';

  function drawBrandMark(ctx: CanvasRenderingContext2D, mark: BrandMark, ink: string | CanvasGradient) {
    ctx.fillStyle = ink;
    ctx.strokeStyle = ink;
    ctx.lineWidth = 1.65;
    ctx.lineJoin = 'round';
    ctx.lineCap = 'round';
    const circle = (x: number, y: number, radius: number, fill: boolean) => {
      ctx.beginPath();
      ctx.arc(x, y, radius, 0, Math.PI * 2);
      if (fill) ctx.fill();
      else ctx.stroke();
    };

    switch (mark) {
      case 'instagram':
        ctx.beginPath();
        ctx.roundRect(-7.1, -7.1, 14.2, 14.2, 3.6);
        ctx.stroke();
        circle(0, 0, 3.3, false);
        circle(4.3, -4.1, 0.94, true);
        break;
      case 'linkedin':
        ctx.beginPath();
        ctx.roundRect(-7.5, -7.5, 15, 15, 1.65);
        ctx.fill();
        ctx.fillStyle = '#fff';
        circle(-4.15, -4.09, 1.03, true);
        ctx.fillRect(-5.1, -2.22, 1.92, 7.32);
        ctx.fillRect(-1.65, -2.22, 1.84, 7.32);
        ctx.beginPath();
        ctx.moveTo(0, -0.7);
        ctx.quadraticCurveTo(0.8, -2.65, 2.73, -2.55);
        ctx.quadraticCurveTo(5.3, -2.55, 5.3, 0.78);
        ctx.lineTo(5.3, 5.1);
        ctx.lineTo(3.37, 5.1);
        ctx.lineTo(3.37, 0.65);
        ctx.quadraticCurveTo(3.37, -0.8, 2.05, -0.8);
        ctx.quadraticCurveTo(0.25, -0.8, 0.25, 0.98);
        ctx.lineTo(0.25, 5.1);
        ctx.lineTo(0, 5.1);
        ctx.fill();
        break;
      case 'facebook':
        circle(0, 0, 7.8, true);
        ctx.fillStyle = '#fff';
        ctx.beginPath();
        ctx.moveTo(-1.05, 7.5);
        ctx.lineTo(-1.05, 1.05);
        ctx.lineTo(-3.05, 1.05);
        ctx.lineTo(-3.05, -1.2);
        ctx.lineTo(-1.05, -1.2);
        ctx.lineTo(-1.05, -2.7);
        ctx.quadraticCurveTo(-1.05, -5.8, 2.05, -5.8);
        ctx.lineTo(3.5, -5.65);
        ctx.lineTo(3.5, -3.5);
        ctx.lineTo(2.35, -3.5);
        ctx.quadraticCurveTo(1.25, -3.5, 1.25, -2.4);
        ctx.lineTo(1.25, -1.2);
        ctx.lineTo(3.4, -1.2);
        ctx.lineTo(3.02, 1.05);
        ctx.lineTo(1.25, 1.05);
        ctx.lineTo(1.25, 7.5);
        ctx.closePath();
        ctx.fill();
        break;
    }
  }

  function drawAiChip(ctx: CanvasRenderingContext2D, activation: number) {
    const tone = (gray: number, r: number, g: number, b: number) =>
      `rgb(${Math.round(gray + (r - gray) * activation)}, ${Math.round(gray + (g - gray) * activation)}, ${Math.round(gray + (b - gray) * activation)})`;
    const board = ctx.createRadialGradient(0, 0, 4, 0, 0, 53);
    board.addColorStop(0, tone(34, 22, 55, 111));
    board.addColorStop(1, tone(14, 7, 19, 42));
    ctx.fillStyle = board;
    ctx.fillRect(-56, -25.5, 112, 51);

    ctx.strokeStyle = tone(124, 58, 173, 233);
    ctx.fillStyle = tone(203, 123, 219, 255);
    ctx.lineWidth = 0.95;
    ctx.lineJoin = 'round';
    for (const side of [-1, 1]) {
      for (let i = 0; i < 7; i++) {
        const y = (i - 3) * 3.3;
        const bend = 4 + (i % 3) * 3.1;
        const end = 41 + ((i * 5 + side + 1) % 9);
        const spread = y * 1.75;
        ctx.beginPath();
        ctx.moveTo(13 * side, y);
        ctx.lineTo((17 + bend) * side, y);
        ctx.lineTo((25 + bend) * side, spread);
        ctx.lineTo(end * side, spread);
        ctx.stroke();
        ctx.beginPath();
        ctx.arc(end * side, spread, i % 3 === 0 ? 1.55 : 0.96, 0, Math.PI * 2);
        ctx.fill();
      }
      for (let i = 0; i < 5; i++) {
        const x = (i - 2) * 4.1;
        const end = (19 + (i % 3) * 2) * side;
        ctx.beginPath();
        ctx.moveTo(x, 13 * side);
        ctx.lineTo(x, 16 * side);
        ctx.lineTo(x * 1.55, end);
        ctx.stroke();
        ctx.fillRect(x * 1.55 - 0.65, end - 0.65, 1.3, 1.3);
      }
    }

    ctx.fillStyle = tone(23, 18, 53, 106);
    ctx.fillRect(-13, -13, 26, 26);
    ctx.strokeStyle = tone(220, 110, 223, 255);
    ctx.lineWidth = 1.7;
    ctx.strokeRect(-13, -13, 26, 26);
    ctx.lineWidth = 0.65;
    ctx.strokeRect(-10.4, -10.4, 20.8, 20.8);
    ctx.fillStyle = tone(242, 166, 236, 255);
    ctx.beginPath();
    ctx.moveTo(-8, 5.5);
    ctx.lineTo(-3.55, -5.5);
    ctx.lineTo(-1.25, -5.5);
    ctx.lineTo(3.15, 5.5);
    ctx.lineTo(0.72, 5.5);
    ctx.lineTo(-0.23, 3.0);
    ctx.lineTo(-4.6, 3.0);
    ctx.lineTo(-5.55, 5.5);
    ctx.closePath();
    ctx.moveTo(-3.88, 1.08);
    ctx.lineTo(-2.42, -2.82);
    ctx.lineTo(-0.96, 1.08);
    ctx.closePath();
    ctx.fill('evenodd');
    ctx.fillRect(4.75, -5.5, 2.3, 11);
  }

  function drawWorkspace(context: CanvasRenderingContext2D, project: Project, workspace: Workspace,
    progress = 0, aiDuration = hoverDurations.ai) {
    const local = (x: number, z: number) => project([x * workspace.scale + workspace.x, 0, z * workspace.scale + workspace.z]);
    const polygon = (points: [number, number][], fill: string, outline?: string) => {
      context.beginPath();
      for (const [index, [x, z]] of points.entries()) {
        const [sx, sy] = local(x, z);
        if (index === 0) context.moveTo(sx, sy);
        else context.lineTo(sx, sy);
      }
      context.closePath();
      context.fillStyle = fill;
      context.fill();
      if (outline) {
        context.strokeStyle = outline;
        context.lineWidth = 0.7;
        context.stroke();
      }
    };
    const rect = (x: number, z: number, w: number, d: number, fill: string, outline?: string) =>
      polygon([[x, z], [x + w, z], [x + w, z + d], [x, z + d]], fill, outline);

    const circle = (x: number, z: number, radius: number, fill: string, start = 0, end = 2 * Math.PI) => {
      const points: [number, number][] = end - start < 6 ? [[x, z]] : [];
      for (let i = 0; i <= 26; i++) {
        const angle = start + (end - start) * i / 26;
        points.push([x + Math.cos(angle) * radius, z + Math.sin(angle) * radius]);
      }
      polygon(points, fill);
    };

    const inPlane = (x: number, z: number, scale: number, draw: () => void) => {
      const [sx, sy] = local(x, z);
      const [rightX, rightY] = local(x + scale, z);
      const [downX, downY] = local(x, z + scale);
      context.save();
      context.transform(rightX - sx, rightY - sy, downX - sx, downY - sy, sx, sy);
      draw();
      context.restore();
    };

    const sheet = (x: number, z: number, w: number, d: number, fill = '#fff') => {
      rect(x + 0.043, z + 0.045, w, d, 'rgba(0, 0, 0, .13)');
      rect(x, z, w, d, fill, '#888');
    };

    const toolbar = (x: number, z: number, w: number) => {
      rect(x, z, w, 0.19, '#282828');
      for (const offset of [0.105, 0.210, 0.315]) circle(x + offset, z + 0.095, 0.026, '#f7f7f7');
      rect(x + w - 0.54, z + 0.075, 0.39, 0.041, '#f7f7f7');
    };

    if (workspace.kind === 'build') {
      sheet(...appBackBounds);
      toolbar(-1.22, -0.95, 1.76);
      sheet(...appDetailBounds);
      toolbar(-0.12, -0.34, 1.39);
      for (const z of [0.63, 0.74, 0.85]) rect(0.61, z, 0.52, 0.025, '#939393');

      const [x, z, w, d] = panelBounds.build;
      const lift = ease(clamp01(progress / 0.28)) * (1 - ease(clamp01((progress - 0.59) / 0.41)));
      const liftHeight = (local(1, 1)[1] - local(0, 0)[1]) * 0.23;
      rect(x + 0.043, z + 0.045, w, d, 'rgba(0, 0, 0, .13)');
      context.save();
      context.translate(0, -liftHeight * lift);
      rect(x, z, w, d, '#fff', '#888');
      toolbar(x, z, w);
      rect(x + 0.11, z + 0.31, 0.48, 0.65, '#f8f8f8', '#aaa');
      for (const [index, length] of [0.32, 0.24, 0.33, 0.27, 0.19, 0.28].entries()) {
        rect(x + 0.185, z + 0.40 + index * 0.077, length, 0.024, '#363636');
      }
      rect(x + 0.69, z + 0.31, 0.57, 0.46, '#fff', '#aaa');
      inPlane(x + 0.975, z + 0.56, 0.015, () => {
        context.font = '700 17px monospace';
        context.textAlign = 'center';
        context.textBaseline = 'middle';
        context.fillStyle = '#252525';
        context.fillText('</>', 0, 0);
      });
      rect(x + 1.38, z + 0.31, 0.77, 0.46, '#f9f9f9', '#aaa');
      for (const offset of [1.57, 1.76, 1.95]) rect(x + offset, z + 0.31, 0.011, 0.46, '#aaa');
      for (const offset of [0.46, 0.61]) rect(x + 1.38, z + offset, 0.77, 0.012, '#aaa');
      circle(x + 0.94, z + 1.07, 0.21, '#a7a7a7');
      circle(x + 0.94, z + 1.07, 0.185, '#f5f5f5');
      const chartProgress = ease(clamp01((progress - 0.14) / 0.76));
      circle(x + 0.94, z + 1.07, 0.183, '#343434', -Math.PI / 2, 0.85 + chartProgress * 1.6);
      for (const [index, length] of [0.64, 0.52, 0.38].entries()) {
        rect(x + 1.39, z + 0.92 + index * 0.117, length, 0.033, '#666');
      }
      context.restore();
      return;
    }

    if (workspace.kind === 'social') {
      sheet(...panelBounds[workspace.kind]);
      toolbar(-1.23, -0.69, 2.43);
      const marks = [
        ['instagram', '#e1306c'], ['linkedin', '#0a66c2'], ['facebook', '#0866ff'],
      ] as const;
      for (const [index, [mark, color]] of marks.entries()) {
        const x = -1.075 + index * 0.75;
        rect(x, -0.36, 0.63, 0.72, '#f9f9f9', '#b5b5b5');
        inPlane(x + 0.315, -0.05, 0.023, () => {
          if (progress < 1) drawBrandMark(context, mark, '#272727');
          if (progress <= 0) return;
          context.globalAlpha *= progress;
          if (mark === 'instagram') {
            const gradient = context.createLinearGradient(6, -8, -6, 8);
            gradient.addColorStop(0, '#833ab4');
            gradient.addColorStop(0.45, color);
            gradient.addColorStop(1, '#f77737');
            drawBrandMark(context, mark, gradient);
          } else {
            drawBrandMark(context, mark, color);
          }
        });
        rect(x + 0.15, 0.23, 0.32, 0.025, '#909090');
      }
      return;
    }

    if (workspace.kind === 'ai') {
      sheet(...panelBounds.ai);
      toolbar(-1.23, -0.69, 2.43);
      const chipZ = 0.075;
      const elapsed = progress * aiDuration;
      const activation = ease(clamp01(elapsed / 220))
        * ease(clamp01((aiDuration - elapsed) / 340));
      inPlane(0, chipZ, 0.021, () => drawAiChip(context, activation));

      if (elapsed > 0 && elapsed < 1320) {
        context.save();
        const alpha = context.globalAlpha;
        const radiusScale = Math.hypot(local(1, 0)[0] - local(0, 0)[0], local(1, 0)[1] - local(0, 0)[1]);
        for (let i = 0; i < 24; i++) {
          const age = (elapsed - (i % 6) * 65) / (710 + (i % 5) * 55);
          if (age <= 0 || age >= 1) continue;
          const angle = i * 2.399963;
          const spread = ease(age) * (0.38 + (i % 7) * 0.075);
          const lift = age * (0.35 + (i % 5) * 0.13);
          const [x, y] = project([
            workspace.x + Math.cos(angle) * spread * workspace.scale,
            lift,
            workspace.z + (chipZ + Math.sin(angle) * spread) * workspace.scale,
          ]);
          const radius = Math.max(0.55, radiusScale * (0.011 + (i % 4) * 0.006));
          context.globalAlpha = alpha * ease(clamp01(age * 8)) * (1 - age);
          context.fillStyle = '#008fd6';
          context.beginPath();
          context.arc(x, y, radius, 0, Math.PI * 2);
          context.fill();
          context.fillStyle = '#bdf4ff';
          context.beginPath();
          context.arc(x, y, radius * 0.52, 0, Math.PI * 2);
          context.fill();
        }
        context.restore();
      }
      return;
    }

    if (workspace.kind === 'brand') {
      sheet(...panelBounds.brand);
      rect(-0.98, -0.51, 0.72, 0.67, '#262626');
      polygon([[-0.86, 0.02], [-0.63, -0.37], [-0.39, 0.02],
        [-0.49, 0.02], [-0.63, -0.23], [-0.77, 0.02]], '#f7f7f7');
      for (const [index, gray] of ['#222', '#767676', '#c5c5c5'].entries()) {
        rect(-0.04 + index * 0.36, -0.49, 0.29, 0.37, gray);
      }
      for (const [index, length] of [0.93, 0.68, 0.82].entries()) {
        rect(-0.04, 0.075 + index * 0.125, length, 0.031, '#888');
      }
      rect(-0.98, 0.37, 0.63, 0.024, '#929292');
      return;
    }

    // A VS Code-style editor shows the AI agent building the output.
    sheet(...panelBounds.agent, '#000');
    rect(-1.36, -0.88, 2.72, 0.22, '#131313');
    rect(-1.36, -0.66, 0.31, 1.49, '#141414');
    rect(-1.05, -0.66, 0.73, 0.17, '#252525');
    rect(-1.36, 0.67, 2.72, 0.16, '#161616');
    for (const offset of [0.105, 0.205, 0.305]) circle(1.36 - offset, -0.772, 0.023, '#a5a5a5');
    polygon([[-1.26, -0.48], [-1.23, -0.51], [-1.18, -0.46], [-1.11, -0.54], [-1.07, -0.52],
      [-1.07, -0.34], [-1.11, -0.32], [-1.18, -0.40], [-1.23, -0.35], [-1.26, -0.38],
      [-1.21, -0.43]], '#e0e0e0');
    polygon([[-1.11, -0.48], [-1.16, -0.43], [-1.11, -0.38]], '#141414');
    for (const z of [-0.18, 0.02, 0.22, 0.42]) rect(-1.24, z, 0.081, 0.047, '#9b9b9b');

    const code = [
      'import { agent } from "./ai";',
      '',
      'const draft = await agent.run();',
      'await app.publish(draft);',
    ];
    const typedCharacters = Math.floor(progress * (code[2].length + code[3].length));
    inPlane(-0.95, -0.54, 0.010, () => {
      context.font = '10px monospace';
      context.textBaseline = 'top';
      context.textAlign = 'left';
      context.fillStyle = '#e8e8e8';
      context.fillText('agent.ts', 0, -8);
      let remaining = typedCharacters;
      let cursorX = 0;
      let cursorY = 49;
      for (const [index, line] of code.entries()) {
        const y = 11 + index * 27;
        const visible = index < 2 ? line : line.slice(0, Math.max(0, remaining));
        context.fillStyle = '#939393';
        context.fillText(String(index + 1), 0, y);
        context.fillStyle = index === 0 ? '#b5b5b5' : '#f3f3f3';
        context.fillText(visible, 18, y);
        if (index >= 2 && remaining >= 0) {
          cursorX = 18 + context.measureText(visible).width;
          cursorY = y;
          remaining -= line.length;
        }
      }
      if (progress > 0 && progress < 1) {
        context.fillStyle = '#fff';
        context.fillRect(cursorX + 2, cursorY - 2, 1.35, 14);
      }
    });
  }

  class AttributeHero extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      const canvas = this.querySelector('canvas');
      const signalCanvas = this.querySelector<HTMLCanvasElement>('.attribute-signal');
      const context = canvas?.getContext('2d');
      const signalContext = signalCanvas?.getContext('2d');
      if (!canvas || !context || !signalCanvas || !signalContext) return;

      const configuredSpeed = Number(this.dataset.signalTravelMsPerUnit);
      const msPerUnit = Number.isFinite(configuredSpeed) && configuredSpeed > 0 ? configuredSpeed : 850;
      const travelDuration = signalLength * msPerUnit;
      const signalEnd = connectorLead + travelDuration;
      const loopDuration = signalEnd + signalExitDuration + signalRestartPause;
      const connectorArrival = (connector: number) => {
        const entry = signalLegs.findIndex(leg => leg.arrival === connector);
        const distance = signalLegs.slice(0, entry + 1).reduce((sum, leg) => sum + leg.length, 0);
        return connectorLead + distance * msPerUnit;
      };
      const aiArrival = connectorArrival(aiConnectorIndex);
      const appArrival = connectorArrival(appConnectorIndex);
      const socialArrival = connectorArrival(socialConnectorIndex);
      // Leave enough time for the chip burst to finish at faster settings.
      const aiEffectDuration = Math.max(appArrival - aiArrival, 1660);
      const aiIsProcessing = (phase: number) => phase >= aiArrival && phase < aiArrival + aiEffectDuration;
      const appProgress = (phase: number) => clamp01((phase - appArrival) / appUpdateDuration);
      const socialColor = (phase: number) => colorPulse(phase - socialArrival, loopDuration - socialArrival);

      const events = new AbortController();
      const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const target = { x: 0, y: 0, ripple: 0, centerRipple: 0 };
      const view = { ...target };
      let width = 0;
      let height = 0;
      let frame = 0;
      let lastTime = 0;
      let introElapsed = motion.matches ? introDuration : 0;
      let loopElapsed = 0;
      let connectorRevealElapsed = motion.matches ? connectorLead : 0;
      let circuitRunningTime = 0;
      let visible = true;
      let signalSize = 4;
      let ripplePhase = 0;
      let hoveredPanel: HoverPanel | undefined;
      const hoverElapsed: Record<HoverPanel, number> = { ai: Infinity, build: Infinity, social: Infinity, agent: Infinity };
      let trussBounds = { left: 0, right: 0, top: 0, bottom: 0 };
      let projectedLegs: { start: Point; end: Point }[] = [];
      let letter: ReturnType<typeof drawCircuitLetter> | undefined;

      const drawSignal = () => {
        if (introElapsed < introDuration || motion.matches || !projectedLegs.length
          || loopElapsed < connectorLead || loopElapsed >= signalEnd + signalExitDuration) return;
        const arrivalOpacity = 1 - ease(clamp01((loopElapsed - signalEnd) / signalExitDuration));
        const travel = clamp01((loopElapsed - connectorLead) / travelDuration);
        let distance = signalLength * travel;
        for (const [index, leg] of signalLegs.entries()) {
          if (distance > leg.length && index < signalLegs.length - 1) {
            distance -= leg.length;
            continue;
          }
          if (!leg.visible) return;
          const { start, end } = projectedLegs[index];
          const progress = clamp01(distance / leg.length);
          const x = start[0] + (end[0] - start[0]) * progress;
          const y = start[1] + (end[1] - start[1]) * progress;
          signalContext.beginPath();
          signalContext.ellipse(x, y, signalSize, signalSize * 0.66, 0, 0, Math.PI * 2);
          signalContext.save();
          signalContext.globalAlpha = arrivalOpacity;
          signalContext.fillStyle = '#fff';
          signalContext.shadowColor = 'rgba(0, 0, 0, .24)';
          signalContext.shadowBlur = 3;
          signalContext.fill();
          signalContext.restore();
          if (leg.behindTruss) {
            signalContext.save();
            signalContext.globalCompositeOperation = 'destination-out';
            for (const path of letter?.solid ?? []) signalContext.fill(path, 'evenodd');
            signalContext.restore();
          }
          return;
        }
      };

      const drawOverlays = () => {
        signalContext.clearRect(0, 0, width, height);
        drawSignal();
        if (!letter || motion.matches || !target.centerRipple || circuitRunningTime <= circuitPulseDelay) return;
        signalContext.save();
        signalContext.clip(letter.face, 'evenodd');
        signalContext.transform(...letter.faceTransform);
        drawCircuitPulses(signalContext, circuitRunningTime);
        signalContext.restore();
      };

      const render = () => {
        if (!width || !height) return;
        context.clearRect(0, 0, width, height);
        const stacked = width < 760;
        const unit = Math.min(height * 0.126, width * 0.087);
        const centerX = width * (stacked ? 0.48 : 0.5);
        const centerY = height * (stacked ? 0.52 : 0.51);
        const yaw = -Math.PI / 4 + view.x * 0.063;
        const pitch = 0.55 + view.y * 0.038;
        const sinYaw = Math.sin(yaw);
        const cosYaw = Math.cos(yaw);
        const sinPitch = Math.sin(pitch);
        const cosPitch = Math.cos(pitch);

        const project = ([x, y, z]: Point): Point => {
          const horizontal = x * cosYaw + z * sinYaw;
          const forward = z * cosYaw - x * sinYaw;
          const vertical = y * cosPitch - forward * sinPitch;
          const depth = y * sinPitch + forward * cosPitch;
          return [centerX + horizontal * unit, centerY - vertical * unit, depth];
        };

        const stroke = (a: Point, b: Point) => {
          context.moveTo(a[0], a[1]);
          context.lineTo(b[0], b[1]);
        };

        // Invert the floor projection so the ripple is circular on the 3D surface.
        const pointerAcross = ((view.x + 1) * width / 2 - centerX) / unit;
        const pointerDepth = ((view.y + 1) * height / 2 - centerY) / (unit * sinPitch);
        const pointerX = pointerAcross * cosYaw - pointerDepth * sinYaw;
        const pointerZ = pointerAcross * sinYaw + pointerDepth * cosYaw;
        const rippleRadius = 2.25;
        const rippleHeight = 0.16 * view.ripple * (1 - view.centerRipple);
        const centerRippleHeight = 0.21 * view.centerRipple;
        const impactProgress = clamp01((introElapsed - trussLandingDuration) / impactDuration);
        const { contact, depth: dentDepth } = groundCompression(introElapsed);
        const impactHeight = 0.24 * ease(clamp01(impactProgress * 17)) * (1 - impactProgress) ** 1.25;
        const impactRadius = impactProgress * 6.4;
        const softBend = (distance: number, span: number) => {
          const progress = Math.min(1, Math.max(0, distance / span));
          return progress * progress * (3 - 2 * progress);
        };
        const gridPoint = (x: number, z: number): Point => {
          // The center stays level while the outer mesh rises and falls gently.
          const shoulder = softBend(Math.abs(x) - 4.60, 4.5);
          const back = softBend(-z - 3.65, 5.2);
          const front = softBend(z - 4.12, 4.4);
          const rearCorner = softBend(-x - 2.1, 3.6) * softBend(-z - 1.35, 2.75);
          const nearCorner = softBend(-x - 2.84, 3.7) * softBend(z - 1.63, 3.2);
          let y = 0.96 * back - 0.66 * shoulder - 0.46 * front
            + 0.86 * rearCorner - 0.78 * nearCorner;
          if (rippleHeight > 0.0003) {
            const distance = Math.hypot(x - pointerX, z - pointerZ) / rippleRadius;
            const envelope = 1 - softBend(distance, 1);
            y += rippleHeight * envelope * Math.cos(distance * Math.PI * 3.2);
          }
          if (centerRippleHeight > 0.0003 || impactHeight > 0.0003) {
            const distance = Math.hypot(x, z - trussBaseZ);
            if (centerRippleHeight > 0.0003) {
              const envelope = 1 - softBend(distance, 4.4);
              y += centerRippleHeight * envelope * Math.cos(distance * 6 - ripplePhase);
            }
            const offset = (distance - impactRadius) / 0.94;
            if (Math.abs(offset) < 1) {
              y += impactHeight * (1 - ease(Math.abs(offset))) * Math.cos(offset * Math.PI);
            }
          }
          if (contact > 0 && Math.abs(Math.abs(x) - footCenter) < footHalfWidth + 0.68
            && Math.abs(z - trussBaseZ) < footHalfDepth + 0.68) {
            const edgeX = Math.max(0, Math.abs(Math.abs(x) - footCenter) - footHalfWidth);
            const edgeZ = Math.max(0, Math.abs(z - trussBaseZ) - footHalfDepth);
            const footprint = 1 - softBend(Math.hypot(edgeX, edgeZ), 0.68);
            y = y * (1 - contact * footprint) - dentDepth * footprint;
          }
          return project([x, y, z]);
        };

        const traceGrid = (fixed: number, across: boolean) => {
          for (let i = 0; i <= 100; i++) {
            const coordinate = -10 + i * 0.20;
            const [x, y] = across ? gridPoint(coordinate, fixed) : gridPoint(fixed, coordinate);
            if (i === 0) context.moveTo(x, y);
            else context.lineTo(x, y);
          }
        };

        const floor = context.createRadialGradient(centerX, centerY, 0, centerX, centerY, width * 0.63);
        floor.addColorStop(0, 'rgba(72, 72, 72, .22)');
        floor.addColorStop(0.49, 'rgba(72, 72, 72, .13)');
        floor.addColorStop(0.78, 'rgba(72, 72, 72, .06)');
        floor.addColorStop(1, 'rgba(72, 72, 72, 0)');
        context.lineCap = 'butt';
        context.strokeStyle = floor;
        context.lineWidth = 0.48;
        context.beginPath();
        const halfCells = 32;
        for (let line = -halfCells; line <= halfCells; line++) {
          const coordinate = line * 10 / halfCells;
          traceGrid(coordinate, true);
          traceGrid(coordinate, false);
        }
        context.stroke();

        // Fade the floor at the canvas edges before drawing the scene on top.
        const edgeFade = context.createLinearGradient(0, 0, width, 0);
        edgeFade.addColorStop(0.006, 'rgba(0, 0, 0, 1)');
        edgeFade.addColorStop(0.055, 'rgba(0, 0, 0, .72)');
        edgeFade.addColorStop(0.16, 'rgba(0, 0, 0, 0)');
        edgeFade.addColorStop(0.84, 'rgba(0, 0, 0, 0)');
        edgeFade.addColorStop(0.945, 'rgba(0, 0, 0, .72)');
        edgeFade.addColorStop(0.994, 'rgba(0, 0, 0, 1)');
        context.save();
        context.globalCompositeOperation = 'destination-out';
        context.fillStyle = edgeFade;
        context.fillRect(0, 0, width, height);
        const verticalFade = context.createLinearGradient(0, 0, 0, height);
        verticalFade.addColorStop(0.08, 'rgba(0, 0, 0, 1)');
        verticalFade.addColorStop(0.43, 'rgba(0, 0, 0, 0)');
        verticalFade.addColorStop(0.80, 'rgba(0, 0, 0, 0)');
        verticalFade.addColorStop(0.94, 'rgba(0, 0, 0, .6)');
        verticalFade.addColorStop(1, 'rgba(0, 0, 0, 1)');
        context.fillStyle = verticalFade;
        context.fillRect(0, 0, width, height);
        context.restore();

        const terminalRadius = Math.max(1.45, Math.min(2.2, unit * 0.032));
        const gap = terminalRadius + 2.0;
        const trim = (start: Point, end: Point, amount: number): Point => {
          const distance = Math.hypot(end[0] - start[0], end[1] - start[1]);
          const ratio = Math.min(amount / distance, 0.32);
          return [start[0] + (end[0] - start[0]) * ratio,
            start[1] + (end[1] - start[1]) * ratio, start[2]];
        };
        context.lineCap = 'butt';
        context.lineJoin = 'miter';
        context.strokeStyle = '#737373';
        context.lineWidth = 0.82;
        for (const [index, route] of connectorRoutes.entries()) {
          const connectorStagger = 38;
          const drawDuration = connectorLead - connectorStagger * (connectorRoutes.length - 1);
          const progress = ease(clamp01((connectorRevealElapsed - index * connectorStagger) / drawDuration));
          if (!progress) continue;

          const path = route.map(project);
          const first = trim(path[0], path[1], gap);
          const endpoint = path[path.length - 1];
          const last = trim(endpoint, path[path.length - 2], gap);
          const trace = [first, ...path.slice(1, -1), last];
          context.save();
          context.globalAlpha = Math.min(1, progress * 1.35);
          if (progress < 1) {
            const length = trace.slice(1).reduce((sum, end, i) =>
              sum + Math.hypot(end[0] - trace[i][0], end[1] - trace[i][1]), 0);
            context.setLineDash([length, length]);
            context.lineDashOffset = length * (1 - progress);
          }
          context.beginPath();
          context.moveTo(first[0], first[1]);
          for (const [x, y] of trace.slice(1)) context.lineTo(x, y);
          context.stroke();
          context.restore();

          for (const [terminal, [x, y]] of [path[0], endpoint].entries()) {
            const alpha = terminal === 0 ? progress * 2.2 : (progress - 0.72) / 0.28;
            if (alpha <= 0) continue;
            context.save();
            context.globalAlpha = Math.min(1, alpha);
            context.beginPath();
            context.ellipse(x, y, terminalRadius, terminalRadius * 0.60, 0, 0, Math.PI * 2);
            context.fillStyle = '#fff';
            context.fill();
            context.strokeStyle = '#424242';
            context.stroke();
            context.restore();
          }
        }
        projectedLegs = signalLegs.map(({ start, end }) => ({ start: project(start), end: project(end) }));
        signalSize = Math.max(3.1, Math.min(5.1, unit * 0.070));

        const drawPanel = (workspace: Workspace, activity = 0, aiDuration = aiEffectDuration) => {
          const start = firstPanelStart + landingOrder.indexOf(workspace.kind) * landingStagger;
          const progress = Math.min(1, Math.max(0, (introElapsed - start) / landingDuration));
          if (!progress) return;
          if (progress === 1) {
            drawWorkspace(context, project, workspace, activity, aiDuration);
            return;
          }

          const elevation = 1 - landingEase(progress);
          context.save();
          context.globalAlpha = ease(clamp01(progress * 1.85));
          context.translate(0, -Math.min(112, height * 0.25) * elevation);
          drawWorkspace(context, project, workspace, activity, aiDuration);
          context.restore();
        };

        // Test the panel footprints in scene coordinates, accounting for the current camera.
        const hitAcross = ((target.x + 1) * width / 2 - centerX) / unit;
        const hitDepth = ((target.y + 1) * height / 2 - centerY) / (unit * sinPitch);
        const worldX = hitAcross * cosYaw - hitDepth * sinYaw;
        const worldZ = hitAcross * sinYaw + hitDepth * cosYaw;
        const hit = !motion.matches && target.ripple > 0 && introElapsed >= introDuration
          ? hoverPanels.find((panel) => {
            const x = (worldX - panel.x) / panel.scale;
            const z = (worldZ - panel.z) / panel.scale;
            const inside = ([left, top, w, d]: SheetBounds) =>
              x >= left && x <= left + w && z >= top && z <= top + d;
            return inside(panelBounds[panel.kind])
              || (panel.kind === 'build' && (inside(appBackBounds) || inside(appDetailBounds)));
          })?.kind
          : undefined;
        if (hit && hit !== hoveredPanel) hoverElapsed[hit] = 0;
        hoveredPanel = hit;

        const progress = (panel: HoverPanel, signalStart: number) => {
          const signalAge = loopElapsed - signalStart;
          const signal = signalAge >= 0 ? signalAge : Infinity;
          const elapsed = Math.min(signal, hoverElapsed[panel]);
          return elapsed === Infinity ? 0 : clamp01(elapsed / hoverDurations[panel]);
        };
        const signalAi = aiIsProcessing(loopElapsed) ? loopElapsed - aiArrival : Infinity;
        const aiDuration = hoverElapsed.ai < signalAi ? hoverDurations.ai : aiEffectDuration;
        drawPanel(brand);
        drawPanel(social, motion.matches ? 0 : Math.max(
          socialColor(loopElapsed), colorPulse(hoverElapsed.social, hoverDurations.social),
        ));
        drawPanel(ai, motion.matches ? 0 : clamp01(Math.min(hoverElapsed.ai, signalAi) / aiDuration), aiDuration);
        drawPanel(output, motion.matches ? 0 : progress('build', appArrival));

        const descent = clamp01(introElapsed / trussLandingDuration);
        const entryY = Math.min(38, height * 0.074) * (1 - landingEase(descent));
        const projectStructure = ([x, y, z]: Point): Point => {
          const [sx, sy, depth] = project([
            x * letterWidthScale, (y - 0.018) * 0.78 - dentDepth, z * letterDepthScale + trussBaseZ,
          ]);
          return [sx, sy - entryY, depth];
        };

        context.save();
        context.globalAlpha = ease(clamp01(descent / 0.64));
        letter = drawCircuitLetter(context, projectStructure, Math.max(0.68, Math.min(1.25, unit / 75)));
        trussBounds = letter.bounds;
        context.restore();

        const typing = motion.matches ? 1 : progress('agent', connectorLead);
        drawPanel(agent, typing);
        drawOverlays();
      };

      const animate = (time: number) => {
        frame = 0;
        const frameElapsed = lastTime ? time - lastTime : 16;
        const elapsed = Math.min(frameElapsed, 48);
        lastTime = time;
        if (introElapsed < introDuration) {
          introElapsed = Math.min(introDuration, introElapsed + elapsed);
          render();
          queue();
          return;
        }

        const previousPhase = loopElapsed;
        loopElapsed += frameElapsed;
        if (loopElapsed >= loopDuration) {
          loopElapsed = connectorLead + (loopElapsed - loopDuration) % (loopDuration - connectorLead);
        }
        connectorRevealElapsed = Math.min(connectorLead, connectorRevealElapsed + frameElapsed);
        circuitRunningTime = target.centerRipple ? circuitRunningTime + frameElapsed : 0;
        let hoverAnimating = false;
        for (const { kind } of hoverPanels) {
          if (hoverElapsed[kind] < hoverDurations[kind]) {
            hoverAnimating = true;
            hoverElapsed[kind] = Math.min(hoverDurations[kind], hoverElapsed[kind] + elapsed);
          } else if (loopElapsed < previousPhase) {
            hoverElapsed[kind] = Infinity;
          }
        }
        const blend = 1 - Math.exp(-elapsed / 115);
        const moving = view.x !== target.x || view.y !== target.y || view.ripple !== target.ripple
          || view.centerRipple !== target.centerRipple || view.centerRipple > 0;
        view.x += (target.x - view.x) * blend;
        view.y += (target.y - view.y) * blend;
        view.ripple += (target.ripple - view.ripple) * blend;
        view.centerRipple += (target.centerRipple - view.centerRipple) * blend;
        const remaining = Math.abs(target.x - view.x) + Math.abs(target.y - view.y)
          + Math.abs(target.ripple - view.ripple) + Math.abs(target.centerRipple - view.centerRipple);
        if (remaining <= 0.001) Object.assign(view, target);
        ripplePhase = view.centerRipple > 0 ? (ripplePhase + elapsed * 0.007) % (Math.PI * 2) : 0;

        const sceneIsAnimating = (phase: number) => phase <= connectorLead + typingDuration
          || aiIsProcessing(phase);
        const socialIsAnimating = socialColor(previousPhase) !== socialColor(loopElapsed);
        const appIsAnimating = appProgress(previousPhase) !== appProgress(loopElapsed);
        if (moving || hoverAnimating || socialIsAnimating || appIsAnimating
          || sceneIsAnimating(previousPhase) || sceneIsAnimating(loopElapsed)) render();
        else drawOverlays();
        queue();
      };

      const queue = () => {
        if (!frame && visible && !motion.matches) frame = requestAnimationFrame(animate);
      };

      const reset = () => {
        target.x = 0;
        target.y = 0;
        target.ripple = 0;
        target.centerRipple = 0;
        circuitRunningTime = 0;
        hoveredPanel = undefined;
        if (view.x || view.y || view.ripple || view.centerRipple) queue();
        else render();
      };

      const resize = () => {
        const bounds = this.getBoundingClientRect();
        width = bounds.width;
        height = bounds.height;
        const density = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.max(1, Math.round(width * density));
        canvas.height = Math.max(1, Math.round(height * density));
        signalCanvas.width = canvas.width;
        signalCanvas.height = canvas.height;
        context.setTransform(density, 0, 0, density, 0, 0);
        signalContext.setTransform(density, 0, 0, density, 0, 0);
        render();
      };

      const aim = (event: PointerEvent) => {
        const rect = this.getBoundingClientRect();
        if (motion.matches || !rect.width || !rect.height) return;
        const x = event.clientX - rect.left;
        const y = event.clientY - rect.top;
        target.x = 2 * x / rect.width - 1;
        target.y = 2 * y / rect.height - 1;
        target.ripple = 1;
        const { left, right, top, bottom } = trussBounds;
        const padding = 7;
        target.centerRipple = Number(x >= left - padding && x <= right + padding
          && y >= top - padding && y <= bottom + padding);
        queue();
      };

      const options = { signal: events.signal, passive: true };
      this.addEventListener('pointermove', (event) => {
        if (event.pointerType === 'mouse') aim(event);
      }, options);
      this.addEventListener('pointerleave', (event) => {
        if (event.pointerType === 'mouse') reset();
      }, options);
      this.addEventListener('pointercancel', reset, options);
      motion.addEventListener('change', () => {
        if (!motion.matches) {
          queue();
          return;
        }
        cancelAnimationFrame(frame);
        frame = 0;
        lastTime = 0;
        introElapsed = introDuration;
        connectorRevealElapsed = connectorLead;
        Object.assign(target, { x: 0, y: 0, ripple: 0, centerRipple: 0 });
        circuitRunningTime = 0;
        ripplePhase = 0;
        hoveredPanel = undefined;
        for (const { kind } of hoverPanels) hoverElapsed[kind] = Infinity;
        Object.assign(view, target);
        render();
      }, options);

      const observer = new ResizeObserver(resize);
      observer.observe(this);
      const visibility = new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        if (visible) queue();
        else {
          cancelAnimationFrame(frame);
          frame = 0;
          lastTime = 0;
        }
      });
      visibility.observe(this);
      resize();
      queue();
      this.cleanup = () => {
        observer.disconnect();
        visibility.disconnect();
        events.abort();
        cancelAnimationFrame(frame);
      };
    }

    disconnectedCallback() {
      this.cleanup?.();
    }
  }

  if (!customElements.get('attribute-hero-hover')) {
    customElements.define('attribute-hero-hover', AttributeHero);
  }
</script>
