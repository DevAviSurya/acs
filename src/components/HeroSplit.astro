---
export interface Props {
  eyebrow?: string;
  headline?: string;
  subheadline?: string;
  primaryCtaText?: string;
  primaryCtaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
  mp4Src?: string;
  webmSrc?: string;
  posterSrc?: string;
}

const {
  eyebrow = "Web · AI · Growth · Custom Merch",
  headline = "Built in code. Scaled with AI. Worn in real life.",
  subheadline = "A unified studio for high-converting websites, AI automation, Google SEO, social marketing, and custom branded merchandise.",
  primaryCtaText = "Book a Discovery Call",
  primaryCtaHref = "#contact",
  secondaryCtaText = "Explore Work",
  secondaryCtaHref = "#work",
  mp4Src = "/videos/hero-showreel-light.mp4",
  webmSrc = "/videos/hero-showreel-light.webm",
  posterSrc,
} = Astro.props;
---

<section
  class="relative w-full overflow-x-clip bg-white px-6 pt-12 pb-20 text-neutral-950 sm:pt-16 sm:pb-24 lg:px-12"
  aria-label="Hero"
>
  <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-6">
    <!-- Left Column: Uncluttered Editorial Copy (5 cols) -->
    <div class="relative z-10 lg:col-span-5">
      <p class="mb-5 flex items-center gap-2 text-xs font-medium tracking-[0.14em] text-neutral-500 uppercase">
        <span class="h-1.5 w-1.5 rounded-full bg-neutral-900"></span>
        <span>{eyebrow}</span>
      </p>

      <h1 class="text-4xl font-semibold tracking-[-0.03em] text-balance text-neutral-950 sm:text-5xl lg:text-[3.35rem] lg:leading-[1.06]">
        {headline}
      </h1>

      <p class="mt-5 max-w-md text-base leading-relaxed text-neutral-600 sm:text-[1.075rem]">
        {subheadline}
      </p>

      <!-- Pill Primary CTA (matches navbar) + Clean Ghost Link -->
      <div class="mt-9 flex flex-wrap items-center gap-6">
        <a
          href={primaryCtaHref}
          class="inline-flex items-center justify-center rounded-full bg-neutral-900 px-7 py-3.5 text-sm font-medium text-white transition hover:-translate-y-0.5 hover:bg-neutral-800 sm:text-base"
        >
          {primaryCtaText}
        </a>

        {
          secondaryCtaText && (
            <a
              href={secondaryCtaHref}
              class="group inline-flex items-center gap-1.5 text-sm font-medium text-neutral-800 transition hover:text-neutral-950 sm:text-base"
            >
              <span>{secondaryCtaText}</span>
              <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
            </a>
          )
        }
      </div>
    </div>

    <!-- Right Column: Borderless Floating Showcase (7 cols) -->
    <div class="lg:col-span-7">
      <div class="relative aspect-video w-full lg:scale-[1.06] lg:translate-x-4">
        <!-- Soft radial edge mask dissolves rectangular edges into the page -->
        <video
          id="hero-split-video"
          class="h-full w-full object-cover"
          style="mask-image: radial-gradient(ellipse 92% 88% at 50% 50%, black 68%, transparent 100%); -webkit-mask-image: radial-gradient(ellipse 92% 88% at 50% 50%, black 68%, transparent 100%);"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={posterSrc}
        >
          {webmSrc && <source src={webmSrc} type="video/webm" />}
          {mp4Src && <source src={mp4Src} type="video/mp4" />}
        </video>

        <!-- Discreet Apple-style Pause/Play icon -->
        <button
          id="hero-split-toggle"
          type="button"
          aria-label="Pause showcase video"
          class="absolute right-4 bottom-4 flex h-8 w-8 items-center justify-center rounded-full border border-black/10 bg-white/80 text-neutral-900 shadow-xs backdrop-blur-md transition hover:scale-105 hover:bg-white"
        >
          <svg id="icon-pause" class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <rect x="3.5" y="2.5" width="3" height="11" rx="1" />
            <rect x="9.5" y="2.5" width="3" height="11" rx="1" />
          </svg>
          <svg id="icon-play" class="hidden h-3.5 w-3.5 translate-x-0.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M4 2.8a.8.8 0 0 1 1.22-.68l8.4 5.2a.8.8 0 0 1 0 1.36l-8.4 5.2A.8.8 0 0 1 4 13.2V2.8z" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  function initSplitHero(): void {
    const video = document.getElementById("hero-split-video") as HTMLVideoElement | null;
    const btn = document.getElementById("hero-split-toggle") as HTMLButtonElement | null;
    const iconPause = document.getElementById("icon-pause");
    const iconPlay = document.getElementById("icon-play");
    if (!video || !btn || !iconPause || !iconPlay) return;

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const sync = (paused: boolean) => {
      iconPause.classList.toggle("hidden", paused);
      iconPlay.classList.toggle("hidden", !paused);
      btn.setAttribute("aria-label", paused ? "Play showcase video" : "Pause showcase video");
    };

    if (prefersReducedMotion) {
      video.pause();
      sync(true);
    }

    btn.addEventListener("click", () => {
      if (video.paused) {
        video.play().catch(() => {});
        sync(false);
      } else {
        video.pause();
        sync(true);
      }
    });
  }

  initSplitHero();
  document.addEventListener("astro:after-swap", initSplitHero);
</script>