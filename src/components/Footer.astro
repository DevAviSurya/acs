---
import { siteConfig } from '../config/site';
import { mainNav } from '../data/navigation';

const year = new Date().getFullYear();
---

<footer class="border-t border-brand-border/60 bg-brand-surface">
	<div class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
		<div class="grid gap-12 lg:grid-cols-4">
			<div class="lg:col-span-2">
				<p class="text-lg font-semibold text-brand-foreground">{siteConfig.name}</p>
				<p class="mt-4 max-w-sm text-sm leading-relaxed text-brand-muted">{siteConfig.description}</p>
			</div>

			<div>
				<h2 class="text-sm font-semibold uppercase tracking-wider text-brand-foreground">Navigate</h2>
				<ul class="mt-4 space-y-2">
					{mainNav.map((item) => (
						<li>
							<a href={item.href} class="text-sm text-brand-muted transition-colors hover:text-brand-foreground">
								{item.label}
							</a>
						</li>
					))}
				</ul>
			</div>

			<div>
				<h2 class="text-sm font-semibold uppercase tracking-wider text-brand-foreground">Contact</h2>
				<ul class="mt-4 space-y-2 text-sm text-brand-muted">
					<li>
						<a href={`mailto:${siteConfig.contact.email}`} class="transition-colors hover:text-brand-foreground">
							{siteConfig.contact.email}
						</a>
					</li>
					<li>
						<a href={`tel:${siteConfig.contact.phone}`} class="transition-colors hover:text-brand-foreground">
							{siteConfig.contact.phone}
						</a>
					</li>
				</ul>
			</div>
		</div>

		<div class="mt-12 flex flex-col gap-4 border-t border-brand-border/60 pt-8 text-xs text-brand-muted sm:flex-row sm:items-center sm:justify-between">
			<p>&copy; {year} {siteConfig.name}. All rights reserved.</p>
			<p>Built with Astro &amp; Tailwind CSS.</p>
		</div>
	</div>
</footer>
