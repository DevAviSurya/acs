---
import { industries } from '../../data/industries';

const loopItems = [...industries, ...industries];
---

<section class="overflow-hidden bg-brand-foreground py-20 sm:py-28">
	<div class="mx-auto max-w-7xl px-6 lg:px-8 text-center">
		<p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-bg/70 font-heading" data-reveal="up">Who we serve</p>
		<div class="mt-6 flex flex-col items-center gap-10 lg:gap-8">
			<h2 class="mt-3 text-3xl font-semibold tracking-tight text-brand-bg sm:text-4xl " data-reveal="text">
				Industries we work with
			</h2>
		</div>
	</div>

	<div class="industries-fade relative mt-12 mx-auto max-w-7xl overflow-hidden px-6 lg:px-8" data-reveal="up">
		<ul class="industries-track flex w-max gap-0" role="list" aria-label="Industries we work with">
			{loopItems.map((industry, index) => (
				<li
					class="flex w-[260px] shrink-0 flex-col gap-4 border-l border-brand-bg/15 px-6 py-2 text-left first:border-l-0 first:pl-0 sm:w-[300px] lg:w-[340px]"
					aria-hidden={index >= industries.length ? 'true' : undefined}
				>
					<span class="text-xs font-semibold text-brand-bg/30">0{(index % industries.length) + 1}</span>
					<industry.icon class="h-7 w-7 text-brand-bg/80" aria-hidden="true" stroke-width={1.5} />
					<h3 class="text-lg font-semibold text-brand-bg">{industry.label}</h3>
					<p class="text-sm leading-relaxed text-brand-bg/60">{industry.description}</p>
				</li>
			))}
		</ul>
	</div>
</section>

<style>
	.industries-fade {
		mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
		-webkit-mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
	}

	.industries-track {
		animation: industries-scroll 36s linear infinite;
	}

	.industries-track:hover {
		animation-play-state: paused;
	}

	@keyframes industries-scroll {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.industries-track {
			animation: none;
		}
	}
</style>
