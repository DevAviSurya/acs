---
import { industries } from '../../data/industries';
---

<section class="bg-brand-bg py-20 sm:py-28">
	<div class="mx-auto max-w-7xl px-6 lg:px-8 text-center">
		<p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-accent font-heading" data-reveal="up">Who we serve</p>
		<div class="mt-6 flex flex-col items-center gap-10 lg:gap-8">
			<h2 class="mt-3 text-3xl font-semibold tracking-tight text-brand-foreground sm:text-4xl " data-reveal="text">
				Industries we work with
			</h2>
		</div>

		<div
			class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-brand-border/70 bg-brand-border/70 sm:grid-cols-2 lg:grid-cols-4"
			data-reveal="stagger"
		>
			{industries.map((industry) => (
				<div class="flex flex-col gap-3 bg-brand-bg p-6">
					<industry.icon class="h-6 w-6 text-brand-accent" aria-hidden="true" stroke-width={1.75} />
					<h3 class="text-sm font-semibold text-brand-foreground">{industry.label}</h3>
					<p class="text-sm leading-relaxed text-brand-muted">{industry.description}</p>
				</div>
			))}
		</div>
	</div>
</section>
