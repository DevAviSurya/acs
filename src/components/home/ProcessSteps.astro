---
import Search from '@lucide/astro/icons/search';
import PenTool from '@lucide/astro/icons/pen-tool';
import Factory from '@lucide/astro/icons/factory';
import Truck from '@lucide/astro/icons/truck';

const steps = [
	{
		index: '01',
		icon: Search,
		title: 'Discovery & scope',
		description: 'We learn your goals, timelines, and constraints, then scope the right mix of services.',
	},
	{
		index: '02',
		icon: PenTool,
		title: 'Design & build',
		description: 'Our team designs and develops the deliverable — a website, AI workflow, or brand asset.',
	},
	{
		index: '03',
		icon: Factory,
		title: 'Production',
		description: 'Development, decoration, or manufacturing happens in-house or through partners we manage directly.',
	},
	{
		index: '04',
		icon: Truck,
		title: 'Delivery & support',
		description: 'We deliver to spec and stay on for ongoing support, maintenance, or reorders.',
	},
];
---

<section class="bg-brand-surface py-20 sm:py-28" data-animate>
	<div class="mx-auto max-w-7xl px-6 lg:px-8">
		<div class="max-w-2xl">
			<p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-accent">How we work</p>
			<h2 class="mt-3 text-3xl font-semibold tracking-tight text-brand-foreground sm:text-4xl">
				A straightforward process from brief to delivery
			</h2>
		</div>

		<ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
			{steps.map((step) => (
				<li class="rounded-2xl border border-brand-border/70 bg-brand-bg p-8">
					<span class="text-xs font-semibold tracking-[0.2em] text-brand-muted">{step.index}</span>
					<div class="mt-4 flex h-11 w-11 items-center justify-center rounded-xl bg-brand-accent/10 text-brand-accent">
						<step.icon class="h-5 w-5" aria-hidden="true" stroke-width={1.75} />
					</div>
					<h3 class="mt-5 text-base font-semibold text-brand-foreground">{step.title}</h3>
					<p class="mt-2 text-sm leading-relaxed text-brand-muted">{step.description}</p>
				</li>
			))}
		</ol>
	</div>
</section>
