---
import { serviceCategories, allServices } from '../../data/services';

const stats = [
	{ value: String(allServices.length), label: 'Disciplines under one roof' },
	{ value: String(serviceCategories.length), label: 'Connected solution groups' },
	{ value: '1', label: 'Point of contact, start to finish' },
];
---

<section class="bg-brand-bg py-20 sm:py-28" data-animate>
	<div class="mx-auto max-w-7xl px-6 lg:px-8">
		<div class="max-w-3xl">
			<p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-accent">Who we are</p>
			<h2 class="mt-3 text-3xl font-semibold tracking-tight text-brand-foreground sm:text-4xl">
				A single partner for the technology, marketing, and brand work behind your business.
			</h2>
			<p class="mt-5 text-base leading-relaxed text-brand-muted">
				Attribute Corporate Solutions brings your website, AI tools, SEO, marketing, design, and merchandise
				together under one team — so growing businesses can move faster without managing a dozen vendors.
			</p>
		</div>

		<dl class="mt-14 grid gap-10 border-t border-brand-border/70 pt-10 sm:grid-cols-3">
			{stats.map((stat) => (
				<div>
					<dt class="text-5xl font-semibold tracking-tight text-brand-foreground sm:text-6xl">{stat.value}</dt>
					<dd class="mt-2 text-sm leading-relaxed text-brand-muted">{stat.label}</dd>
				</div>
			))}
		</dl>
	</div>
</section>
