---
const credentials = [
	{ label: 'One partner', detail: 'Six disciplines handled under a single point of contact.' },
	{ label: 'In-house production', detail: 'Design, development, and print production kept under one roof.' },
	{ label: 'Built for business', detail: 'Processes shaped around deadlines, approvals, and procurement.' },
];
---

<section class="bg-brand-bg py-20 sm:py-28" data-animate>
	<div class="mx-auto max-w-7xl px-6 lg:px-8">
		<div class="max-w-3xl">
			<p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-accent">Who we are</p>
			<h2 class="mt-3 text-3xl font-semibold tracking-tight text-brand-foreground sm:text-4xl">
				A single partner for the technology, creative, and physical work behind your brand.
			</h2>
			<p class="mt-5 text-base leading-relaxed text-brand-muted">
				Attribute Corporate Solutions brings software development, IT support, merchandise, design, print, and
				packaging together under one team — so growing businesses can move faster without managing a dozen
				vendors.
			</p>
		</div>

		<dl class="mt-14 grid gap-10 border-t border-brand-border/70 pt-10 sm:grid-cols-3">
			{credentials.map((item) => (
				<div>
					<dt class="text-base font-semibold text-brand-foreground">{item.label}</dt>
					<dd class="mt-2 text-sm leading-relaxed text-brand-muted">{item.detail}</dd>
				</div>
			))}
		</dl>
	</div>
</section>
