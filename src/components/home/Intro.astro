---
import { serviceCategories, allServices } from '../../data/services';
import { industries } from '../../data/industries';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';

const stats: { value: number; suffix?: string; title: string; description: string }[] = [
	{ value: 10, suffix: '+', title: 'Clients', description: 'Clients served' },
	{ value: 20, suffix: '+', title: 'Projects', description: 'Projects delivered' },
	{ value: industries.length, title: 'Verticals', description: 'Industry verticals' },
	{ value: allServices.length, title: 'Disciplines', description: 'Disciplines under one roof' },
	{ value: serviceCategories.length, title: 'Solutions', description: 'Connected solution groups' },
	{ value: 1, title: 'Contact', description: 'Point of contact, start to finish' },
];
---

<section class="bg-brand-bg py-20 sm:py-28">
	<div class="mx-auto max-w-7xl px-6 lg:px-8 text-center">
		<p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-accent font-heading" data-reveal="up">Who we are</p>

		<div class="mt-6 flex flex-col items-center gap-10 lg:gap-8">
			<h2
				class="text-3xl font-semibold tracking-tight text-brand-foreground sm:text-4xl lg:text-5xl"
				data-reveal="text"
			>
				Six disciplines, one point of contact
			</h2>

			<div>
				<p class="mx-auto max-w-3xl text-base leading-relaxed text-brand-accent" data-reveal="up">
					— so growing businesses can move faster 
				without managing a dozen separate vendors.
				We bring the website, AI, marketing, design, and merchandise behind your business under one accountable team.
					
				</p>

				<a
					href="/about"
					class="group mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-foreground"
					data-reveal="up"
				>
					Learn more about us
					<ArrowUpRight
						class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
						aria-hidden="true"
						stroke-width={2}
					/>
				</a>

				<ul class="mt-8 flex flex-wrap gap-2 justify-center gap-2" data-reveal="stagger">
					{allServices.map((service) => (
						<li class="flex items-center gap-1.5 rounded-full border border-brand-border/70 px-3 py-1.5 text-xs font-medium text-brand-accent">
							<service.icon class="h-3.5 w-3.5 text-brand-accent" aria-hidden="true" stroke-width={1.75} />
							{service.tag}
						</li>
					))}
				</ul>
			</div>
		</div>

		<div
			class="mt-16 grid grid-cols-6 gap-px overflow-hidden bg-brand-border/70"
			data-reveal="stagger"
		>
			{stats.map((stat) => (
				<div class="flex flex-col items-center gap-1.5 bg-brand-bg px-1.5 py-6 text-center transition-colors duration-300 sm:gap-2 sm:px-3 sm:py-8">
					<span class="text-[9px] font-semibold uppercase tracking-[0.1em] text-brand-accent sm:text-[10px] md:text-xs">
						{stat.title}
					</span>
					<p class="text-2xl font-semibold tracking-tight text-brand-foreground sm:text-3xl md:text-4xl lg:text-5xl">
						<span data-stat-value={stat.value}>{stat.value}</span>
						{stat.suffix && <span class="text-[0.6em] align-top">{stat.suffix}</span>}
					</p>
					<p class="text-[9px] leading-snug text-brand-muted sm:text-[10px] md:text-xs">{stat.description}</p>
				</div>
			))}
		</div>
	</div>
</section>

<script>
	const statEls = document.querySelectorAll<HTMLElement>('[data-stat-value]');
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	const animateValue = (el: HTMLElement, target: number) => {
		const duration = 900;
		const startTime = performance.now();
		const tick = (now: number) => {
			const t = Math.min(1, (now - startTime) / duration);
			const eased = 1 - (1 - t) ** 3;
			el.textContent = Math.round(target * eased).toLocaleString('en-US');
			if (t < 1) window.requestAnimationFrame(tick);
		};
		window.requestAnimationFrame(tick);
	};

	if (!prefersReducedMotion && 'IntersectionObserver' in window) {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					const el = entry.target as HTMLElement;
					const target = Number(el.dataset.statValue ?? el.textContent ?? '0');
					el.textContent = '0';
					animateValue(el, target);
					observer.unobserve(el);
				}
			},
			{ threshold: 0.4 },
		);
		for (const el of statEls) observer.observe(el);
	}
</script>
