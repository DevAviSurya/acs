---
import type { ServiceCategory } from '../../data/services';

interface Props {
	category: ServiceCategory;
	tint?: 'base' | 'surface';
}

const { category, tint = 'base' } = Astro.props;
const sectionBg = tint === 'surface' ? 'bg-brand-surface' : 'bg-brand-bg';
const cardBg = tint === 'surface' ? 'bg-brand-bg' : 'bg-brand-surface';
---

<section id={category.id} class={`${sectionBg} py-20 sm:py-28`} data-animate>
	<div class="mx-auto max-w-7xl px-6 lg:px-8">
		<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
			<div class="max-w-2xl">
				<p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-accent">{category.label}</p>
				<h2 class="mt-3 text-3xl font-semibold tracking-tight text-brand-foreground sm:text-4xl">{category.title}</h2>
				<p class="mt-4 text-base leading-relaxed text-brand-muted">{category.description}</p>
			</div>
			<a
				href="/services"
				class="shrink-0 text-sm font-semibold text-brand-foreground underline-offset-4 hover:underline"
			>
				View all services →
			</a>
		</div>

		<div class="mt-12 grid gap-6 sm:grid-cols-2">
			{category.services.map((service) => (
				<div class={`group rounded-2xl border border-brand-border/70 p-8 transition-colors hover:border-brand-accent/50 ${cardBg}`}>
					<div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-accent/10 text-brand-accent">
						<service.icon class="h-6 w-6" aria-hidden="true" stroke-width={1.75} />
					</div>
					<h3 class="mt-6 text-xl font-semibold text-brand-foreground">{service.title}</h3>
					<p class="mt-3 text-sm leading-relaxed text-brand-muted">{service.summary}</p>
					<ul class="mt-5 space-y-2">
						{service.points.map((point) => (
							<li class="flex items-start gap-2 text-sm text-brand-muted">
								<span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-accent"></span>
								<span>{point}</span>
							</li>
						))}
					</ul>
				</div>
			))}
		</div>
	</div>
</section>
