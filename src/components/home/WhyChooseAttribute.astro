---
import Users from '@lucide/astro/icons/users';
import Zap from '@lucide/astro/icons/zap';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import MapPin from '@lucide/astro/icons/map-pin';
import Check from '@lucide/astro/icons/check';
import X from '@lucide/astro/icons/x';

const reasons = [
	{
		icon: Users,
		title: 'One point of contact',
		description: 'A single team coordinates every discipline, so you are never passed between vendors.',
	},
	{
		icon: Zap,
		title: 'Responsive by default',
		description: 'Clear timelines and direct communication from first brief to final delivery.',
	},
	{
		icon: ShieldCheck,
		title: 'Consistent quality',
		description: 'The same standards applied whether the deliverable is code, artwork, or a finished product.',
	},
	{
		icon: MapPin,
		title: 'Local, accountable support',
		description: 'A team you can reach directly, with ongoing support after the project ships.',
	},
];

const comparison = [
	{ row: 'Point of contact', vendors: 'A different one for each discipline', attribute: 'One team, start to finish' },
	{ row: 'Timelines', vendors: 'Coordinated manually, across calendars', attribute: 'Managed under a single plan' },
	{ row: 'Quality & brand consistency', vendors: 'Varies by vendor', attribute: 'Held to one standard throughout' },
	{ row: 'Procurement overhead', vendors: 'Separate contracts & invoices', attribute: 'One relationship to manage' },
];
---

<section class="bg-brand-surface py-20 sm:py-28">
	<div class="mx-auto max-w-7xl px-6 lg:px-8">
		<div class="max-w-2xl">
			<p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-accent" data-reveal="up">Why Attribute</p>
			<h2 class="mt-3 text-3xl font-semibold tracking-tight text-brand-foreground sm:text-4xl" data-reveal="text">
				Built to be the only call you need to make
			</h2>
		</div>

		<div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4" data-reveal="stagger">
			{reasons.map((reason) => (
				<div>
					<div class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-accent/10 text-brand-accent">
						<reason.icon class="h-5 w-5" aria-hidden="true" stroke-width={1.75} />
					</div>
					<h3 class="mt-5 text-base font-semibold text-brand-foreground">{reason.title}</h3>
					<p class="mt-2 text-sm leading-relaxed text-brand-muted">{reason.description}</p>
				</div>
			))}
		</div>

		<div class="mt-16 overflow-hidden rounded-2xl border border-brand-border/70 bg-brand-bg" data-reveal="up">
			<div class="grid grid-cols-[1.3fr_1fr_1fr] border-b border-brand-border/70 bg-brand-surface text-xs font-semibold uppercase tracking-wider text-brand-muted">
				<div class="px-5 py-4 sm:px-6">Working with</div>
				<div class="px-5 py-4 sm:px-6">Multiple vendors</div>
				<div class="px-5 py-4 text-brand-foreground sm:px-6">Attribute</div>
			</div>
			{comparison.map((item) => (
				<div class="grid grid-cols-[1.3fr_1fr_1fr] border-b border-brand-border/50 text-sm last:border-b-0">
					<div class="px-5 py-4 font-medium text-brand-foreground sm:px-6">{item.row}</div>
					<div class="flex items-start gap-2 px-5 py-4 text-brand-muted sm:px-6">
						<X class="mt-0.5 h-4 w-4 shrink-0 text-brand-muted/70" aria-hidden="true" stroke-width={2} />
						<span>{item.vendors}</span>
					</div>
					<div class="flex items-start gap-2 px-5 py-4 text-brand-foreground sm:px-6">
						<Check class="mt-0.5 h-4 w-4 shrink-0 text-brand-accent" aria-hidden="true" stroke-width={2} />
						<span>{item.attribute}</span>
					</div>
				</div>
			))}
		</div>
	</div>
</section>
