---
import { allServices } from '../../data/services';
import { siteConfig } from '../../config/site';

const websiteService = allServices.find((service) => service.slug === 'website');
const websiteCodeLines = websiteService
	? [
			'const Services = {',
			`  name: "${websiteService.title}",`,
			`  summary: "${websiteService.summary}",`,
			'  features: [',
			...websiteService.points.map((point) => `    "${point}",`),
			'  ],',
			'};',
		]
	: [];

const aiService = allServices.find((service) => service.slug === 'ai-integration');
const aiQaPairs = [
	{ question: 'What is AI integration?', answer: aiService?.summary ?? '' },
	{
		question: 'What is AEO?',
		answer: 'Answer Engine Optimization — getting your content surfaced in AI answers like ChatGPT, not just search results.',
	},
	{
		question: 'What services do you offer?',
		answer: `${allServices.map((service) => service.title).join(', ')}.`,
	},
];

const siteDomain = siteConfig.url.replace(/^https?:\/\//, '');
const merchService = allServices.find((service) => service.slug === 'corporate-merchandising');
const marketingService = allServices.find((service) => service.slug === 'digital-marketing');

const seoQueries = [
	{
		query: 'custom website design company',
		service: websiteService,
		overview: `Attribute Corporate Solutions — ${websiteService?.summary ?? ''}`,
	},
	{
		query: 'corporate merchandise supplier',
		service: merchService,
		overview: `Attribute Corporate Solutions — ${merchService?.summary ?? ''}`,
	},
	{
		query: 'digital marketing agency for small business',
		service: marketingService,
		overview: `Attribute Corporate Solutions — ${marketingService?.summary ?? ''}`,
	},
].map(({ query, service, overview }) => ({
	query,
	overview,
	title: `Attribute Corporate Solutions — ${service?.title ?? ''}`,
	snippet: service?.summary ?? '',
}));

// Illustrative campaign stats — like FeaturedProjects' placeholder work,
// kept clearly in-house marketing copy rather than real client numbers.
const adCampaigns = [
	{
		name: 'Social Awareness Campaign',
		stats: [
			{ label: 'Impressions', value: 128400, change: '+18%' },
			{ label: 'Clicks', value: 3210, change: '+9%' },
			{ label: 'CTR', value: 2.5, suffix: '%', change: '+4%' },
			{ label: 'Conversions', value: 184, change: '+22%' },
		],
	},
	{
		name: 'Search & Display Campaign',
		stats: [
			{ label: 'Impressions', value: 96750, change: '+11%' },
			{ label: 'Clicks', value: 4980, change: '+15%' },
			{ label: 'CTR', value: 5.1, suffix: '%', change: '+6%' },
			{ label: 'Conversions', value: 312, change: '+27%' },
		],
	},
	{
		name: 'Email + Retargeting',
		stats: [
			{ label: 'Impressions', value: 54200, change: '+7%' },
			{ label: 'Clicks', value: 2340, change: '+12%' },
			{ label: 'CTR', value: 4.3, suffix: '%', change: '+5%' },
			{ label: 'Conversions', value: 201, change: '+19%' },
		],
	},
];

// Two palette directions the "design canvas" cycles through while hovered.
const brandPalettes = [
	{ name: 'Warm identity', colors: ['#201e1b', '#d97757', '#f2c87b', '#f5f5f2'] },
	{ name: 'Cool identity', colors: ['#1f2937', '#3b55d9', '#7dd3c0', '#f3f4f6'] },
];

const servicePanels: Record<string, 'website' | 'ai' | 'seo' | 'marketing' | 'design' | 'merch'> = {
	website: 'website',
	'ai-integration': 'ai',
	'seo-aeo': 'seo',
	'digital-marketing': 'marketing',
	'graphic-design-printing': 'design',
	'corporate-merchandising': 'merch',
};
---

<section id="services" class="bg-brand-bg py-20 sm:py-28" data-animate>
	<div class="mx-auto max-w-7xl px-6 lg:px-8">
		<div class="max-w-2xl">
			<p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-accent">What we do</p>
			<h2 class="mt-3 text-3xl font-semibold tracking-tight text-brand-foreground sm:text-4xl">
				Six services, one accountable partner
			</h2>
			<p class="mt-4 text-base leading-relaxed text-brand-muted">
				From the website and AI tools you run on to the marketing, design, and merchandise your customers
				see — we cover it end to end, so you're not managing six different vendors.
			</p>
		</div>

		<div class="service-grid mt-12 overflow-hidden rounded-2xl border border-brand-border">
			{allServices.map((service) => (
				<a
					href="/contact"
					class="service-cell group"
					data-service-panel={servicePanels[service.slug]}
				>
					<span class="service-tag">{service.tag}</span>
					<span class="service-arrow" aria-hidden="true"></span>
					<span class="service-title">{service.title}</span>
					<span class="service-blurb">{service.blurb}</span>

					{service.slug === 'website' && (
						<div class="service-code" aria-hidden="true">
							<div class="service-code-bar">
								<span class="service-code-dot"></span>
								<span class="service-code-dot"></span>
								<span class="service-code-dot"></span>
								<span class="service-code-filename">website.ts</span>
							</div>
							<div class="service-code-body">
								{websiteCodeLines.map((line, index) => (
									<div class="service-code-line">
										<span class="service-code-ln">{index + 1}</span>
										<span class="service-code-text" data-full={line}></span>
									</div>
								))}
								<span class="service-code-cursor"></span>
							</div>
						</div>
					)}

					{service.slug === 'ai-integration' && (
						<div class="service-code service-code--chat" aria-hidden="true" data-qa={JSON.stringify(aiQaPairs)}>
							<div class="service-chat-bar">
								<span class="service-chat-badge">AI</span>
								<span class="service-chat-title">AI Assistant</span>
							</div>
							<div class="service-chat-body" data-chat-log></div>
							<div class="service-chat-composer">
								<span class="service-chat-composer-field" data-composer-field></span>
								<span class="service-chat-composer-send" data-composer-send>↑</span>
							</div>
						</div>
					)}

					{service.slug === 'seo-aeo' && (
						<div class="service-code service-code--search" aria-hidden="true" data-queries={JSON.stringify(seoQueries)} data-domain={siteDomain}>
							<div class="service-search-bar">
								<span class="service-search-dot"></span>
								<span class="service-search-dot"></span>
								<span class="service-search-dot"></span>
								<span class="service-search-title">Search</span>
							</div>
							<div class="service-search-box">
								<svg class="service-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="11" cy="11" r="7"></circle>
									<path d="m21 21-4.3-4.3"></path>
								</svg>
								<span class="service-search-field" data-search-field></span>
							</div>
							<div class="service-search-results" data-search-results></div>
						</div>
					)}

					{service.slug === 'digital-marketing' && (
						<div class="service-code service-code--dash" aria-hidden="true" data-campaigns={JSON.stringify(adCampaigns)}>
							<div class="service-dash-bar">
								<span class="service-dash-dot"></span>
								<span class="service-dash-dot"></span>
								<span class="service-dash-dot"></span>
								<span class="service-dash-title">Campaign Manager</span>
							</div>
							<div class="service-dash-body" data-dash-body></div>
						</div>
					)}

					{service.slug === 'graphic-design-printing' && (
						<div class="service-code service-code--design" aria-hidden="true" data-palettes={JSON.stringify(brandPalettes)}>
							<div class="service-design-bar">
								<span class="service-design-dot"></span>
								<span class="service-design-dot"></span>
								<span class="service-design-dot"></span>
								<span class="service-design-title">Brand Design</span>
							</div>
							<div class="service-design-toolbar" data-design-toolbar>
								<span class="service-design-tool" data-tool>
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3l8 18 2-7 7-2z"></path></svg>
								</span>
								<span class="service-design-tool" data-tool>
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="20" x2="16" y2="8"></line><circle cx="18" cy="6" r="2"></circle></svg>
								</span>
								<span class="service-design-tool" data-tool>
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"></rect></svg>
								</span>
								<span class="service-design-tool" data-tool>
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="6" x2="19" y2="6"></line><line x1="12" y1="6" x2="12" y2="18"></line></svg>
								</span>
							</div>
							<div class="service-design-canvas">
								<div class="service-design-mark" data-design-mark>
									<span class="service-design-mark-shape service-design-mark-a"></span>
									<span class="service-design-mark-shape service-design-mark-b"></span>
								</div>
								<div class="service-design-swatches" data-design-swatches></div>
								<div class="service-design-label" data-design-label></div>
							</div>
						</div>
					)}

					{service.slug === 'corporate-merchandising' && (
						<div class="service-code service-code--merch" aria-hidden="true">
							<div class="service-merch-bar">
								<span class="service-merch-dot"></span>
								<span class="service-merch-dot"></span>
								<span class="service-merch-dot"></span>
								<span class="service-merch-title">Product Catalog</span>
							</div>
							<div class="service-merch-canvas">
								<div class="service-merch-item service-merch-item--mug">
									<span class="service-merch-sparkle service-merch-sparkle-a"></span>
									<span class="service-merch-float service-merch-float--mug">
										<span class="service-merch-steam service-merch-steam-a"></span>
										<span class="service-merch-steam service-merch-steam-b"></span>
										<span class="service-merch-steam service-merch-steam-c"></span>
										<canvas class="service-merch-icon-canvas" data-merch-icon="mug"></canvas>
									</span>
									<span class="service-merch-label">Mug</span>
								</div>
								<div class="service-merch-item service-merch-item--bottle">
									<span class="service-merch-sparkle service-merch-sparkle-b"></span>
									<span class="service-merch-float service-merch-float--bottle">
										<canvas class="service-merch-icon-canvas" data-merch-icon="bottle"></canvas>
									</span>
									<span class="service-merch-label">Bottle</span>
								</div>
								<div class="service-merch-item service-merch-item--shirt">
									<span class="service-merch-sparkle service-merch-sparkle-c"></span>
									<span class="service-merch-float service-merch-float--shirt">
										<canvas class="service-merch-icon-canvas" data-merch-icon="shirt"></canvas>
									</span>
									<span class="service-merch-label">Tee</span>
								</div>
							</div>
						</div>
					)}
				</a>
			))}
		</div>
	</div>
</section>

<style>
	.service-grid {
		display: grid;
		grid-template-columns: 1fr;
		background-color: var(--color-brand-surface);
	}

	@media (min-width: 640px) {
		.service-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.service-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.service-cell {
		position: relative;
		display: flex;
		min-height: 220px;
		flex-direction: column;
		justify-content: flex-end;
		gap: 0.5rem;
		padding: 2rem 2rem 2.125rem;
		/* Every cell draws its own full border, pulled over its top/left
		   neighbour by 1px, so adjacent borders overlap into single lines. */
		border: 1px solid var(--color-brand-border);
		margin: -1px 0 0 -1px;
		transition: background-color 0.3s ease;
	}

	.service-cell:hover {
		background-color: var(--color-brand-bg);
	}

	.service-tag {
		position: absolute;
		top: 1.75rem;
		left: 2rem;
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-brand-muted);
	}

	.service-arrow {
		position: absolute;
		top: 1.375rem;
		right: 1.375rem;
		width: 2.375rem;
		height: 2.375rem;
		border-radius: 50%;
		border: 1px solid var(--color-brand-border);
		transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), background-color 0.3s ease, border-color 0.3s ease;
	}

	.service-arrow::before {
		content: '';
		position: absolute;
		inset: 0;
		margin: auto;
		width: 9px;
		height: 9px;
		border-top: 1.6px solid var(--color-brand-foreground);
		border-right: 1.6px solid var(--color-brand-foreground);
		transform: translate(-1px, 1px);
		transition: border-color 0.3s ease;
	}

	.service-cell:hover .service-arrow {
		background-color: var(--color-brand-accent);
		border-color: var(--color-brand-accent);
		transform: rotate(45deg);
	}

	.service-cell:hover .service-arrow::before {
		border-color: var(--color-brand-accent-foreground);
	}

	.service-title {
		font-size: clamp(1.125rem, 1.4vw, 1.375rem);
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.2;
		color: var(--color-brand-foreground);
	}

	.service-blurb {
		font-size: 0.875rem;
		line-height: 1.5;
		color: var(--color-brand-muted);
	}

	@media (prefers-reduced-motion: reduce) {
		.service-arrow,
		.service-arrow::before {
			transition: none;
		}
	}

	.service-code {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 5;
		display: flex;
		flex-direction: column;
		background: #0b0b0c;
		opacity: 0;
		pointer-events: none;
		box-shadow: 0 0 0 0 rgba(0, 0, 0, 0);
		/* Grows past the Website cell's own bounds on hover (see below) and
		   overlays the neighbouring cells on top, instead of resizing the
		   grid track and pushing them aside. */
		transition:
			width 0.5s cubic-bezier(0.22, 1, 0.36, 1),
			height 0.5s cubic-bezier(0.22, 1, 0.36, 1),
			opacity 0.3s ease,
			box-shadow 0.45s ease;
	}

	.service-cell:hover .service-code,
	.service-cell:focus-visible .service-code {
		opacity: 1;
		/* Absorb pointer events while visible so hovering the enlarged
		   preview can't click through to the tiles it's covering — the
		   click handler in the script below also cancels any navigation. */
		pointer-events: auto;
		box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.45);
	}

	/* Desktop (3 columns x 2 rows): row 1 is Website / AI / SEO & AEO, row 2
	   is Digital Marketing / Graphic Design & Printing / Merchandising.
	   Row-1 panels have room below them and grow down; row-2 panels have
	   no row below, so they anchor from the bottom and grow up instead.
	   Column-wise, the last column (SEO & AEO, Merchandising) has no room
	   to its right, so those two anchor from the right and grow left —
	   Merchandising needs both flips at once, being last row AND column. */
	@media (min-width: 1024px) {
		.service-cell[data-service-panel="seo"] .service-code,
		.service-cell[data-service-panel="merch"] .service-code {
			left: auto;
			right: 0;
		}

		.service-cell[data-service-panel="marketing"] .service-code,
		.service-cell[data-service-panel="design"] .service-code,
		.service-cell[data-service-panel="merch"] .service-code {
			top: auto;
			bottom: 0;
		}

		.service-cell[data-service-panel]:hover .service-code,
		.service-cell[data-service-panel]:focus-visible .service-code {
			width: 200%;
			height: 200%;
		}
	}

	/* Tablet (2 columns x 3 rows): the pairing reflows to row 1 = Website /
	   AI, row 2 = SEO & AEO / Digital Marketing, row 3 = Graphic Design &
	   Printing / Merchandising. AI and Digital Marketing both land in the
	   last column here, so they anchor right and grow left. Graphic
	   Design & Printing and Merchandising land in the last row, so they
	   anchor from the bottom and grow up — Merchandising needs both flips
	   at once, being last row AND column. */
	@media (min-width: 640px) and (max-width: 1023px) {
		.service-cell[data-service-panel="ai"] .service-code,
		.service-cell[data-service-panel="marketing"] .service-code,
		.service-cell[data-service-panel="merch"] .service-code {
			left: auto;
			right: 0;
		}

		.service-cell[data-service-panel="design"] .service-code,
		.service-cell[data-service-panel="merch"] .service-code {
			top: auto;
			bottom: 0;
		}

		.service-cell[data-service-panel]:hover .service-code,
		.service-cell[data-service-panel]:focus-visible .service-code {
			width: 200%;
			height: 200%;
		}
	}

	/* Mobile (1 column): no horizontal room to grow into, so only the
	   height doubles. Merchandising is the last tile in the stack, so it
	   anchors from the bottom and grows up instead of off the page. */
	@media (max-width: 639px) {
		.service-cell[data-service-panel="merch"] .service-code {
			top: auto;
			bottom: 0;
		}

		.service-cell[data-service-panel]:hover .service-code,
		.service-cell[data-service-panel]:focus-visible .service-code {
			height: 200%;
		}
	}

	.service-cell[data-service-panel]:hover .service-code-body,
	.service-cell[data-service-panel]:focus-visible .service-code-body {
		font-size: 1rem;
	}

	.service-cell[data-service-panel]:hover .service-chat-body,
	.service-cell[data-service-panel]:focus-visible .service-chat-body {
		font-size: 0.8125rem;
	}

	.service-cell[data-service-panel]:hover .service-search-results,
	.service-cell[data-service-panel]:focus-visible .service-search-results {
		font-size: 0.8125rem;
	}

	.service-cell[data-service-panel]:hover .service-dash-body,
	.service-cell[data-service-panel]:focus-visible .service-dash-body {
		font-size: 0.8125rem;
	}

	.service-code-bar {
		display: flex;
		flex: none;
		align-items: center;
		gap: 0.35rem;
		padding: 0.65rem 0.9rem;
		background: #161617;
	}

	.service-code-dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: #4a4a4b;
	}

	.service-code-filename {
		margin-left: 0.5rem;
		font-family: ui-monospace, "SF Mono", Menlo, monospace;
		font-size: 0.6875rem;
		color: #9a9a9a;
	}

	.service-code-body {
		flex: 1;
		overflow: hidden;
		padding: 0.9rem 1rem;
		font-family: ui-monospace, "SF Mono", Menlo, monospace;
		font-size: 0.6875rem;
		line-height: 1.6;
		transition: font-size 0.5s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.service-code-line {
		/* Padding (not flex) reserves room for the line number, so a
		   wrapped continuation line indents to the text's own start
		   instead of falling back under the line-number gutter. */
		position: relative;
		padding-left: 2.35em;
		white-space: pre-wrap;
		word-break: break-word;
	}

	.service-code-ln {
		position: absolute;
		top: 0;
		left: 0;
		width: 1.6em;
		color: #58585a;
		text-align: right;
	}

	.service-code-text {
		color: #e2e2e3;
	}

	.service-code-cursor {
		display: inline-block;
		width: 0.4rem;
		height: 0.8em;
		margin-left: 1.85rem;
		background: #fff;
		animation: service-code-blink 1s steps(1, jump-none) infinite;
	}

	@media (prefers-reduced-motion: reduce) {
		.service-code,
		.service-code-body,
		.service-chat-body {
			transition: none;
		}

		.service-code-cursor {
			animation: none;
		}
	}

	@keyframes service-code-blink {
		50% {
			opacity: 0;
		}
	}

	/* A ChatGPT-style AI assistant window: light theme, chat bubbles,
	   instead of the dark VS Code look used for the Website panel. */
	.service-code--chat {
		background: #ffffff;
	}

	.service-chat-bar {
		display: flex;
		flex: none;
		align-items: center;
		gap: 0.5rem;
		padding: 0.65rem 0.9rem;
		border-bottom: 1px solid #ececec;
		background: #f7f7f8;
	}

	.service-chat-badge {
		display: flex;
		flex: none;
		align-items: center;
		justify-content: center;
		width: 1.3rem;
		height: 1.3rem;
		border-radius: 50%;
		background: #0f0f0f;
		color: #fff;
		font-size: 0.6rem;
		font-weight: 700;
		letter-spacing: 0.02em;
	}

	.service-chat-title {
		font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
		font-size: 0.75rem;
		font-weight: 600;
		color: #3d3d3d;
	}

	.service-chat-body {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		/* Grows into a scrolling transcript as turns accumulate, auto-
		   scrolled to the newest message by the script below — like a
		   real chat/session log rather than one line replacing another. */
		overflow-y: auto;
		overflow-x: hidden;
		scrollbar-width: none;
		padding: 0.95rem 1rem;
		background: #f7f7f8;
		font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
		font-size: 0.6875rem;
		line-height: 1.5;
