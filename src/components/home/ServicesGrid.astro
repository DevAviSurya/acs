		color: #3c6b3f;
	}

	:global(.service-search-result-title) {
		color: #3454d1;
		font-weight: 500;
		white-space: pre-wrap;
		word-break: break-word;
	}

	:global(.service-search-snippet) {
		color: #5c5c5c;
		white-space: pre-wrap;
		word-break: break-word;
	}

	@media (prefers-reduced-motion: reduce) {
		:global(.service-search-group),
		:global(.service-search-organic) {
			animation: none;
		}
	}

	/* Dashboard content is also created at runtime by the script — same
	   :global() requirement as the chat/search content above. */
	:global(.service-dash-group) {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		animation: service-chat-rise 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	:global(.service-dash-name) {
		font-weight: 600;
		color: #1f1f1f;
	}

	:global(.service-dash-grid) {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.6rem;
	}

	:global(.service-dash-tile) {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding: 0.55rem 0.65rem;
		border-radius: 0.6rem;
		background: #f7f7f8;
	}

	:global(.service-dash-label) {
		font-size: 0.625rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: #9a9a9a;
	}

	:global(.service-dash-value) {
		font-size: 1.05em;
		font-weight: 700;
		color: #1f1f1f;
	}

	:global(.service-dash-change) {
		font-size: 0.625rem;
		font-weight: 600;
		color: #1a9e5c;
	}

	@media (prefers-reduced-motion: reduce) {
		:global(.service-dash-group) {
			animation: none;
		}
	}

	/* Design swatches are also created at runtime by the script. */
	:global(.service-design-swatch) {
		width: 1.15rem;
		height: 1.15rem;
		border-radius: 50%;
		border: 1px solid rgba(0, 0, 0, 0.08);
		transform: scale(0);
		opacity: 0;
		animation: service-design-swatch-in 0.35s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	@media (prefers-reduced-motion: reduce) {
		:global(.service-design-swatch) {
			animation: none;
			transform: none;
			opacity: 1;
		}
	}

	@keyframes service-design-swatch-in {
		to {
			transform: scale(1);
			opacity: 1;
		}
	}
</style>

<script>
	const hosts = document.querySelectorAll<HTMLElement>('[data-service-panel]');
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	// Variable per-character delay plus extra pauses at line breaks and
	// punctuation, so the typing reads like an actual person typing rather
	// than a steady machine-paced reveal.
	const minDelay = 32;
	const maxDelay = 80;
	const lineBreakPause = 260;
	const punctuationPause = 110;
	const hesitationChance = 0.04;
	const hesitationPause = 200;

	for (const host of hosts) {
		const codeOverlay = host.querySelector<HTMLElement>('.service-code');
		// The overlay sits inside the <a>; swallow clicks on it while it's
		// visible so the enlarged preview can't be clicked through to
		// navigate, or to activate whichever tile it happens to be covering.
		codeOverlay?.addEventListener('click', (event) => {
			event.preventDefault();
			event.stopPropagation();
		});

		const lineEls = Array.from(host.querySelectorAll<HTMLElement>('.service-code-text'));
		const lines = lineEls.map((el) => el.dataset.full ?? '');
		const fullText = lines.join('\n');

		let typed = 0;
		let timer: number | undefined;

		const paint = () => {
			const visible = fullText.slice(0, typed).split('\n');
			lineEls.forEach((el, index) => {
				el.textContent = visible[index] ?? '';
			});
		};

		const stop = () => {
			if (timer !== undefined) {
				window.clearTimeout(timer);
				timer = undefined;
			}
		};

		const step = () => {
			if (typed >= fullText.length) return;
			const char = fullText[typed];
			typed += 1;
			paint();

			let delay = minDelay + Math.random() * (maxDelay - minDelay);
			if (char === '\n') delay += lineBreakPause;
			else if (',;{}[]'.includes(char)) delay += punctuationPause;
			if (typed < fullText.length && Math.random() < hesitationChance) delay += hesitationPause;

			timer = window.setTimeout(step, delay);
		};

		const start = () => {
			stop();
			if (prefersReducedMotion) {
				typed = fullText.length;
				paint();
				return;
			}
			// Resume from wherever typing left off rather than restarting,
			// so mousing out and back in continues the same pass.
			if (typed < fullText.length) timer = window.setTimeout(step, minDelay);
		};

		const pause = () => {
			stop();
		};

		host.addEventListener('mouseenter', start);
		host.addEventListener('mouseleave', pause);
		host.addEventListener('focus', start);
		host.addEventListener('blur', pause);
	}

	// AI chat panel: builds up a scrolling transcript, one turn at a time —
	// types a question, pauses with a "typing…" indicator, streams in the
	// answer, then appends the next turn below it (like a real chat/coding
	// session log) and auto-scrolls to keep the newest turn in view.
	const chatHosts = document.querySelectorAll<HTMLElement>('[data-service-panel="ai"]');
	const thinkPause = 550;
	const turnPause = 1100;
	const maxTurns = 4;

	interface QaPair {
		question: string;
		answer: string;
	}

	interface ChatTurn {
		userBubble: HTMLElement;
		typing: HTMLElement;
		assistantBubble: HTMLElement;
		actions: HTMLElement;
	}

	// Minimal lucide-style icon paths (copy / thumbs up / thumbs down /
	// regenerate) for the row ChatGPT and Gemini both show under a
	// finished reply — the detail that most says "this is an AI chat app".
	const chatActionIcons: Record<string, string> = {
		copy: '<path d="M9 9h11a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2v-9a2 2 0 0 1 2-2Z"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>',
		up: '<path d="M7 10v12"/><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"/>',
		down: '<path d="M17 14V2"/><path d="M9 18.12 10 14H4.17a2 2 0 0 1-1.92-2.56l2.33-8A2 2 0 0 1 6.5 2H20a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-2.76a2 2 0 0 0-1.79 1.11L12 22a3.13 3.13 0 0 1-3-3.88Z"/>',
		redo: '<path d="M3 12a9 9 0 1 0 2.64-6.36L3 8"/><path d="M3 3v5h5"/>',
	};

	const createChatActions = (): HTMLElement => {
		const row = document.createElement('div');
		row.className = 'service-chat-actions';
		row.hidden = true;
		for (const name of ['copy', 'up', 'down', 'redo']) {
			const button = document.createElement('span');
			button.className = 'service-chat-action';
			const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
			svg.setAttribute('viewBox', '0 0 24 24');
			svg.setAttribute('fill', 'none');
			svg.setAttribute('stroke', 'currentColor');
			svg.setAttribute('stroke-width', '2');
			svg.setAttribute('stroke-linecap', 'round');
			svg.setAttribute('stroke-linejoin', 'round');
			svg.innerHTML = chatActionIcons[name];
			button.append(svg);
			row.append(button);
		}
		return row;
	};

	for (const host of chatHosts) {
		const panel = host.querySelector<HTMLElement>('.service-code--chat');
		const log = host.querySelector<HTMLElement>('[data-chat-log]');
		const composerField = host.querySelector<HTMLElement>('[data-composer-field]');
		const sendButton = host.querySelector<HTMLElement>('[data-composer-send]');
		if (!panel || !log || !composerField || !sendButton) continue;

		let pairs: QaPair[] = [];
		try {
			pairs = JSON.parse(panel.dataset.qa ?? '[]');
		} catch {
			pairs = [];
		}
		if (!pairs.length) continue;

		let pairIndex = 0;
		let composerTyped = 0;
		let answerTyped = 0;
		// 0 not started, 1 typing the question into the composer, 2 a beat
		// before sending, 3 send-button press effect, 4 thinking, 5 typing
		// the answer, 6 holding the finished answer before the next turn.
		let phase: 0 | 1 | 2 | 3 | 4 | 5 | 6 = 0;
		let timer: number | undefined;
		let turnCount = 0;
		let active: ChatTurn | undefined;

		const current = () => pairs[pairIndex % pairs.length];

		const scrollToEnd = () => {
			log.scrollTop = log.scrollHeight;
		};

		const addTurn = (): ChatTurn => {
			const userRow = document.createElement('div');
			userRow.className = 'service-chat-row service-chat-row-user';
			const userBubble = document.createElement('span');
			userBubble.className = 'service-chat-bubble service-chat-bubble-user';
			userRow.append(userBubble);

			const assistantRow = document.createElement('div');
			assistantRow.className = 'service-chat-row service-chat-row-assistant';
			const typing = document.createElement('span');
			typing.className = 'service-chat-typing';
			typing.hidden = true;
			typing.append(document.createElement('span'), document.createElement('span'), document.createElement('span'));
			const assistantBubble = document.createElement('span');
			assistantBubble.className = 'service-chat-bubble service-chat-bubble-assistant';
			assistantRow.append(typing, assistantBubble);

			const actions = createChatActions();

			log.append(userRow, assistantRow, actions);
			turnCount += 1;
			// Keep the DOM bounded during a long hover, same as a real
			// session log scrolling older turns out of memory. Each turn
			// adds three elements (user row, assistant row, actions row).
			while (turnCount > maxTurns) {
				log.firstElementChild?.remove();
				log.firstElementChild?.remove();
				log.firstElementChild?.remove();
				turnCount -= 1;
			}
			return { userBubble, typing, assistantBubble, actions };
		};

		const stop = () => {
			if (timer !== undefined) {
				window.clearTimeout(timer);
				timer = undefined;
			}
		};

		const step = () => {
			const { question, answer } = current();

			// Type the question into the composer, like the user is
			// actually writing it, before it's ever posted to the thread.
			if (phase === 1) {
				if (composerTyped >= question.length) {
					phase = 2;
					timer = window.setTimeout(step, 320);
					return;
				}
				composerTyped += 1;
				composerField.textContent = question.slice(0, composerTyped);
				timer = window.setTimeout(step, 28 + Math.random() * 45);
				return;
			}

			// A short "about to send" beat, then a tap/press effect on the
			// send button — the click the user asked to see.
			if (phase === 2) {
				phase = 3;
				sendButton.classList.add('is-pressed');
				timer = window.setTimeout(step, 160);
				return;
			}

			// Posting: the full question appears in the thread at once
			// (it was already "typed" in the composer above) and the
			// composer clears back to its placeholder.
			if (phase === 3) {
				sendButton.classList.remove('is-pressed');
				composerField.textContent = '';
				composerTyped = 0;
				active = addTurn();
				active.userBubble.textContent = question;
				scrollToEnd();
				phase = 4;
				timer = window.setTimeout(step, 260);
				return;
			}

			if (phase === 4) {
				if (active) active.typing.hidden = false;
				scrollToEnd();
				phase = 5;
				timer = window.setTimeout(step, thinkPause);
				return;
			}

			if (phase === 5) {
				if (answerTyped >= answer.length) {
					if (active) active.actions.hidden = false;
					scrollToEnd();
					phase = 6;
					timer = window.setTimeout(step, turnPause);
					return;
				}
				if (answerTyped === 0 && active) active.typing.hidden = true;
				answerTyped += 1;
				if (active) active.assistantBubble.textContent = answer.slice(0, answerTyped);
				scrollToEnd();
				timer = window.setTimeout(step, 14 + Math.random() * 22);
				return;
			}

			if (phase === 6) {
				pairIndex += 1;
				answerTyped = 0;
				phase = 1;
				timer = window.setTimeout(step, 28 + Math.random() * 45);
			}
		};

		const start = () => {
			stop();
			if (prefersReducedMotion) {
				// Show one finished exchange; skip the auto-cycling (and
				// the composer/typing/press animation) so reduced-motion
				// users see stable, non-animated content.
				if (!active) {
					active = addTurn();
					active.userBubble.textContent = current().question;
				}
				answerTyped = current().answer.length;
				active.assistantBubble.textContent = current().answer;
				active.typing.hidden = true;
				active.actions.hidden = false;
				composerField.textContent = '';
				scrollToEnd();
				return;
			}
			if (phase === 0) phase = 1;
			timer = window.setTimeout(step, 24);
		};

		const pause = () => {
			stop();
		};

		host.addEventListener('mouseenter', start);
		host.addEventListener('mouseleave', pause);
		host.addEventListener('focus', start);
		host.addEventListener('blur', pause);
	}

	// SEO & AEO panel: types a query into the search box, "presses" search,
	// then an AI Overview card streams in, followed by the organic result —
	// looping through a few queries while hovered.
	const searchHosts = document.querySelectorAll<HTMLElement>('[data-service-panel="seo"]');
	const searchThinkPause = 500;
	const searchTurnPause = 1300;

	interface SearchQuery {
		query: string;
		overview: string;
		title: string;
		snippet: string;
	}

	for (const host of searchHosts) {
		const panel = host.querySelector<HTMLElement>('.service-code--search');
		const searchField = host.querySelector<HTMLElement>('[data-search-field]');
		const searchBox = host.querySelector<HTMLElement>('.service-search-box');
		const results = host.querySelector<HTMLElement>('[data-search-results]');
		if (!panel || !searchField || !searchBox || !results) continue;

		const domain = panel.dataset.domain ?? '';
		let queries: SearchQuery[] = [];
		try {
			queries = JSON.parse(panel.dataset.queries ?? '[]');
		} catch {
			queries = [];
		}
		if (!queries.length) continue;

		let queryIndex = 0;
		let queryTyped = 0;
		let overviewTyped = 0;
		// 0 not started, 1 typing the query, 2 a beat before pressing
		// search, 3 search press effect, 4 typing the AI overview, 5 the
		// organic result appears, 6 holding before the next query.
		let phase: 0 | 1 | 2 | 3 | 4 | 5 | 6 = 0;
		let timer: number | undefined;
		let overviewTextEl: HTMLElement | undefined;

		const current = () => queries[queryIndex % queries.length];

		const stop = () => {
			if (timer !== undefined) {
				window.clearTimeout(timer);
				timer = undefined;
			}
		};

		const buildOverview = () => {
			const group = document.createElement('div');
			group.className = 'service-search-group';
			const card = document.createElement('div');
			card.className = 'service-search-overview';
			const label = document.createElement('div');
			label.className = 'service-search-overview-label';
			label.textContent = '✦ AI Overview';
			const text = document.createElement('div');
			text.className = 'service-search-overview-text';
			card.append(label, text);
			group.append(card);
			results.append(group);
			overviewTextEl = text;
		};

		const appendOrganicResult = () => {
			const { title, snippet } = current();
			const organic = document.createElement('div');
			organic.className = 'service-search-organic';

			const domainRow = document.createElement('div');
			domainRow.className = 'service-search-domain-row';
			const favicon = document.createElement('span');
			favicon.className = 'service-search-favicon';
			favicon.textContent = 'A';
			const domainEl = document.createElement('span');
			domainEl.className = 'service-search-domain';
			domainEl.textContent = domain;
			domainRow.append(favicon, domainEl);

			const titleEl = document.createElement('div');
			titleEl.className = 'service-search-result-title';
			titleEl.textContent = title;

			const snippetEl = document.createElement('div');
			snippetEl.className = 'service-search-snippet';
			snippetEl.textContent = snippet;

			organic.append(domainRow, titleEl, snippetEl);
			results.append(organic);
		};

		const step = () => {
			const { query, overview } = current();

			// Type the search query, like the user is actually searching.
			if (phase === 1) {
				if (queryTyped >= query.length) {
					phase = 2;
					timer = window.setTimeout(step, 320);
					return;
				}
				queryTyped += 1;
				searchField.textContent = query.slice(0, queryTyped);
				timer = window.setTimeout(step, 30 + Math.random() * 45);
				return;
			}

			// The tap/press effect on the search box the user asked for.
			if (phase === 2) {
				phase = 3;
				searchBox.classList.add('is-pressed');
				timer = window.setTimeout(step, 150);
				return;
			}

			// Clear any previous results and show the AI Overview card
			// (label visible immediately, text streams in next).
			if (phase === 3) {
				searchBox.classList.remove('is-pressed');
				results.innerHTML = '';
				buildOverview();
				phase = 4;
				timer = window.setTimeout(step, searchThinkPause);
				return;
			}

			if (phase === 4) {
				if (overviewTyped >= overview.length) {
					phase = 5;
					timer = window.setTimeout(step, 260);
					return;
				}
				overviewTyped += 1;
				if (overviewTextEl) overviewTextEl.textContent = overview.slice(0, overviewTyped);
				timer = window.setTimeout(step, 12 + Math.random() * 20);
				return;
			}

			// The classic organic result renders in one go underneath,
			// same as a real results page — it isn't "typed" like the
			// AI-generated overview above it.
			if (phase === 5) {
				appendOrganicResult();
				phase = 6;
				timer = window.setTimeout(step, searchTurnPause);
				return;
			}

			if (phase === 6) {
				queryIndex += 1;
				queryTyped = 0;
				overviewTyped = 0;
				searchField.textContent = '';
				phase = 1;
				timer = window.setTimeout(step, 30 + Math.random() * 45);
			}
		};

		const start = () => {
			stop();
			if (prefersReducedMotion) {
				// Show one finished query + result; skip the auto-cycling
				// and the typing/press animation for reduced-motion users.
				const { query, overview } = current();
				searchField.textContent = query;
				results.innerHTML = '';
				buildOverview();
				if (overviewTextEl) overviewTextEl.textContent = overview;
				appendOrganicResult();
				return;
			}
			if (phase === 0) phase = 1;
			timer = window.setTimeout(step, 24);
		};

		const pause = () => {
			stop();
		};

		host.addEventListener('mouseenter', start);
		host.addEventListener('mouseleave', pause);
		host.addEventListener('focus', start);
		host.addEventListener('blur', pause);
	}

	// Digital Marketing panel: a campaign's KPI tiles count up on reveal,
	// then after a hold, cycles to the next campaign.
	const dashHosts = document.querySelectorAll<HTMLElement>('[data-service-panel="marketing"]');
	const dashHoldPause = 1500;

	interface DashStat {
		label: string;
		value: number;
		change: string;
		suffix?: string;
	}

	interface DashCampaign {
		name: string;
		stats: DashStat[];
	}

	for (const host of dashHosts) {
		const panel = host.querySelector<HTMLElement>('.service-code--dash');
		const body = host.querySelector<HTMLElement>('[data-dash-body]');
		if (!panel || !body) continue;

		let campaigns: DashCampaign[] = [];
		try {
			campaigns = JSON.parse(panel.dataset.campaigns ?? '[]');
		} catch {
			campaigns = [];
		}
		if (!campaigns.length) continue;

		let campaignIndex = 0;
		// 0 not started, 1 revealing (building + counting up), 2 holding.
		let phase: 0 | 1 | 2 = 0;
		let timer: number | undefined;
		let pendingTimeouts: number[] = [];
		let pendingFrames: number[] = [];

		const current = () => campaigns[campaignIndex % campaigns.length];

		const stop = () => {
			if (timer !== undefined) {
				window.clearTimeout(timer);
				timer = undefined;
			}
			for (const id of pendingTimeouts) window.clearTimeout(id);
			for (const id of pendingFrames) window.cancelAnimationFrame(id);
			pendingTimeouts = [];
			pendingFrames = [];
		};

		const formatValue = (value: number, suffix?: string) =>
			suffix ? `${value.toFixed(1)}${suffix}` : Math.round(value).toLocaleString('en-US');

		const animateValue = (el: HTMLElement, target: number, suffix: string | undefined, delay: number) => {
			const duration = 900;
			const startId = window.setTimeout(() => {
				const startTime = performance.now();
				const tick = (now: number) => {
					const t = Math.min(1, (now - startTime) / duration);
					const eased = 1 - (1 - t) ** 3;
					el.textContent = formatValue(target * eased, suffix);
					if (t < 1) pendingFrames.push(window.requestAnimationFrame(tick));
				};
				pendingFrames.push(window.requestAnimationFrame(tick));
			}, delay);
			pendingTimeouts.push(startId);
		};

		const buildCampaign = (animated: boolean) => {
			body.innerHTML = '';
			const { name, stats } = current();

			const group = document.createElement('div');
			group.className = 'service-dash-group';

			const nameEl = document.createElement('div');
			nameEl.className = 'service-dash-name';
			nameEl.textContent = name;

			const grid = document.createElement('div');
			grid.className = 'service-dash-grid';

			stats.forEach((stat, index) => {
				const tile = document.createElement('div');
				tile.className = 'service-dash-tile';

				const label = document.createElement('span');
				label.className = 'service-dash-label';
				label.textContent = stat.label;

				const value = document.createElement('span');
				value.className = 'service-dash-value';
				value.textContent = formatValue(animated ? 0 : stat.value, stat.suffix);

				const change = document.createElement('span');
				change.className = 'service-dash-change';
				change.textContent = `↑ ${stat.change}`;

				tile.append(label, value, change);
				grid.append(tile);

				if (animated) animateValue(value, stat.value, stat.suffix, index * 100);
			});

			group.append(nameEl, grid);
			body.append(group);
		};

		const step = () => {
			if (phase === 1) {
				buildCampaign(true);
				phase = 2;
				timer = window.setTimeout(step, 900 + current().stats.length * 100 + dashHoldPause);
				return;
			}

			if (phase === 2) {
				campaignIndex += 1;
				phase = 1;
				timer = window.setTimeout(step, 250);
			}
		};

		const start = () => {
			stop();
			if (prefersReducedMotion) {
				buildCampaign(false);
				return;
			}
			if (phase === 0) phase = 1;
			timer = window.setTimeout(step, 24);
		};

		const pause = () => {
			stop();
		};

		host.addEventListener('mouseenter', start);
		host.addEventListener('mouseleave', pause);
		host.addEventListener('focus', start);
		host.addEventListener('blur', pause);
	}

	// Graphic Design & Printing panel: a brand mark and palette swatches
	// assemble on the canvas while the toolbar highlights a different tool
	// every so often, then cycles to the next palette direction.
	const designHosts = document.querySelectorAll<HTMLElement>('[data-service-panel="design"]');
	const designHoldPause = 1600;

	interface BrandPalette {
		name: string;
		colors: string[];
	}

	for (const host of designHosts) {
		const panel = host.querySelector<HTMLElement>('.service-code--design');
		const mark = host.querySelector<HTMLElement>('[data-design-mark]');
		const swatchesEl = host.querySelector<HTMLElement>('[data-design-swatches]');
		const labelEl = host.querySelector<HTMLElement>('[data-design-label]');
		const tools = Array.from(host.querySelectorAll<HTMLElement>('[data-tool]'));
		if (!panel || !mark || !swatchesEl || !labelEl) continue;

		let palettes: BrandPalette[] = [];
		try {
			palettes = JSON.parse(panel.dataset.palettes ?? '[]');
		} catch {
			palettes = [];
		}
		if (!palettes.length) continue;

		const markShapes = Array.from(mark.querySelectorAll<HTMLElement>('.service-design-mark-shape'));

		let paletteIndex = 0;
		// 0 not started, 1 revealing the mark, 2 revealing swatches, 3
		// revealing the label, 4 holding.
		let phase: 0 | 1 | 2 | 3 | 4 = 0;
		let timer: number | undefined;
		let toolTimer: number | undefined;
		let toolIndex = 0;

		const current = () => palettes[paletteIndex % palettes.length];

		const stop = () => {
			if (timer !== undefined) {
				window.clearTimeout(timer);
				timer = undefined;
			}
		};

		const paintMark = () => {
			const { colors } = current();
			markShapes.forEach((shape, index) => {
				shape.style.backgroundColor = colors[index % colors.length];
			});
		};

		const buildSwatches = () => {
			swatchesEl.innerHTML = '';
			const { colors } = current();
			colors.forEach((color, index) => {
				const dot = document.createElement('span');
				dot.className = 'service-design-swatch';
				dot.style.backgroundColor = color;
				dot.style.animationDelay = `${index * 70}ms`;
				swatchesEl.append(dot);
			});
		};

		const cycleTool = () => {
			if (!tools.length) return;
			tools.forEach((tool) => tool.classList.remove('is-active'));
			tools[toolIndex % tools.length]?.classList.add('is-active');
			toolIndex += 1;
		};

		const step = () => {
			if (phase === 1) {
				mark.classList.remove('is-visible');
				swatchesEl.innerHTML = '';
				labelEl.textContent = '';
				paintMark();
				// Force a reflow so the removed class re-triggers the
				// transition instead of the add being coalesced with it.
				void mark.offsetWidth;
				mark.classList.add('is-visible');
				phase = 2;
				timer = window.setTimeout(step, 420);
				return;
			}

			if (phase === 2) {
				buildSwatches();
				phase = 3;
				timer = window.setTimeout(step, 420);
				return;
			}

			if (phase === 3) {
				labelEl.textContent = current().name;
				phase = 4;
				timer = window.setTimeout(step, designHoldPause);
				return;
			}

			if (phase === 4) {
				paletteIndex += 1;
				phase = 1;
				timer = window.setTimeout(step, 250);
			}
		};

		const start = () => {
			stop();
			if (!toolTimer && !prefersReducedMotion) {
				cycleTool();
				toolTimer = window.setInterval(cycleTool, 900);
			}
			if (prefersReducedMotion) {
				paintMark();
				mark.classList.add('is-visible');
				buildSwatches();
				labelEl.textContent = current().name;
				tools[0]?.classList.add('is-active');
				return;
			}
			if (phase === 0) phase = 1;
			timer = window.setTimeout(step, 24);
		};

		const pause = () => {
			stop();
			if (toolTimer !== undefined) {
				window.clearInterval(toolTimer);
				toolTimer = undefined;
			}
		};

		host.addEventListener('mouseenter', start);
		host.addEventListener('mouseleave', pause);
		host.addEventListener('focus', start);
		host.addEventListener('blur', pause);
	}

	// Corporate Merchandising panel: each product is hand-drawn once on
	// load (gradients, shading, soft shadows) — the same drawing
	// techniques as the homepage hero's 3D scene — rather than a flat
	// icon glyph. It's a static illustration, so there's nothing to
	// animate here beyond the CSS reveal/steam already in place.
	const LOGICAL_ICON_SIZE = 64;

	// The canvas also grows (via CSS) once the panel expands on hover, so
	// a one-time draw would get blurrily upscaled. A ResizeObserver
	// redraws it at the current size whenever that changes — the same
	// technique the homepage hero canvas uses for its own resize/render.
	const renderMerchCanvas = (canvas: HTMLCanvasElement, size: number, drawer: (ctx: CanvasRenderingContext2D) => void) => {
		if (size <= 0) return;
		const density = Math.min(window.devicePixelRatio || 1, 2);
		canvas.width = Math.round(size * density);
		canvas.height = Math.round(size * density);
		const ctx = canvas.getContext('2d');
		if (!ctx) return;
		ctx.setTransform(density, 0, 0, density, 0, 0);
		ctx.scale(size / LOGICAL_ICON_SIZE, size / LOGICAL_ICON_SIZE);
		drawer(ctx);
	};

	const drawMerchMug = (ctx: CanvasRenderingContext2D) => {
		ctx.save();
		ctx.shadowColor = 'rgba(45, 63, 174, 0.35)';
		ctx.shadowBlur = 10;
		ctx.shadowOffsetY = 6;
		const body = new Path2D();
		body.moveTo(18, 20);
		body.lineTo(46, 20);
		body.lineTo(43, 50);
		body.quadraticCurveTo(43, 54, 39, 54);
		body.lineTo(25, 54);
		body.quadraticCurveTo(21, 54, 21, 50);
		body.closePath();
		const gradient = ctx.createLinearGradient(18, 20, 46, 54);
		gradient.addColorStop(0, '#5f7bf0');
		gradient.addColorStop(1, '#283aa8');
		ctx.fillStyle = gradient;
		ctx.fill(body);
		ctx.restore();

		// Glossy highlight, like an inflated 3D toy material rather than a
		// flat fill.
		ctx.save();
		ctx.clip(body);
		const gloss = ctx.createRadialGradient(27, 27, 1, 27, 27, 14);
		gloss.addColorStop(0, 'rgba(255, 255, 255, 0.5)');
		gloss.addColorStop(1, 'rgba(255, 255, 255, 0)');
		ctx.fillStyle = gloss;
		ctx.fillRect(0, 0, 64, 64);
		ctx.restore();

		ctx.save();
		ctx.strokeStyle = '#283aa8';
		ctx.lineWidth = 3.4;
		ctx.beginPath();
		ctx.arc(47, 33, 7, -Math.PI / 2 - 0.3, Math.PI / 2 + 0.3);
		ctx.stroke();
		ctx.restore();

		ctx.save();
		ctx.strokeStyle = 'rgba(255, 255, 255, 0.55)';
		ctx.lineWidth = 1.4;
		ctx.beginPath();
		ctx.moveTo(20, 21);
		ctx.lineTo(44, 21);
		ctx.stroke();
		ctx.restore();

		ctx.save();
		ctx.fillStyle = 'rgba(255, 255, 255, 0.92)';
		ctx.beginPath();
		ctx.arc(32, 36, 3.6, 0, Math.PI * 2);
		ctx.fill();
		ctx.restore();
	};

	const drawMerchBottle = (ctx: CanvasRenderingContext2D) => {
		ctx.save();
		ctx.shadowColor = 'rgba(31, 111, 100, 0.3)';
		ctx.shadowBlur = 10;
		ctx.shadowOffsetY = 6;
		const body = new Path2D();
		body.moveTo(22, 24);
		body.lineTo(42, 24);
		body.lineTo(42, 54);
		body.quadraticCurveTo(42, 58, 38, 58);
		body.lineTo(26, 58);
		body.quadraticCurveTo(22, 58, 22, 54);
		body.closePath();
		const gradient = ctx.createLinearGradient(22, 24, 42, 58);
		gradient.addColorStop(0, '#6fe0cf');
		gradient.addColorStop(0.55, '#2f9e8f');
		gradient.addColorStop(1, '#1f6f64');
		ctx.fillStyle = gradient;
		ctx.fill(body);
		ctx.restore();

		ctx.save();
		ctx.clip(body);
		const gloss = ctx.createRadialGradient(29, 32, 1, 29, 32, 15);
		gloss.addColorStop(0, 'rgba(255, 255, 255, 0.45)');
		gloss.addColorStop(1, 'rgba(255, 255, 255, 0)');
		ctx.fillStyle = gloss;
		ctx.fillRect(0, 0, 64, 64);
		ctx.restore();

		ctx.save();
		const capGradient = ctx.createLinearGradient(26, 8, 38, 24);
		capGradient.addColorStop(0, '#7b8794');
		capGradient.addColorStop(1, '#374151');
		ctx.fillStyle = capGradient;
		ctx.beginPath();
		ctx.moveTo(28, 24);
		ctx.lineTo(28, 16);
		ctx.quadraticCurveTo(28, 14, 30, 14);
		ctx.lineTo(34, 14);
		ctx.quadraticCurveTo(36, 14, 36, 16);
		ctx.lineTo(36, 24);
		ctx.closePath();
		ctx.fill();
		ctx.restore();

		ctx.save();
		const shine = ctx.createLinearGradient(25, 26, 25, 48);
		shine.addColorStop(0, 'rgba(255, 255, 255, 0.55)');
		shine.addColorStop(1, 'rgba(255, 255, 255, 0)');
		ctx.fillStyle = shine;
		ctx.beginPath();
		ctx.ellipse(26, 37, 1.6, 11, 0, 0, Math.PI * 2);
		ctx.fill();
		ctx.restore();

		ctx.save();
		ctx.fillStyle = 'rgba(255, 255, 255, 0.88)';
		ctx.fillRect(22, 38, 20, 4.5);
		ctx.restore();
	};

	const drawMerchShirt = (ctx: CanvasRenderingContext2D) => {
		ctx.save();
		ctx.shadowColor = 'rgba(0, 0, 0, 0.18)';
		ctx.shadowBlur = 10;
		ctx.shadowOffsetY = 6;
		const body = new Path2D();
		body.moveTo(26, 10);
		body.quadraticCurveTo(20, 6, 15, 7);
		body.quadraticCurveTo(7, 10, 3, 17);
		body.quadraticCurveTo(1, 21, 4, 24);
		body.quadraticCurveTo(9, 22, 13, 19);
		body.lineTo(13, 54);
		body.quadraticCurveTo(13, 57, 16, 57);
		body.lineTo(48, 57);
		body.quadraticCurveTo(51, 57, 51, 54);
		body.lineTo(51, 19);
		body.quadraticCurveTo(55, 22, 60, 24);
		body.quadraticCurveTo(63, 21, 61, 17);
		body.quadraticCurveTo(57, 10, 49, 7);
		body.quadraticCurveTo(44, 6, 38, 10);
		body.quadraticCurveTo(32, 14, 26, 10);
		body.closePath();
		const gradient = ctx.createLinearGradient(10, 6, 54, 57);
		gradient.addColorStop(0, '#f6d394');
		gradient.addColorStop(1, '#d9a24e');
		ctx.fillStyle = gradient;
		ctx.fill(body);
		ctx.restore();

		ctx.save();
		ctx.clip(body);
		const fold = ctx.createLinearGradient(32, 10, 32, 57);
		fold.addColorStop(0, 'rgba(0, 0, 0, 0)');
		fold.addColorStop(1, 'rgba(0, 0, 0, 0.12)');
		ctx.fillStyle = fold;
		ctx.fillRect(0, 0, 64, 64);
		const gloss = ctx.createRadialGradient(22, 16, 1, 22, 16, 16);
		gloss.addColorStop(0, 'rgba(255, 255, 255, 0.45)');
		gloss.addColorStop(1, 'rgba(255, 255, 255, 0)');
		ctx.fillStyle = gloss;
		ctx.fillRect(0, 0, 64, 64);
		ctx.restore();

		ctx.save();
		ctx.strokeStyle = 'rgba(0, 0, 0, 0.18)';
		ctx.lineWidth = 1.6;
		ctx.beginPath();
		ctx.moveTo(26, 10);
		ctx.quadraticCurveTo(32, 15, 38, 10);
		ctx.stroke();
		ctx.restore();

		ctx.save();
		ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';
		ctx.beginPath();
		ctx.arc(32, 24, 3.2, 0, Math.PI * 2);
		ctx.fill();
		ctx.restore();
	};

	const merchDrawers: Record<string, (ctx: CanvasRenderingContext2D) => void> = {
		mug: drawMerchMug,
		bottle: drawMerchBottle,
		shirt: drawMerchShirt,
	};

	for (const canvas of document.querySelectorAll<HTMLCanvasElement>('[data-merch-icon]')) {
		const kind = canvas.dataset.merchIcon ?? '';
		const drawer = merchDrawers[kind];
		if (!drawer) continue;
		const observer = new ResizeObserver((entries) => {
			const width = entries[0]?.contentRect.width ?? canvas.getBoundingClientRect().width;
			renderMerchCanvas(canvas, width, drawer);
		});
		observer.observe(canvas);
	}
</script>

