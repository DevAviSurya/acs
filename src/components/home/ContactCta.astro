---
import { siteConfig } from '../../config/site';
---

<section class="bg-[#201e1b] py-20 sm:py-28" data-animate>
	<div class="mx-auto max-w-7xl px-6 lg:px-8">
		<div class="flex flex-col items-start justify-between gap-10 rounded-3xl border border-white/10 bg-white/[0.03] p-10 sm:flex-row sm:items-center sm:p-14">
			<div class="max-w-xl">
				<p class="text-sm font-semibold uppercase tracking-[0.2em] text-white/50">Get started</p>
				<h2 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
					Ready to bring your project to Attribute?
				</h2>
				<p class="mt-4 text-base leading-relaxed text-white/65">
					Tell us what you need — software, merchandise, design, print, or packaging — and we'll put together
					a quote.
				</p>
			</div>

			<div class="flex w-full flex-col gap-3 sm:w-auto">
				<a
					href="/contact"
					class="rounded-full bg-brand-bg px-6 py-3 text-center text-sm font-semibold text-brand-foreground transition-opacity hover:opacity-90"
				>
					Request a Quote
				</a>
				<a
					href={`mailto:${siteConfig.contact.email}`}
					class="rounded-full border border-white/25 px-6 py-3 text-center text-sm font-semibold text-white transition-colors hover:border-white/50 hover:bg-white/5"
				>
					Email Us
				</a>
				<a
					href={`tel:${siteConfig.contact.phone}`}
					class="text-center text-sm font-medium text-white/60 transition-colors hover:text-white"
				>
					{siteConfig.contact.phone}
				</a>
			</div>
		</div>
	</div>
</section>
