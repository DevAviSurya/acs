---
import { siteConfig } from '../config/site';
import { mainNav } from '../data/navigation';
---

<div data-header-sentinel aria-hidden="true" class="pointer-events-none absolute top-0 left-0 h-2 w-px"></div>
<header
	class="group sticky top-0 z-50 w-full border-b border-transparent bg-brand-bg/60 backdrop-blur-md transition-[background-color,border-color,box-shadow] duration-300 ease-out motion-reduce:transition-none data-[scrolled]:border-brand-border/60 data-[scrolled]:bg-brand-bg/80 data-[scrolled]:shadow-[0_1px_0_rgba(32,30,27,0.04)] data-[open]:border-brand-border/60 data-[open]:bg-brand-bg"
>
	<div class="relative mx-auto flex h-16 max-w-7xl items-center justify-between px-6 lg:px-8">
		<a href="/" class="flex flex-col leading-tight" aria-label={`${siteConfig.name} — home`}>
			<span class="text-lg font-semibold tracking-tight text-brand-foreground">{siteConfig.shortName}</span>
			<span class="text-[10px] uppercase tracking-[0.2em] text-brand-muted">Corporate Solutions</span>
		</a>

		<nav aria-label="Primary" class="hidden items-center gap-8 lg:flex">
			{mainNav.map((item) => (
				<a
					href={item.href}
					class="text-sm font-medium text-brand-muted transition-colors hover:text-brand-foreground"
				>
					{item.label}
				</a>
			))}
			<a
				href="/contact"
				class="inline-flex items-center gap-1.5 rounded-full bg-brand-accent px-5 py-2 text-sm font-semibold text-brand-accent-foreground transition-opacity hover:opacity-90"
			>
				Request a Quote
				<span aria-hidden="true">↗</span>
			</a>
		</nav>

		<button
			id="nav-toggle"
			type="button"
			class="inline-flex h-10 w-10 items-center justify-center rounded-md text-brand-foreground lg:hidden"
			aria-expanded="false"
			aria-controls="mobile-nav"
			aria-label="Toggle navigation menu"
		>
			<svg id="icon-open" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
			</svg>
			<svg id="icon-close" class="hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
			</svg>
		</button>
	</div>

	<nav
		id="mobile-nav"
		aria-label="Mobile"
		class="invisible pointer-events-none absolute inset-x-0 top-full -translate-y-2 border-t border-brand-border/60 bg-brand-bg opacity-0 transition-[opacity,transform,visibility] duration-200 ease-out motion-reduce:transition-none group-data-[open]:visible group-data-[open]:translate-y-0 group-data-[open]:pointer-events-auto group-data-[open]:opacity-100 lg:hidden"
	>
		<div class="flex flex-col gap-1 px-6 py-4">
			{mainNav.map((item) => (
				<a
					href={item.href}
					class="rounded-md px-3 py-2 text-sm font-medium text-brand-muted hover:bg-brand-surface hover:text-brand-foreground"
				>
					{item.label}
				</a>
			))}
			<a
				href="/contact"
				class="mt-2 inline-flex items-center justify-center gap-1.5 rounded-full bg-brand-accent px-5 py-2 text-center text-sm font-semibold text-brand-accent-foreground"
			>
				Request a Quote
				<span aria-hidden="true">↗</span>
			</a>
		</div>
	</nav>
</header>

<script>
	const header = document.querySelector('header');
	const sentinel = document.querySelector('[data-header-sentinel]');
	const toggle = document.getElementById('nav-toggle');
	const mobileNav = document.getElementById('mobile-nav');
	const iconOpen = document.getElementById('icon-open');
	const iconClose = document.getElementById('icon-close');

	if (sentinel && header) {
		new IntersectionObserver(([entry]) => {
			header.toggleAttribute('data-scrolled', !entry.isIntersecting);
		}).observe(sentinel);
	}

	const setOpen = (open: boolean) => {
		header?.toggleAttribute('data-open', open);
		toggle?.setAttribute('aria-expanded', String(open));
		iconOpen?.classList.toggle('hidden', open);
		iconClose?.classList.toggle('hidden', !open);
	};

	toggle?.addEventListener('click', () => {
		setOpen(toggle.getAttribute('aria-expanded') !== 'true');
	});

	mobileNav?.addEventListener('click', (event) => {
		if ((event.target as HTMLElement).closest('a')) setOpen(false);
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
			setOpen(false);
			toggle.focus();
		}
	});

	const desktop = window.matchMedia('(min-width: 1024px)');
	desktop.addEventListener('change', (event) => {
		if (event.matches) setOpen(false);
	});
</script>
