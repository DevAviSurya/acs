---
import { siteConfig } from '../config/site';
import { mainNav } from '../data/navigation';
---

<header class="sticky top-0 z-50 w-full border-b border-brand-border/60 bg-brand-bg/80 backdrop-blur-md">
	<div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6 lg:px-8">
		<a href="/" class="flex flex-col leading-tight" aria-label={`${siteConfig.name} — home`}>
			<span class="text-lg font-semibold tracking-tight text-brand-foreground">{siteConfig.shortName}</span>
			<span class="text-[10px] uppercase tracking-[0.2em] text-brand-muted">Corporate Solutions</span>
		</a>

		<nav aria-label="Primary" class="hidden items-center gap-8 lg:flex">
			{mainNav.map((item) => (
				<a
					href={item.href}
					class="text-sm font-medium text-brand-muted transition-colors hover:text-brand-foreground"
				>
					{item.label}
				</a>
			))}
			<a
				href="/contact"
				class="rounded-full bg-brand-accent px-5 py-2 text-sm font-semibold text-brand-accent-foreground transition-opacity hover:opacity-90"
			>
				Request a Quote
			</a>
		</nav>

		<button
			id="nav-toggle"
			type="button"
			class="inline-flex h-10 w-10 items-center justify-center rounded-md text-brand-foreground lg:hidden"
			aria-expanded="false"
			aria-controls="mobile-nav"
			aria-label="Toggle navigation menu"
		>
			<svg id="icon-open" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
			</svg>
			<svg id="icon-close" class="hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
			</svg>
		</button>
	</div>

	<nav id="mobile-nav" aria-label="Mobile" class="hidden border-t border-brand-border/60 bg-brand-bg lg:hidden">
		<div class="flex flex-col gap-1 px-6 py-4">
			{mainNav.map((item) => (
				<a
					href={item.href}
					class="rounded-md px-3 py-2 text-sm font-medium text-brand-muted hover:bg-brand-surface hover:text-brand-foreground"
				>
					{item.label}
				</a>
			))}
			<a
				href="/contact"
				class="mt-2 rounded-full bg-brand-accent px-5 py-2 text-center text-sm font-semibold text-brand-accent-foreground"
			>
				Request a Quote
			</a>
		</div>
	</nav>
</header>

<script>
	const toggle = document.getElementById('nav-toggle');
	const mobileNav = document.getElementById('mobile-nav');
	const iconOpen = document.getElementById('icon-open');
	const iconClose = document.getElementById('icon-close');

	toggle?.addEventListener('click', () => {
		const expanded = toggle.getAttribute('aria-expanded') === 'true';
		toggle.setAttribute('aria-expanded', String(!expanded));
		mobileNav?.classList.toggle('hidden', expanded);
		iconOpen?.classList.toggle('hidden', !expanded);
		iconClose?.classList.toggle('hidden', expanded);
	});
</script>
