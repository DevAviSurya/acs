---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<attribute-hero class:list={['attribute-hero', className]}>
  <canvas role="img" aria-label="A three-dimensional circuit-board A stands on a wavy grid. A moving signal starts at the live code editor and travels through AI tools, app interfaces, social media, and ends at the brand identity board.">
    Attribute
  </canvas>
  <canvas class="attribute-signal" aria-hidden="true"></canvas>
</attribute-hero>

<style>
  .attribute-hero {
    position: relative;
    display: block;
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    height: clamp(340px, 57vw, 700px);
    overflow: hidden;
    background: #fff;
  }

  @media (max-width: 759px) {
    .attribute-hero {
      height: clamp(340px, 70vw, 530px);
    }
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .attribute-signal {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
</style>

<script>
  type Point = [x: number, y: number, z: number];
  type LetterPoint = [x: number, y: number];
  const letterOutline: LetterPoint[] = [
    [-2.12, 0.018], [-0.54, 4.28], [0.54, 4.28], [2.12, 0.018],
    [1.16, 0.018], [0.83, 0.92], [-0.83, 0.92], [-1.16, 0.018],
  ];
  const letterCounter: LetterPoint[] = [[-0.55, 1.65], [0, 3.19], [0.55, 1.65]];
  const circuitTraces: LetterPoint[][] = [
    [[-1.90, 0.32], [-1.35, 0.32], [-1.07, 0.61], [-1.07, 1.02]],
    [[-1.58, 0.68], [-1.27, 0.68], [-0.96, 0.98], [-0.96, 1.41], [-0.69, 1.41]],
    [[-1.26, 1.18], [-1.10, 1.18], [-1.10, 1.74], [-0.84, 2.00], [-0.84, 2.40]],
    [[-0.74, 2.08], [-0.74, 2.59], [-0.40, 2.91], [-0.40, 3.40]],
    [[-0.45, 3.12], [-0.65, 3.32], [-0.65, 3.68], [-0.44, 3.90], [0.05, 3.90]],
    [[-0.16, 3.61], [0.22, 3.61], [0.42, 3.40], [0.42, 2.95]],
    [[0.62, 2.96], [0.62, 2.46], [0.91, 2.16], [0.91, 1.78]],
    [[1.08, 1.78], [1.08, 1.21], [1.39, 0.89], [1.39, 0.51]],
    [[1.77, 0.37], [1.56, 0.37], [1.23, 0.68], [1.23, 1.02]],
    [[-0.52, 1.22], [0.20, 1.22], [0.35, 1.37], [0.73, 1.37]],
  ];
  const circuitPads: [x: number, y: number, w: number, h: number, bright: boolean][] = [];
  for (let row = 0; row < 23; row++) {
    for (let column = 0; column < 23; column++) {
      const pattern = (row * 73 + column * 43 + row * column * 17) % 37;
      if (pattern > 20) continue;
      const x = -1.99 + column * 0.18;
      const y = 0.16 + row * 0.179;
      circuitPads.push([x, y, pattern % 3 ? 0.056 + (pattern % 4) * 0.021 : 0.026,
        pattern % 3 ? 0.032 : 0.107, pattern < 8]);
    }
  }

  function drawCircuitLetter(ctx: CanvasRenderingContext2D, project: (p: Point) => Point, scale: number) {
    const plane = (points: LetterPoint[], z: number, spread = 1) =>
      points.map(([x, y]) => project([x * spread, y * spread, z]));
    const append = (path: Path2D, points: Point[]) => {
      path.moveTo(points[0][0], points[0][1]);
      for (const [x, y] of points.slice(1)) path.lineTo(x, y);
      path.closePath();
    };
    const plate = (outline: Point[], counter: Point[]) => {
      const path = new Path2D();
      append(path, outline);
      append(path, counter);
      return path;
    };
    const back = plane(letterOutline, -0.35);
    const rearOpening = plane(letterCounter, -0.35);
    const front = plane(letterOutline, 0.35);
    const opening = plane(letterCounter, 0.35);
    const rearPlate = plate(back, rearOpening);
    const face = plate(front, opening);
    const solid = [rearPlate, face];

    ctx.lineJoin = 'miter';
    const rearRim = plate(plane(letterOutline, -0.46, 1.025), plane(letterCounter, -0.46, 1.025));
    ctx.fillStyle = 'rgba(61, 171, 224, .14)';
    ctx.fill(rearRim, 'evenodd');
    ctx.strokeStyle = '#39b8ef';
    ctx.lineWidth = 1.15 * scale;
    ctx.stroke(rearRim);
    ctx.fillStyle = '#142942';
    ctx.fill(rearPlate, 'evenodd');

    for (const [rear, forward] of [[back, front], [rearOpening, opening]]) {
      for (let i = 0; i < rear.length; i++) {
        const next = (i + 1) % rear.length;
        const wall = new Path2D();
        append(wall, [rear[i], rear[next], forward[next], forward[i]]);
        const gradient = ctx.createLinearGradient(rear[i][0], rear[i][1], forward[i][0], forward[i][1]);
        gradient.addColorStop(0, '#122845');
        gradient.addColorStop(0.47, '#1e4b72');
        gradient.addColorStop(1, '#071c33');
        ctx.fillStyle = gradient;
        ctx.fill(wall);
        ctx.strokeStyle = 'rgba(93, 201, 248, .32)';
        ctx.lineWidth = 0.7 * scale;
        ctx.stroke(wall);
        solid.push(wall);
      }
    }

    for (const [z, ink] of [[-0.20, '#34b9eb'], [0.05, '#1c87bf'], [0.24, '#52d2ff']] as const) {
      ctx.strokeStyle = ink;
      ctx.lineWidth = 0.9 * scale;
      ctx.stroke(plate(plane(letterOutline, z), plane(letterCounter, z)));
    }

    const gradient = ctx.createLinearGradient(front[1][0], front[1][1], front[3][0], front[3][1]);
    gradient.addColorStop(0, '#122d49');
    gradient.addColorStop(0.55, '#061324');
    gradient.addColorStop(1, '#112741');
    ctx.fillStyle = gradient;
    ctx.fill(face, 'evenodd');

    ctx.save();
    ctx.clip(face, 'evenodd');
    const origin = project([0, 0, 0.35]);
    const right = project([1, 0, 0.35]);
    const up = project([0, 1, 0.35]);
    ctx.transform(right[0] - origin[0], right[1] - origin[1],
      up[0] - origin[0], up[1] - origin[1], origin[0], origin[1]);
    for (const [x, y, w, h, bright] of circuitPads) {
      ctx.fillStyle = bright ? 'rgba(54, 212, 255, .76)' : 'rgba(21, 142, 207, .52)';
      ctx.fillRect(x, y, w, h);
    }
    ctx.lineWidth = 0.016;
    ctx.lineJoin = 'round';
    ctx.strokeStyle = 'rgba(100, 225, 255, .82)';
    ctx.fillStyle = '#8aeaff';
    for (const trace of circuitTraces) {
      ctx.beginPath();
      ctx.moveTo(...trace[0]);
      for (const point of trace.slice(1)) ctx.lineTo(...point);
      ctx.stroke();
      for (const point of [trace[0], trace[trace.length - 1]]) {
        ctx.beginPath();
        ctx.arc(...point, 0.031, 0, Math.PI * 2);
        ctx.fill();
      }
    }
    ctx.restore();

    ctx.strokeStyle = 'rgba(8, 53, 86, .9)';
    ctx.lineWidth = 3.6 * scale;
    ctx.stroke(face);
    ctx.strokeStyle = '#52d7ff';
    ctx.lineWidth = 1.35 * scale;
    ctx.stroke(face);
    const bezel = plate(plane(letterOutline, 0.43, 1.032), plane(letterCounter, 0.43, 1.032));
    ctx.strokeStyle = 'rgba(0, 155, 222, .55)';
    ctx.lineWidth = 0.9 * scale;
    ctx.stroke(bezel);

    const silhouette = [...back, ...front];
    const x = silhouette.map(point => point[0]);
    const y = silhouette.map(point => point[1]);
    return { solid, bounds: { left: Math.min(...x), right: Math.max(...x),
      top: Math.min(...y), bottom: Math.max(...y) } };
  }

  const workspaces = [
    { x: 0.12, z: 3.52, scale: 0.86, kind: 'ai' },
    { x: -2.75, z: 1.83, scale: 1.03, kind: 'build' },
    { x: 3.48, z: 0.69, scale: 0.94, kind: 'agent' },
    { x: 0.85, z: -3.54, scale: 0.86, kind: 'brand' },
    { x: -4.20, z: -0.55, scale: 0.76, kind: 'social' },
  ] as const;
  type Workspace = (typeof workspaces)[number];
  type Project = (point: Point) => Point;

  type SheetBounds = [x: number, z: number, width: number, depth: number];
  const panelBounds: Record<Workspace['kind'], SheetBounds> = {
    agent: [-1.36, -0.88, 2.72, 1.71],
    ai: [-1.23, -0.69, 2.43, 1.38],
    build: [-1.16, -0.67, 2.27, 1.47],
    social: [-1.23, -0.69, 2.43, 1.38],
    brand: [-1.16, -0.70, 2.33, 1.42],
  };
  const appDetailBounds: SheetBounds = [-0.12, -0.34, 1.39, 1.29];
  const [ai, output, agent, brand, social] = workspaces;

  function panelPort(workspace: Workspace, axis: 'x' | 'z', side: -1 | 1,
    [x, z, width, depth] = panelBounds[workspace.kind]): Point {
    const offset = 0.13 * side;
    return [
      workspace.x + (x + width * (axis === 'x' ? (side + 1) / 2 : 0.5)) * workspace.scale
        + (axis === 'x' ? offset : 0),
      0,
      workspace.z + (z + depth * (axis === 'z' ? (side + 1) / 2 : 0.5)) * workspace.scale
        + (axis === 'z' ? offset : 0),
    ];
  }

  const editorOut = panelPort(agent, 'x', -1);
  const aiIn = panelPort(ai, 'x', 1);
  const aiOut = panelPort(ai, 'x', -1);
  const appIn = panelPort(output, 'z', 1, appDetailBounds);
  const appOut = panelPort(output, 'x', -1);
  const socialIn = panelPort(social, 'z', 1);
  const socialOut = panelPort(social, 'x', 1);
  const brandIn = panelPort(brand, 'x', -1);
  const brandOut = panelPort(brand, 'x', 1);
  const elbowX = (editorOut[0] + aiIn[0]) / 2;

  // The last signal leg terminates at branding. The open connector is decorative.
  const connectorRoutes: Point[][] = [
    [editorOut, [elbowX, 0, editorOut[2]], [elbowX, 0, aiIn[2]], aiIn],
    [aiOut, [appIn[0], 0, aiOut[2]], appIn],
    [appOut, [socialIn[0], 0, appOut[2]], socialIn],
    [socialOut, [-2.65, 0, socialOut[2]], [-2.65, 0, brandIn[2]], brandIn],
  ];
  const brandingStub: Point[] = [brandOut, [brandOut[0] + 0.55, 0, brandOut[2]]];
  const visibleRoutes = [...connectorRoutes, brandingStub];
  const aiConnectorIndex = 0;
  const appConnectorIndex = 1;
  const rearConnectorIndex = 3;
  const signalLegs = connectorRoutes.flatMap((route, index) => {
    const length = (a: Point, b: Point) => Math.hypot(b[0] - a[0], b[2] - a[2]);
    const legs = route.slice(1).map((end, offset) => {
      const start = route[offset];
      return { start, end, length: length(start, end), visible: true,
        behindTruss: index === rearConnectorIndex,
        arrival: offset === route.length - 2 ? index : null };
    });
    const next = connectorRoutes[index + 1];
    if (next) {
      const start = route[route.length - 1];
      const end = next[0];
      legs.push({ start, end, length: length(start, end) * 0.18, visible: false, behindTruss: false, arrival: null });
    }
    return legs;
  });
  const signalLength = signalLegs.reduce((sum, leg) => sum + leg.length, 0);
  const connectorLead = 690;
  const travelDuration = signalLength * 1675;
  const signalEnd = connectorLead + travelDuration;
  const connectorFade = 850;
  const loopDuration = signalEnd + connectorFade + 300;
  const connectorArrival = (connector: number) => {
    const entry = signalLegs.findIndex(leg => leg.arrival === connector);
    return connectorLead + travelDuration * signalLegs.slice(0, entry + 1)
      .reduce((sum, leg) => sum + leg.length, 0) / signalLength;
  };
  const aiArrival = connectorArrival(aiConnectorIndex);
  const appArrival = connectorArrival(appConnectorIndex);
  const aiIsProcessing = (phase: number) => phase >= aiArrival && phase < appArrival;
  const typingDuration = 2050;
  const landingDuration = 720;
  const landingStagger = 110;
  const trussLandingDuration = 760;
  const trussBaseZ = -0.07;
  const impactDuration = 1100;
  const firstPanelStart = trussLandingDuration + 120;
  const introDuration = firstPanelStart + 4 * landingStagger + landingDuration + 55;
  const landingOrder: Workspace['kind'][] = ['agent', 'ai', 'build', 'social', 'brand'];
  const clamp01 = (value: number) => Math.min(1, Math.max(0, value));
  const ease = (value: number) => value * value * (3 - 2 * value);
  const landingEase = (value: number) => value ** 3 * (value * (6 * value - 15) + 10);

  type BrandMark = 'instagram' | 'linkedin' | 'youtube' | 'chatgpt' | 'claude' | 'gemini';

  function drawBrandMark(ctx: CanvasRenderingContext2D, mark: BrandMark, ink: string) {
    ctx.fillStyle = ink;
    ctx.strokeStyle = ink;
    ctx.lineWidth = 1.65;
    ctx.lineJoin = 'round';
    ctx.lineCap = 'round';
    const circle = (x: number, y: number, radius: number, fill: boolean) => {
      ctx.beginPath();
      ctx.arc(x, y, radius, 0, Math.PI * 2);
      if (fill) ctx.fill();
      else ctx.stroke();
    };

    switch (mark) {
      case 'instagram':
        ctx.beginPath();
        ctx.roundRect(-7.1, -7.1, 14.2, 14.2, 3.6);
        ctx.stroke();
        circle(0, 0, 3.3, false);
        circle(4.3, -4.1, 0.94, true);
        break;
      case 'linkedin':
        ctx.beginPath();
        ctx.roundRect(-7.5, -7.5, 15, 15, 1.65);
        ctx.fill();
        ctx.fillStyle = '#fff';
        circle(-4.15, -4.09, 1.03, true);
        ctx.fillRect(-5.1, -2.22, 1.92, 7.32);
        ctx.fillRect(-1.65, -2.22, 1.84, 7.32);
        ctx.beginPath();
        ctx.moveTo(0, -0.7);
        ctx.quadraticCurveTo(0.8, -2.65, 2.73, -2.55);
        ctx.quadraticCurveTo(5.3, -2.55, 5.3, 0.78);
        ctx.lineTo(5.3, 5.1);
        ctx.lineTo(3.37, 5.1);
        ctx.lineTo(3.37, 0.65);
        ctx.quadraticCurveTo(3.37, -0.8, 2.05, -0.8);
        ctx.quadraticCurveTo(0.25, -0.8, 0.25, 0.98);
        ctx.lineTo(0.25, 5.1);
        ctx.lineTo(0, 5.1);
        ctx.fill();
        break;
      case 'youtube':
        ctx.beginPath();
        ctx.roundRect(-8.7, -5.9, 17.4, 11.8, 3.1);
        ctx.fill();
        ctx.beginPath();
        ctx.moveTo(-1.7, -2.72);
        ctx.lineTo(3.16, 0);
        ctx.lineTo(-1.7, 2.72);
        ctx.closePath();
        ctx.fillStyle = '#fff';
        ctx.fill();
        break;
      case 'chatgpt':
        ctx.lineWidth = 1.28;
        for (let strand = 0; strand < 6; strand++) {
          ctx.save();
          ctx.rotate(strand * Math.PI / 3);
          ctx.beginPath();
          ctx.moveTo(-3.55, 1.72);
          ctx.lineTo(-3.55, -3.82);
          ctx.bezierCurveTo(-3.55, -7.68, 1.56, -8.5, 3.96, -5.42);
          ctx.bezierCurveTo(5.17, -3.82, 4.83, -2.07, 4.43, -1.18);
          ctx.lineTo(0.05, -3.55);
          ctx.stroke();
          ctx.restore();
        }
        break;
      case 'claude': {
        const lengths = [7.1, 7.8, 6.4, 7.6, 6.5, 7.5, 6.5, 7.2, 7.7, 6.6, 7.4, 6.8];
        ctx.beginPath();
        for (const [i, length] of lengths.entries()) {
          const angle = i * Math.PI / 6 + 0.13;
          ctx.moveTo(Math.cos(angle) * 1.0, Math.sin(angle) * 1.0);
          ctx.lineTo(Math.cos(angle) * length, Math.sin(angle) * length);
        }
        ctx.stroke();
        circle(0, 0, 1.6, true);
        break;
      }
      case 'gemini':
        ctx.beginPath();
        ctx.moveTo(0, -8.3);
        ctx.quadraticCurveTo(1.9, -1.9, 8.3, 0);
        ctx.quadraticCurveTo(1.9, 1.9, 0, 8.3);
        ctx.quadraticCurveTo(-1.9, 1.9, -8.3, 0);
        ctx.quadraticCurveTo(-1.9, -1.9, 0, -8.3);
        ctx.fill();
        break;
    }
  }

  function drawWorkspace(context: CanvasRenderingContext2D, project: Project, workspace: Workspace, progress = 0) {
    const local = (x: number, z: number) => project([x * workspace.scale + workspace.x, 0, z * workspace.scale + workspace.z]);
    const polygon = (points: [number, number][], fill: string, outline?: string) => {
      context.beginPath();
      for (const [index, [x, z]] of points.entries()) {
        const [sx, sy] = local(x, z);
        if (index === 0) context.moveTo(sx, sy);
        else context.lineTo(sx, sy);
      }
      context.closePath();
      context.fillStyle = fill;
      context.fill();
      if (outline) {
        context.strokeStyle = outline;
        context.lineWidth = 0.7;
        context.stroke();
      }
    };
    const rect = (x: number, z: number, w: number, d: number, fill: string, outline?: string) =>
      polygon([[x, z], [x + w, z], [x + w, z + d], [x, z + d]], fill, outline);

    const circle = (x: number, z: number, radius: number, fill: string, start = 0, end = 2 * Math.PI) => {
      const points: [number, number][] = end - start < 6 ? [[x, z]] : [];
      for (let i = 0; i <= 26; i++) {
        const angle = start + (end - start) * i / 26;
        points.push([x + Math.cos(angle) * radius, z + Math.sin(angle) * radius]);
      }
      polygon(points, fill);
    };

    const inPlane = (x: number, z: number, scale: number, draw: () => void) => {
      const [sx, sy] = local(x, z);
      const [rightX, rightY] = local(x + scale, z);
      const [downX, downY] = local(x, z + scale);
      context.save();
      context.transform(rightX - sx, rightY - sy, downX - sx, downY - sy, sx, sy);
      draw();
      context.restore();
    };

    const sheet = (x: number, z: number, w: number, d: number, fill = '#fff') => {
      rect(x + 0.043, z + 0.045, w, d, 'rgba(0, 0, 0, .13)');
      rect(x, z, w, d, fill, '#888');
    };

    const toolbar = (x: number, z: number, w: number) => {
      rect(x, z, w, 0.19, '#282828');
      for (const offset of [0.105, 0.210, 0.315]) circle(x + offset, z + 0.095, 0.026, '#f7f7f7');
      rect(x + w - 0.54, z + 0.075, 0.39, 0.041, '#f7f7f7');
    };

    if (workspace.kind === 'build') {
      sheet(-1.22, -0.95, 1.76, 1.21);
      toolbar(-1.22, -0.95, 1.76);
      sheet(...appDetailBounds);
      toolbar(-0.12, -0.34, 1.39);
      for (const z of [0.63, 0.74, 0.85]) rect(0.61, z, 0.52, 0.025, '#939393');

      const [x, z] = panelBounds.build;
      sheet(...panelBounds.build);
      toolbar(x, z, 2.27);
      rect(x + 0.11, z + 0.31, 0.48, 0.65, '#f8f8f8', '#aaa');
      for (const [index, length] of [0.32, 0.24, 0.33, 0.27, 0.19, 0.28].entries()) {
        rect(x + 0.185, z + 0.40 + index * 0.077, length, 0.024, '#363636');
      }
      rect(x + 0.69, z + 0.31, 0.57, 0.46, '#fff', '#aaa');
      inPlane(x + 0.975, z + 0.56, 0.015, () => {
        context.font = '700 17px monospace';
        context.textAlign = 'center';
        context.textBaseline = 'middle';
        context.fillStyle = '#252525';
        context.fillText('</>', 0, 0);
      });
      rect(x + 1.38, z + 0.31, 0.77, 0.46, '#f9f9f9', '#aaa');
      for (const offset of [1.57, 1.76, 1.95]) rect(x + offset, z + 0.31, 0.011, 0.46, '#aaa');
      for (const offset of [0.46, 0.61]) rect(x + 1.38, z + offset, 0.77, 0.012, '#aaa');
      circle(x + 0.94, z + 1.07, 0.21, '#a7a7a7');
      circle(x + 0.94, z + 1.07, 0.185, '#f5f5f5');
      circle(x + 0.94, z + 1.07, 0.183, '#343434', -Math.PI / 2, 0.85);
      for (const [index, length] of [0.64, 0.52, 0.38].entries()) {
        rect(x + 1.39, z + 0.92 + index * 0.117, length, 0.033, '#666');
      }
      return;
    }

    if (workspace.kind === 'social') {
      sheet(...panelBounds[workspace.kind]);
      toolbar(-1.23, -0.69, 2.43);
      const marks: BrandMark[] = ['instagram', 'linkedin', 'youtube'];
      for (const [index, mark] of marks.entries()) {
        const x = -1.075 + index * 0.75;
        rect(x, -0.36, 0.63, 0.72, '#f9f9f9', '#b5b5b5');
        inPlane(x + 0.315, -0.05, 0.023, () => drawBrandMark(context, mark, '#272727'));
        rect(x + 0.15, 0.23, 0.32, 0.025, '#909090');
      }
      return;
    }

    if (workspace.kind === 'ai') {
      sheet(...panelBounds[workspace.kind]);
      toolbar(-1.23, -0.69, 2.43);
      const models: BrandMark[] = ['chatgpt', 'claude', 'gemini'];
      const processing = progress > 0 && progress < 1;
      rect(-0.72, 0.147, 1.44, 0.016, '#8d8d8d');
      for (const [index, model] of models.entries()) {
        const x = -1.02 + index * 0.72;
        const active = index === 1;
        rect(x, -0.37, 0.59, 0.45, active ? '#252525' : '#f7f7f7', '#777');
        inPlane(x + 0.295, -0.147, 0.021, () =>
          drawBrandMark(context, model, active ? '#fff' : '#272727'));
        rect(x + 0.286, 0.08, 0.016, 0.067, '#8d8d8d');
        circle(x + 0.295, 0.155, 0.028, '#727272');
      }

      rect(-1.04, 0.218, 2.04, 0.40, '#f7f7f7', '#b0b0b0');
      rect(-0.86, 0.410, 1.67, 0.018, '#adadad');
      const gear = (x: number, radius: number, teeth: number, angle: number, color: string) => {
        const ring: [number, number][] = [];
        for (let tooth = 0; tooth < teeth; tooth++) {
          for (const [offset, scale] of [[0, 0.80], [0.18, 1], [0.67, 1], [0.83, 0.80]]) {
            const theta = angle + (tooth + offset) * Math.PI * 2 / teeth;
            ring.push([x + radius * scale * Math.cos(theta), 0.42 + radius * scale * Math.sin(theta)]);
          }
        }
        polygon(ring, color);
        circle(x, 0.42, radius * 0.43, '#f7f7f7');
        circle(x, 0.42, radius * 0.18, color);
      };
      const turn = 2.25 * Math.PI * progress ** 2 * (3 - 2 * progress);
      gear(-0.16, 0.182, 8, turn, '#252525');
      gear(0.111, 0.127, 6, 0.24 - turn * 8 / 6, '#6a6a6a');

      for (const x of [-0.80, -0.655, -0.51]) circle(x, 0.42, 0.026, '#777');
      for (const [index, x] of [0.49, 0.64, 0.79].entries()) {
        const ready = processing && progress > 0.66 + index * 0.08;
        rect(x - 0.042, 0.376, 0.084, 0.088, ready ? '#272727' : '#c4c4c4');
      }
      if (processing) {
        const transfer = progress < 0.42 ? progress / 0.42 : (progress - 0.42) / 0.58;
        const position = progress < 0.42 ? -0.91 + transfer * 0.54 : 0.27 + transfer * 0.59;
        circle(position, 0.42, 0.047, '#252525');
        circle(position, 0.42, 0.022, '#fff');
      }
      return;
    }

    if (workspace.kind === 'brand') {
      sheet(...panelBounds.brand);
      rect(-0.98, -0.51, 0.72, 0.67, '#262626');
      polygon([[-0.86, 0.02], [-0.63, -0.37], [-0.39, 0.02],
        [-0.49, 0.02], [-0.63, -0.23], [-0.77, 0.02]], '#f7f7f7');
      for (const [index, gray] of ['#222', '#767676', '#c5c5c5'].entries()) {
        rect(-0.04 + index * 0.36, -0.49, 0.29, 0.37, gray);
      }
      for (const [index, length] of [0.93, 0.68, 0.82].entries()) {
        rect(-0.04, 0.075 + index * 0.125, length, 0.031, '#888');
      }
      rect(-0.98, 0.37, 0.63, 0.024, '#929292');
      return;
    }

    // A VS Code-style editor shows the AI agent building the output.
    sheet(...panelBounds.agent, '#000');
    rect(-1.36, -0.88, 2.72, 0.22, '#131313');
    rect(-1.36, -0.66, 0.31, 1.49, '#141414');
    rect(-1.05, -0.66, 0.73, 0.17, '#252525');
    rect(-1.36, 0.67, 2.72, 0.16, '#161616');
    for (const offset of [0.105, 0.205, 0.305]) circle(1.36 - offset, -0.772, 0.023, '#a5a5a5');
    polygon([[-1.26, -0.48], [-1.23, -0.51], [-1.18, -0.46], [-1.11, -0.54], [-1.07, -0.52],
      [-1.07, -0.34], [-1.11, -0.32], [-1.18, -0.40], [-1.23, -0.35], [-1.26, -0.38],
      [-1.21, -0.43]], '#e0e0e0');
    polygon([[-1.11, -0.48], [-1.16, -0.43], [-1.11, -0.38]], '#141414');
    for (const z of [-0.18, 0.02, 0.22, 0.42]) rect(-1.24, z, 0.081, 0.047, '#9b9b9b');

    const code = [
      'import { agent } from "./ai";',
      '',
      'const draft = await agent.run();',
      'await app.publish(draft);',
    ];
    const typedCharacters = Math.floor(progress * (code[2].length + code[3].length));
    inPlane(-0.95, -0.54, 0.010, () => {
      context.font = '10px monospace';
      context.textBaseline = 'top';
      context.textAlign = 'left';
      context.fillStyle = '#e8e8e8';
      context.fillText('agent.ts', 0, -8);
      let remaining = typedCharacters;
      let cursorX = 0;
      let cursorY = 49;
      for (const [index, line] of code.entries()) {
        const y = 11 + index * 27;
        const visible = index < 2 ? line : line.slice(0, Math.max(0, remaining));
        context.fillStyle = '#939393';
        context.fillText(String(index + 1), 0, y);
        context.fillStyle = index === 0 ? '#b5b5b5' : '#f3f3f3';
        context.fillText(visible, 18, y);
        if (index >= 2 && remaining >= 0) {
          cursorX = 18 + context.measureText(visible).width;
          cursorY = y;
          remaining -= line.length;
        }
      }
      if (progress > 0 && progress < 1) {
        context.fillStyle = '#fff';
        context.fillRect(cursorX + 2, cursorY - 2, 1.35, 14);
      }
    });
  }

  class AttributeHero extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      const canvas = this.querySelector('canvas');
      const signalCanvas = this.querySelector<HTMLCanvasElement>('.attribute-signal');
      const context = canvas?.getContext('2d');
      const signalContext = signalCanvas?.getContext('2d');
      if (!canvas || !context || !signalCanvas || !signalContext) return;

      const events = new AbortController();
      const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const target = { x: 0, y: 0, ripple: 0, centerRipple: 0 };
      const view = { ...target };
      let width = 0;
      let height = 0;
      let frame = 0;
      let lastTime = 0;
      let introElapsed = motion.matches ? introDuration : 0;
      let loopElapsed = 0;
      let visible = true;
      let signalSize = 4;
      let ripplePhase = 0;
      let trussBounds = { left: 0, right: 0, top: 0, bottom: 0 };
      let projectedLegs: { start: Point; end: Point }[] = [];
      let letterMask: Path2D[] = [];

      const drawSignal = () => {
        signalContext.clearRect(0, 0, width, height);
        if (introElapsed < introDuration || motion.matches || !projectedLegs.length
          || loopElapsed < connectorLead || loopElapsed >= signalEnd + 260) return;
        const arrivalOpacity = 1 - ease(clamp01((loopElapsed - signalEnd) / 260));
        const travel = clamp01((loopElapsed - connectorLead) / travelDuration);
        let distance = signalLength * travel;
        for (const [index, leg] of signalLegs.entries()) {
          if (distance > leg.length && index < signalLegs.length - 1) {
            distance -= leg.length;
            continue;
          }
          if (!leg.visible) return;
          const { start, end } = projectedLegs[index];
          const progress = clamp01(distance / leg.length);
          const x = start[0] + (end[0] - start[0]) * progress;
          const y = start[1] + (end[1] - start[1]) * progress;
          signalContext.beginPath();
          signalContext.ellipse(x, y, signalSize, signalSize * 0.66, 0, 0, Math.PI * 2);
          signalContext.save();
          signalContext.globalAlpha = arrivalOpacity;
          signalContext.fillStyle = '#fff';
          signalContext.shadowColor = 'rgba(0, 0, 0, .24)';
          signalContext.shadowBlur = 3;
          signalContext.fill();
          signalContext.restore();
          if (leg.behindTruss) {
            signalContext.save();
            signalContext.globalCompositeOperation = 'destination-out';
            for (const path of letterMask) signalContext.fill(path, 'evenodd');
            signalContext.restore();
          }
          return;
        }
      };

      const render = () => {
        if (!width || !height) return;
        context.clearRect(0, 0, width, height);
        const stacked = width < 760;
        const unit = Math.min(height * 0.126, width * 0.087);
        const centerX = width * (stacked ? 0.48 : 0.5);
        const centerY = height * (stacked ? 0.52 : 0.51);
        const yaw = -Math.PI / 4 + view.x * 0.063;
        const pitch = 0.55 + view.y * 0.038;
        const sinYaw = Math.sin(yaw);
        const cosYaw = Math.cos(yaw);
        const sinPitch = Math.sin(pitch);
        const cosPitch = Math.cos(pitch);

        const project = ([x, y, z]: Point): Point => {
          const horizontal = x * cosYaw + z * sinYaw;
          const forward = z * cosYaw - x * sinYaw;
          const vertical = y * cosPitch - forward * sinPitch;
          const depth = y * sinPitch + forward * cosPitch;
          return [centerX + horizontal * unit, centerY - vertical * unit, depth];
        };

        const stroke = (a: Point, b: Point) => {
          context.moveTo(a[0], a[1]);
          context.lineTo(b[0], b[1]);
        };

        // Invert the floor projection so the ripple is circular on the 3D surface.
        const pointerAcross = ((view.x + 1) * width / 2 - centerX) / unit;
        const pointerDepth = ((view.y + 1) * height / 2 - centerY) / (unit * sinPitch);
        const pointerX = pointerAcross * cosYaw - pointerDepth * sinYaw;
        const pointerZ = pointerAcross * sinYaw + pointerDepth * cosYaw;
        const rippleRadius = 2.25;
        const rippleHeight = 0.16 * view.ripple * (1 - view.centerRipple);
        const centerRippleHeight = 0.21 * view.centerRipple;
        const impactProgress = clamp01((introElapsed - trussLandingDuration) / impactDuration);
        const impactHeight = 0.55 * ease(clamp01(impactProgress * 17)) * (1 - impactProgress) ** 1.25;
        const impactRadius = impactProgress * 6.4;
        const softBend = (distance: number, span: number) => {
          const progress = Math.min(1, Math.max(0, distance / span));
          return progress * progress * (3 - 2 * progress);
        };
        const gridPoint = (x: number, z: number): Point => {
          // The center stays level while the outer mesh rises and falls gently.
          const shoulder = softBend(Math.abs(x) - 4.60, 4.5);
          const back = softBend(-z - 3.65, 5.2);
          const front = softBend(z - 4.12, 4.4);
          const rearCorner = softBend(-x - 2.1, 3.6) * softBend(-z - 1.35, 2.75);
          const nearCorner = softBend(-x - 2.84, 3.7) * softBend(z - 1.63, 3.2);
          let y = 0.96 * back - 0.66 * shoulder - 0.46 * front
            + 0.86 * rearCorner - 0.78 * nearCorner;
          if (rippleHeight > 0.0003) {
            const distance = Math.hypot(x - pointerX, z - pointerZ) / rippleRadius;
            const envelope = 1 - softBend(distance, 1);
            y += rippleHeight * envelope * Math.cos(distance * Math.PI * 3.2);
          }
          if (centerRippleHeight > 0.0003 || impactHeight > 0.0003) {
            const distance = Math.hypot(x, z - trussBaseZ);
            if (centerRippleHeight > 0.0003) {
              const envelope = 1 - softBend(distance, 4.4);
              y += centerRippleHeight * envelope * Math.cos(distance * 6 - ripplePhase);
            }
            const offset = (distance - impactRadius) / 0.94;
            if (Math.abs(offset) < 1) {
              y += impactHeight * (1 - ease(Math.abs(offset))) * Math.cos(offset * Math.PI);
            }
          }
          return project([x, y, z]);
        };

        const traceGrid = (fixed: number, across: boolean) => {
          for (let i = 0; i <= 100; i++) {
            const coordinate = -10 + i * 0.20;
            const [x, y] = across ? gridPoint(coordinate, fixed) : gridPoint(fixed, coordinate);
            if (i === 0) context.moveTo(x, y);
            else context.lineTo(x, y);
          }
        };

        const floor = context.createRadialGradient(centerX, centerY, 0, centerX, centerY, width * 0.63);
        floor.addColorStop(0, 'rgba(72, 72, 72, .22)');
        floor.addColorStop(0.49, 'rgba(72, 72, 72, .13)');
        floor.addColorStop(0.78, 'rgba(72, 72, 72, .06)');
        floor.addColorStop(1, 'rgba(72, 72, 72, 0)');
        context.lineCap = 'butt';
        context.strokeStyle = floor;
        context.lineWidth = 0.56;
        context.beginPath();
        for (let coordinate = -10; coordinate <= 10; coordinate += 0.50) {
          traceGrid(coordinate, true);
          traceGrid(coordinate, false);
        }
        context.stroke();

        // Fade the floor at the canvas edges before drawing the scene on top.
        const edgeFade = context.createLinearGradient(0, 0, width, 0);
        edgeFade.addColorStop(0.006, 'rgba(0, 0, 0, 1)');
        edgeFade.addColorStop(0.055, 'rgba(0, 0, 0, .72)');
        edgeFade.addColorStop(0.16, 'rgba(0, 0, 0, 0)');
        edgeFade.addColorStop(0.84, 'rgba(0, 0, 0, 0)');
        edgeFade.addColorStop(0.945, 'rgba(0, 0, 0, .72)');
        edgeFade.addColorStop(0.994, 'rgba(0, 0, 0, 1)');
        context.save();
        context.globalCompositeOperation = 'destination-out';
        context.fillStyle = edgeFade;
        context.fillRect(0, 0, width, height);
        const verticalFade = context.createLinearGradient(0, 0, 0, height);
        verticalFade.addColorStop(0.08, 'rgba(0, 0, 0, 1)');
        verticalFade.addColorStop(0.43, 'rgba(0, 0, 0, 0)');
        verticalFade.addColorStop(0.80, 'rgba(0, 0, 0, 0)');
        verticalFade.addColorStop(0.94, 'rgba(0, 0, 0, .6)');
        verticalFade.addColorStop(1, 'rgba(0, 0, 0, 1)');
        context.fillStyle = verticalFade;
        context.fillRect(0, 0, width, height);
        context.restore();

        const terminalRadius = Math.max(1.45, Math.min(2.2, unit * 0.032));
        const gap = terminalRadius + 2.0;
        const trim = (start: Point, end: Point, amount: number): Point => {
          const distance = Math.hypot(end[0] - start[0], end[1] - start[1]);
          const ratio = Math.min(amount / distance, 0.32);
          return [start[0] + (end[0] - start[0]) * ratio,
            start[1] + (end[1] - start[1]) * ratio, start[2]];
        };
        context.lineCap = 'butt';
        context.lineJoin = 'miter';
        context.strokeStyle = '#737373';
        context.lineWidth = 0.82;
        for (const [index, route] of visibleRoutes.entries()) {
          const connectorStagger = 38;
          const drawDuration = connectorLead - connectorStagger * (visibleRoutes.length - 1);
          const progress = motion.matches ? 1 : ease(clamp01((loopElapsed - index * connectorStagger) / drawDuration));
          const opacity = motion.matches ? 1 : 1 - ease(clamp01((loopElapsed - signalEnd) / connectorFade));
          if (!progress || !opacity) continue;

          const path = route.map(project);
          const first = trim(path[0], path[1], gap);
          const endpoint = path[path.length - 1];
          const last = trim(endpoint, path[path.length - 2], gap);
          const trace = [first, ...path.slice(1, -1), last];
          context.save();
          context.globalAlpha = opacity * Math.min(1, progress * 1.35);
          if (progress < 1) {
            const length = trace.slice(1).reduce((sum, end, i) =>
              sum + Math.hypot(end[0] - trace[i][0], end[1] - trace[i][1]), 0);
            context.setLineDash([length, length]);
            context.lineDashOffset = length * (1 - progress);
          }
          context.beginPath();
          context.moveTo(first[0], first[1]);
          for (const [x, y] of trace.slice(1)) context.lineTo(x, y);
          context.stroke();
          context.restore();

          for (const [terminal, [x, y]] of [path[0], endpoint].entries()) {
            const alpha = terminal === 0 ? progress * 2.2 : (progress - 0.72) / 0.28;
            if (alpha <= 0) continue;
            context.save();
            context.globalAlpha = opacity * Math.min(1, alpha);
            context.beginPath();
            context.ellipse(x, y, terminalRadius, terminalRadius * 0.60, 0, 0, Math.PI * 2);
            context.fillStyle = '#fff';
            context.fill();
            context.strokeStyle = '#424242';
            context.stroke();
            context.restore();
          }
        }
        projectedLegs = signalLegs.map(({ start, end }) => ({ start: project(start), end: project(end) }));
        signalSize = Math.max(3.1, Math.min(5.1, unit * 0.070));

        const drawPanel = (workspace: Workspace, activity = 0) => {
          const start = firstPanelStart + landingOrder.indexOf(workspace.kind) * landingStagger;
          const progress = Math.min(1, Math.max(0, (introElapsed - start) / landingDuration));
          if (!progress) return;
          if (progress === 1) {
            drawWorkspace(context, project, workspace, activity);
            return;
          }

          const elevation = 1 - landingEase(progress);
          context.save();
          context.globalAlpha = ease(clamp01(progress * 1.85));
          context.translate(0, -Math.min(112, height * 0.25) * elevation);
          drawWorkspace(context, project, workspace, activity);
          context.restore();
        };

        drawPanel(brand);
        drawPanel(social);
        const processing = !motion.matches && aiIsProcessing(loopElapsed)
          ? (loopElapsed - aiArrival) / (appArrival - aiArrival)
          : 0;
        drawPanel(ai, processing);
        drawPanel(output);

        const descent = clamp01(introElapsed / trussLandingDuration);
        const distanceToLand = 1 - descent ** 1.45;
        const entryX = Math.min(160, width * 0.18) * distanceToLand;
        const entryY = Math.min(230, height * 0.35) * distanceToLand;
        const projectStructure = ([x, y, z]: Point): Point => {
          const [sx, sy, depth] = project([x * 0.67, (y - 0.018) * 0.78, z * 0.79 + trussBaseZ]);
          return [sx - entryX, sy - entryY, depth];
        };

        context.save();
        context.globalAlpha = ease(clamp01(descent * 3.4));
        const letter = drawCircuitLetter(context, projectStructure, Math.max(0.68, Math.min(1.25, unit / 75)));
        letterMask = letter.solid;
        trussBounds = letter.bounds;
        context.restore();

        const typing = motion.matches ? 1 : clamp01((loopElapsed - connectorLead) / typingDuration);
        drawPanel(agent, typing);
        drawSignal();
      };

      const animate = (time: number) => {
        frame = 0;
        const elapsed = lastTime ? Math.min(time - lastTime, 48) : 16;
        lastTime = time;
        if (introElapsed < introDuration) {
          introElapsed = Math.min(introDuration, introElapsed + elapsed);
          render();
          queue();
          return;
        }

        const previousPhase = loopElapsed;
        loopElapsed = (loopElapsed + elapsed) % loopDuration;
        const blend = 1 - Math.exp(-elapsed / 115);
        const moving = view.x !== target.x || view.y !== target.y || view.ripple !== target.ripple
          || view.centerRipple !== target.centerRipple || view.centerRipple > 0;
        view.x += (target.x - view.x) * blend;
        view.y += (target.y - view.y) * blend;
        view.ripple += (target.ripple - view.ripple) * blend;
        view.centerRipple += (target.centerRipple - view.centerRipple) * blend;
        const remaining = Math.abs(target.x - view.x) + Math.abs(target.y - view.y)
          + Math.abs(target.ripple - view.ripple) + Math.abs(target.centerRipple - view.centerRipple);
        if (remaining <= 0.001) Object.assign(view, target);
        ripplePhase = view.centerRipple > 0 ? (ripplePhase + elapsed * 0.007) % (Math.PI * 2) : 0;

        const sceneIsAnimating = (phase: number) => phase <= connectorLead + typingDuration
          || aiIsProcessing(phase) || (phase >= signalEnd && phase <= signalEnd + connectorFade);
        if (moving || sceneIsAnimating(previousPhase) || sceneIsAnimating(loopElapsed)) render();
        else drawSignal();
        queue();
      };

      const queue = () => {
        if (!frame && visible && !motion.matches) frame = requestAnimationFrame(animate);
      };

      const reset = () => {
        target.x = 0;
        target.y = 0;
        target.ripple = 0;
        target.centerRipple = 0;
        if (view.x || view.y || view.ripple || view.centerRipple) queue();
        else render();
      };

      const resize = () => {
        const bounds = this.getBoundingClientRect();
        width = bounds.width;
        height = bounds.height;
        const density = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.max(1, Math.round(width * density));
        canvas.height = Math.max(1, Math.round(height * density));
        signalCanvas.width = canvas.width;
        signalCanvas.height = canvas.height;
        context.setTransform(density, 0, 0, density, 0, 0);
        signalContext.setTransform(density, 0, 0, density, 0, 0);
        render();
      };

      const aim = (event: PointerEvent) => {
        const rect = this.getBoundingClientRect();
        if (motion.matches || !rect.width || !rect.height) return;
        const x = event.clientX - rect.left;
        const y = event.clientY - rect.top;
        target.x = 2 * x / rect.width - 1;
        target.y = 2 * y / rect.height - 1;
        target.ripple = 1;
        const { left, right, top, bottom } = trussBounds;
        const padding = 7;
        target.centerRipple = Number(x >= left - padding && x <= right + padding
          && y >= top - padding && y <= bottom + padding);
        queue();
      };

      const options = { signal: events.signal, passive: true };
      this.addEventListener('pointermove', (event) => {
        if (event.pointerType === 'mouse') aim(event);
      }, options);
      this.addEventListener('pointerleave', (event) => {
        if (event.pointerType === 'mouse') reset();
      }, options);
      this.addEventListener('pointercancel', reset, options);
      motion.addEventListener('change', () => {
        if (!motion.matches) {
          queue();
          return;
        }
        cancelAnimationFrame(frame);
        frame = 0;
        lastTime = 0;
        introElapsed = introDuration;
        Object.assign(target, { x: 0, y: 0, ripple: 0, centerRipple: 0 });
        ripplePhase = 0;
        Object.assign(view, target);
        render();
      }, options);

      const observer = new ResizeObserver(resize);
      observer.observe(this);
      const visibility = new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        if (visible) queue();
        else {
          cancelAnimationFrame(frame);
          frame = 0;
          lastTime = 0;
        }
      });
      visibility.observe(this);
      resize();
      queue();
      this.cleanup = () => {
        observer.disconnect();
        visibility.disconnect();
        events.abort();
        cancelAnimationFrame(frame);
      };
    }

    disconnectedCallback() {
      this.cleanup?.();
    }
  }

  if (!customElements.get('attribute-hero')) {
    customElements.define('attribute-hero', AttributeHero);
  }
</script>
